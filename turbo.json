{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "registry:build": {
      "dependsOn": ["^registry:build"],
      "env": ["NEXT_PUBLIC_SITE_URL", "CI"],
      "outputs": ["public/r/**", "theme/**", "registry/theme/**"]
    },
    "build": {
      "dependsOn": ["registry:build"],
      "env": ["NEXT_PUBLIC_SITE_URL", "NEXT_PUBLIC_BASE_PATH"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "out/**"]
    },
    "dev": {
      "dependsOn": ["registry:build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {}
  }
}
