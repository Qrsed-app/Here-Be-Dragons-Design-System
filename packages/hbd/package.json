    "input-otp": "^1.5.0",
    "lucide-react": "^1.46.0",
    "next-themes": "^0.4.4",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^10.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "serve": "^14.0.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.0.0",
