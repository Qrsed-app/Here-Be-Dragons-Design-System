{
  "name": "@hbd/registry",
  "version": "0.1.0",
  "description": "Here Be Dragons — a shadcn custom registry of React + Tailwind v4 components (D&D / fantasy design system).",
  "private": true,
  "type": "module",
  "scripts": {
    "build:theme": "node scripts/build-theme.mjs",
