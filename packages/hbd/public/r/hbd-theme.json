      "content": "/* Here Be Dragons DS — registry-app/app/globals.css  (GENERATED by scripts/build-globals.mjs — do not edit by hand)\n * Tailwind v4 + shadcn theme. 1:1 reproduction of the HBD token system.\n * Composition: imports -> @custom-variant dark -> @font-face -> the full token\n * system (verbatim from tokens/tokens.css) -> theme overrides (themes/*.css) ->\n * shadcn semantic aliases -> @theme inline utilities -> @layer base -> every\n * de-shadowed component stylesheet (folded in so one import loads all styles).\n */\n\n/* Google Fonts MUST be the first @import: Tailwind v4 expands `@import \"tailwindcss\"`\n * in place, so any @import after it violates the CSS \"@import first\" rule\n * (a fatal parse error under Turbopack / Lightning CSS). */\n@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=IM+Fell+English:ital@0;1&family=JetBrains+Mono:wght@400;500&family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap');\n@import \"tailwindcss\";\n@import \"tw-animate-css\";\n\n@custom-variant dark (&:where(.dark, [data-theme=\"dark\"], [data-theme=\"dark\"] *));\n\n@font-face {\n  font-family: 'Tiamat Condensed SC';\n  src: url('/fonts/assets_TiamatCondensedSC-Regular.woff2') format('woff2'),\n       url('/fonts/assets_TiamatCondensedSC-Regular.woff') format('woff'),\n       url('/fonts/assets_TiamatCondensedSC-Regular.ttf') format('truetype');\n  font-weight: 400 700;\n  font-style: normal;\n  font-display: swap;\n}\n\n/* Here Be Dragons DS — tokens/tokens.css\n * Generated by scripts/build-tokens.js — do not edit by hand.\n * Source of truth: tokens/tokens.json\n */\n\n:root {\n  /* ── color ─────────────────────────────────────────────── */\n  --hbd-color-ink-950: #0d0a07;\n  --hbd-color-ink-900: #1a1410;\n  --hbd-color-ink-800: #2e2418;\n  --hbd-color-ink-700: #3d3020;\n  --hbd-color-ink-600: #5a4530;\n  --hbd-color-ink-500: #7a5f42;\n  --hbd-color-ink-400: #a07c57;\n  --hbd-color-ink-300: #c4a07a;\n  --hbd-color-ink-200: #dcc4a0;\n  --hbd-color-ink-100: #ede3d0;\n  --hbd-color-ink-50: #f5f0e8;\n  --hbd-color-ink-brown: #3d2817;\n  --hbd-color-ink-faded: #6b4f35;\n  --hbd-color-parchment-950: #2a2419;\n  --hbd-color-parchment-900: #3d3520;\n  --hbd-color-parchment-800: #5c5035;\n  --hbd-color-parchment-700: #7a6b48;\n  --hbd-color-parchment-600: #9e8c62;\n  --hbd-color-parchment-500: #bba87c;\n  --hbd-color-parchment-400: #a88d5a;\n  --hbd-color-parchment-300: #d4bc88;\n  --hbd-color-parchment-200: #ead9b3;\n  --hbd-color-parchment-100: #f5ecd7;\n  --hbd-color-parchment-50: #fdf8f0;\n  --hbd-color-crimson-950: #3d0505;\n  --hbd-color-crimson-900: #5a0a0a;\n  --hbd-color-crimson-800: #7a1010;\n  --hbd-color-crimson-700: #9e1818;\n  --hbd-color-crimson-600: #c0392b;\n  --hbd-color-crimson-500: #d94e3e;\n  --hbd-color-crimson-400: #e8736a;\n  --hbd-color-crimson-300: #f0a09a;\n  --hbd-color-crimson-200: #f7ccc9;\n  --hbd-color-crimson-100: #fbe8e7;\n  --hbd-color-crimson-50: #fdf4f4;\n  --hbd-color-gold-900: #4a3800;\n  --hbd-color-gold-800: #6b5100;\n  --hbd-color-gold-700: #8c6d00;\n  --hbd-color-gold-600: #b08800;\n  --hbd-color-gold-500: #d4a500;\n  --hbd-color-gold-400: #e8c040;\n  --hbd-color-gold-300: #f0d47a;\n  --hbd-color-gold-200: #f7e8b0;\n  --hbd-color-gold-100: #faf3d8;\n  --hbd-color-gold-50: #fdf9ed;\n  --hbd-color-gold: #b8893b;\n  --hbd-color-gold-bright: #d4a548;\n  --hbd-color-gold-deep: #7a5a22;\n  --hbd-color-forest-900: #0d2e10;\n  --hbd-color-forest-800: #164a1a;\n  --hbd-color-forest-700: #1e6624;\n  --hbd-color-forest-600: #27832e;\n  --hbd-color-forest-500: #33a03a;\n  --hbd-color-forest-400: #5cbb63;\n  --hbd-color-forest-300: #90d095;\n  --hbd-color-forest-200: #bce5be;\n  --hbd-color-forest-100: #ddf2de;\n  --hbd-color-forest-50: #f0faf0;\n  --hbd-color-sapphire-900: #0a1a3d;\n  --hbd-color-sapphire-800: #122860;\n  --hbd-color-sapphire-700: #1a3d8a;\n  --hbd-color-sapphire-600: #2254b8;\n  --hbd-color-sapphire-500: #3068d4;\n  --hbd-color-sapphire-400: #6090e0;\n  --hbd-color-sapphire-300: #96baec;\n  --hbd-color-sapphire-200: #c2d8f5;\n  --hbd-color-sapphire-100: #e0ecfb;\n  --hbd-color-sapphire-50: #f0f6fd;\n  --hbd-color-sapphire: #1e3a5f;\n  --hbd-color-blood: #7a1212;\n  --hbd-color-blood-deep: #4a0808;\n  --hbd-color-emerald: #2d5a3d;\n  --hbd-color-emerald-bright: #5aab74;\n  --hbd-color-azure: #4a7ab8;\n  --hbd-color-amethyst: #6b3fa0;\n  --hbd-color-rose: #a8336b;\n  --hbd-color-umber: #9a5414;\n  --hbd-color-nightshade: #1e3320;\n  --hbd-color-shadow-bg: #2a1f17;\n  --hbd-color-white: #ffffff;\n  --hbd-color-black: #000000;\n  --hbd-color-transparent: transparent;\n  --hbd-color-surface-default: var(--hbd-color-parchment-100);\n  --hbd-color-surface-subtle: var(--hbd-color-parchment-200);\n  --hbd-color-surface-muted: var(--hbd-color-parchment-200);\n  --hbd-color-surface-raised: var(--hbd-color-parchment-300);\n  --hbd-color-surface-overlay: var(--hbd-color-ink-900);\n  --hbd-color-surface-inverse: var(--hbd-color-ink-900);\n  --hbd-color-surface-code: var(--hbd-color-ink-900);\n  --hbd-color-surface-action: var(--hbd-color-blood);\n  --hbd-color-surface-action-hover: var(--hbd-color-blood-deep);\n  --hbd-color-surface-action-active: var(--hbd-color-crimson-950);\n  --hbd-color-surface-action-ghost: var(--hbd-color-transparent);\n  --hbd-color-text-primary: var(--hbd-color-ink-900);\n  --hbd-color-text-secondary: var(--hbd-color-ink-700);\n  --hbd-color-text-muted: var(--hbd-color-ink-600);\n  --hbd-color-text-placeholder: var(--hbd-color-ink-400);\n  --hbd-color-text-disabled: var(--hbd-color-ink-400);\n  --hbd-color-text-inverse: var(--hbd-color-parchment-50);\n  --hbd-color-text-on-action: var(--hbd-color-parchment-50);\n  --hbd-color-text-link: var(--hbd-color-sapphire-700);\n  --hbd-color-text-link-hover: var(--hbd-color-sapphire-900);\n  --hbd-color-text-heading: var(--hbd-color-ink-900);\n  --hbd-color-text-emphasis: var(--hbd-color-blood);\n  --hbd-color-text-emphasis-strong: var(--hbd-color-blood-deep);\n  --hbd-color-border-default: var(--hbd-color-ink-300);\n  --hbd-color-border-subtle: var(--hbd-color-ink-200);\n  --hbd-color-border-strong: var(--hbd-color-ink-700);\n  --hbd-color-border-action: var(--hbd-color-crimson-700);\n  --hbd-color-border-error: var(--hbd-color-crimson-600);\n  --hbd-color-input-focus-border: var(--hbd-color-gold);\n  --hbd-color-status-success-surface: var(--hbd-color-emerald);\n  --hbd-color-status-success-border: var(--hbd-color-forest-600);\n  --hbd-color-status-success-text: var(--hbd-color-parchment-50);\n  --hbd-color-status-success-icon: var(--hbd-color-forest-600);\n  --hbd-color-status-warning-surface: var(--hbd-color-gold);\n  --hbd-color-status-warning-border: var(--hbd-color-gold-600);\n  --hbd-color-status-warning-text: var(--hbd-color-ink-900);\n  --hbd-color-status-warning-icon: var(--hbd-color-gold-700);\n  --hbd-color-status-error-surface: var(--hbd-color-blood);\n  --hbd-color-status-error-border: var(--hbd-color-crimson-600);\n  --hbd-color-status-error-text: var(--hbd-color-parchment-50);\n  --hbd-color-status-error-icon: var(--hbd-color-crimson-600);\n  --hbd-color-status-info-surface: var(--hbd-color-sapphire);\n  --hbd-color-status-info-border: var(--hbd-color-sapphire-600);\n  --hbd-color-status-info-text: var(--hbd-color-parchment-50);\n  --hbd-color-status-info-icon: var(--hbd-color-sapphire-700);\n  --hbd-color-focus-ring-outline: var(--hbd-color-gold-deep);\n  --hbd-color-border-ink-brown: var(--hbd-color-ink-brown);\n  --hbd-color-school-abjuration: var(--hbd-color-gold-deep);\n  --hbd-color-school-abjuration-accent: var(--hbd-color-gold-bright);\n  --hbd-color-school-abjuration-text: var(--hbd-color-parchment-50);\n  --hbd-color-school-conjuration: var(--hbd-color-emerald);\n  --hbd-color-school-conjuration-accent: var(--hbd-color-emerald-bright);\n  --hbd-color-school-conjuration-text: var(--hbd-color-parchment-50);\n  --hbd-color-school-divination: var(--hbd-color-sapphire);\n  --hbd-color-school-divination-accent: var(--hbd-color-azure);\n  --hbd-color-school-divination-text: var(--hbd-color-parchment-50);\n  --hbd-color-school-enchantment: var(--hbd-color-rose);\n  --hbd-color-school-enchantment-accent: var(--hbd-color-crimson-400);\n  --hbd-color-school-enchantment-text: var(--hbd-color-parchment-50);\n  --hbd-color-school-evocation: var(--hbd-color-blood);\n  --hbd-color-school-evocation-accent: var(--hbd-color-gold-bright);\n  --hbd-color-school-evocation-text: var(--hbd-color-parchment-50);\n  --hbd-color-school-illusion: var(--hbd-color-amethyst);\n  --hbd-color-school-illusion-accent: var(--hbd-color-sapphire-400);\n  --hbd-color-school-illusion-text: var(--hbd-color-parchment-50);\n  --hbd-color-school-necromancy: var(--hbd-color-nightshade);\n  --hbd-color-school-necromancy-accent: var(--hbd-color-forest-500);\n  --hbd-color-school-necromancy-text: var(--hbd-color-parchment-50);\n  --hbd-color-school-transmutation: var(--hbd-color-umber);\n  --hbd-color-school-transmutation-accent: var(--hbd-color-gold-400);\n  --hbd-color-school-transmutation-text: var(--hbd-color-parchment-50);\n\n  /* ── spacing ───────────────────────────────────────────── */\n  --hbd-space-1: 4px;\n  --hbd-space-2: 8px;\n  --hbd-space-3: 12px;\n  --hbd-space-4: 16px;\n  --hbd-space-6: 24px;\n  --hbd-space-8: 32px;\n  --hbd-space-12: 48px;\n  --hbd-space-16: 64px;\n  --hbd-space-24: 96px;\n  --hbd-space-32: 128px;\n\n  /* ── font-family ───────────────────────────────────────── */\n  --hbd-font-family-display: 'Tiamat Condensed SC', 'Cinzel', serif;\n  --hbd-font-family-serif: 'IM Fell English', 'Georgia', serif;\n  --hbd-font-family-accent: 'Cinzel', 'Palatino Linotype', 'Book Antiqua', serif;\n  --hbd-font-family-ui: 'Roboto', 'Helvetica Neue', 'Arial', sans-serif;\n  --hbd-font-family-mono: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'Consolas', monospace;\n\n  /* ── font-size ─────────────────────────────────────────── */\n  --hbd-font-size-3xs: 0.5rem;\n  --hbd-font-size-2xs: 0.5625rem;\n  --hbd-font-size-xs: 0.75rem;\n  --hbd-font-size-sm: 0.875rem;\n  --hbd-font-size-md: 1rem;\n  --hbd-font-size-lg: 1.125rem;\n  --hbd-font-size-xl: 1.25rem;\n  --hbd-font-size-2xl: 1.5rem;\n  --hbd-font-size-3xl: 1.875rem;\n  --hbd-font-size-4xl: 2.25rem;\n  --hbd-font-size-5xl: 3rem;\n  --hbd-font-size-6xl: 3.75rem;\n  --hbd-font-size-7xl: 4.5rem;\n  --hbd-font-size-hero: clamp(3rem, 7vw, 6rem);\n  --hbd-font-size-h1: clamp(2rem, 4.5vw, 2.5rem);\n  --hbd-font-size-h2: clamp(1.375rem, 3vw, 1.75rem);\n  --hbd-font-size-h3: clamp(1.0625rem, 2.2vw, 1.25rem);\n  --hbd-font-size-h4: 1.125rem;\n  --hbd-font-size-body: 1.0625rem;\n  --hbd-font-size-flavor: 0.9375rem;\n  --hbd-font-size-label: 0.8125rem;\n  --hbd-font-size-micro: 0.6875rem;\n\n  /* ── font-weight ───────────────────────────────────────── */\n  --hbd-font-weight-light: 300;\n  --hbd-font-weight-regular: 400;\n  --hbd-font-weight-medium: 500;\n  --hbd-font-weight-semibold: 600;\n  --hbd-font-weight-bold: 700;\n  --hbd-font-weight-black: 900;\n\n  /* ── line-height ───────────────────────────────────────── */\n  --hbd-line-height-none: 1;\n  --hbd-line-height-tight: 1.2;\n  --hbd-line-height-snug: 1.35;\n  --hbd-line-height-normal: 1.5;\n  --hbd-line-height-relaxed: 1.65;\n  --hbd-line-height-loose: 2;\n  --hbd-line-height-display: 1.1;\n  --hbd-line-height-body: 1.7;\n  --hbd-line-height-flavor: 1.6;\n\n  /* ── letter-spacing ────────────────────────────────────── */\n  --hbd-letter-spacing-tighter: -0.05em;\n  --hbd-letter-spacing-tight: -0.025em;\n  --hbd-letter-spacing-normal: 0em;\n  --hbd-letter-spacing-wide: 0.025em;\n  --hbd-letter-spacing-wider: 0.05em;\n  --hbd-letter-spacing-widest: 0.15em;\n  --hbd-letter-spacing-display: 0.02em;\n  --hbd-letter-spacing-label: 0.3em;\n  --hbd-letter-spacing-button: 0.2em;\n  --hbd-letter-spacing-eyebrow: 0.25em;\n  --hbd-letter-spacing-badge: 0.1em;\n\n  /* ── radius ────────────────────────────────────────────── */\n  --hbd-radius-none: 0;\n  --hbd-radius-sm: 1px;\n  --hbd-radius-md: 2px;\n  --hbd-radius-lg: 3px;\n  --hbd-radius-xl: 4px;\n  --hbd-radius-full: 9999px;\n\n  /* ── shadow ────────────────────────────────────────────── */\n  --hbd-shadow-none: none;\n  --hbd-shadow-sm: 0 1px 2px rgba(26, 20, 16, 0.12);\n  --hbd-shadow-md: 0 2px 6px rgba(26, 20, 16, 0.16), 0 1px 2px rgba(26, 20, 16, 0.10);\n  --hbd-shadow-lg: 0 4px 12px rgba(26, 20, 16, 0.18), 0 2px 4px rgba(26, 20, 16, 0.12);\n  --hbd-shadow-xl: 0 8px 24px rgba(26, 20, 16, 0.22), 0 4px 8px rgba(26, 20, 16, 0.14);\n  --hbd-shadow-inner: inset 0 1px 3px rgba(26, 20, 16, 0.20);\n\n  /* ── z ─────────────────────────────────────────────────── */\n  --hbd-z-below: -1;\n  --hbd-z-base: 0;\n  --hbd-z-raised: 10;\n  --hbd-z-dropdown: 100;\n  --hbd-z-sticky: 200;\n  --hbd-z-overlay: 300;\n  --hbd-z-modal: 400;\n  --hbd-z-popover: 500;\n  --hbd-z-toast: 600;\n  --hbd-z-tooltip: 700;\n\n  /* ── duration ──────────────────────────────────────────── */\n  --hbd-duration-instant: 0ms;\n  --hbd-duration-fast: 120ms;\n  --hbd-duration-normal: 200ms;\n  --hbd-duration-slow: 350ms;\n  --hbd-duration-slower: 500ms;\n  --hbd-duration-spin: 750ms;\n  --hbd-duration-pulse: 1500ms;\n  --hbd-duration-linger: 5000ms;\n  --hbd-duration-linger-lg: 8000ms;\n\n  /* ── ease ──────────────────────────────────────────────── */\n  --hbd-ease-linear: linear;\n  --hbd-ease-in: cubic-bezier(0.4, 0, 1, 1);\n  --hbd-ease-out: cubic-bezier(0, 0, 0.2, 1);\n  --hbd-ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);\n  --hbd-ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);\n  --hbd-ease-anticipate: cubic-bezier(0.4, -0.3, 0.2, 1.3);\n\n  /* ── border ────────────────────────────────────────────── */\n  --hbd-border-width-hairline: 1px;\n  --hbd-border-width-thin: 2px;\n  --hbd-border-width-medium: 3px;\n  --hbd-border-width-thick: 4px;\n\n  /* ── layout ────────────────────────────────────────────── */\n  --hbd-layout-max-width: 68.75rem;\n  --hbd-layout-page-padding: clamp(1rem