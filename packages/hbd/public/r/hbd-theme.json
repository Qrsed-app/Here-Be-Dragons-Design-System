ary: var(--hbd-color-ink-900);\n  --hbd-color-text-muted:     var(--hbd-color-ink-900);\n  --hbd-color-text-inverse:   var(--hbd-color-parchment-50);\n  --hbd-color-text-disabled:  var(--hbd-color-ink-700);\n\n  /* borders */\n  --hbd-color-border-default: var(--hbd-color-ink-900);\n  --hbd-color-border-subtle:  var(--hbd-color-ink-900);\n  --hbd-color-border-strong:  var(--hbd-color-ink-900);\n  --hbd-color-border-focus:   var(--hbd-color-ink-900);\n\n  /* action */\n  --hbd-color-surface-action:       var(--hbd-color-ink-900);\n  --hbd-color-surface-action-hover: var(--hbd-color-ink-950);\n  --hbd-color-text-on-action:       var(--hbd-color-parchment-50);\n\n  /* status — parchment-50 surface + ink-900 text (≈17:1); meaning via border/icon */\n  --hbd-color-status-success-surface: var(--hbd-color-parchment-50);\n  --hbd-color-status-success-text:    var(--hbd-color-ink-900);\n  --hbd-color-status-warning-surface: var(--hbd-color-parchment-50);\n  --hbd-color-status-warning-text:    var(--hbd-color-ink-900);\n  --hbd-color-status-error-surface:   var(--hbd-color-parchment-50);\n  --hbd-color-status-error-text:      var(--hbd-color-ink-900);\n  --hbd-color-status-info-surface:    var(--hbd-color-parchment-50);\n  --hbd-color-status-info-text:       var(--hbd-color-ink-900);\n\n  /* focus */\n  --hbd-color-focus-ring: var(--hbd-color-ink-900);\n}\n\n/* shadcn semantic aliases -> HBD semantic tokens (cascade through [data-theme] automatically) */\n:root {\n  --background: var(--hbd-color-surface-default);\n  --foreground: var(--hbd-color-text-primary);\n  --card: var(--hbd-color-surface-default);\n  --card-foreground: var(--hbd-color-text-primary);\n  --popover: var(--hbd-color-surface-raised);\n  --popover-foreground: var(--hbd-color-text-primary);\n  --primary: var(--hbd-color-surface-action);\n  --primary-foreground: var(--hbd-color-text-on-action);\n  --secondary: var(--hbd-color-surface-subtle);\n  --secondary-foreground: var(--hbd-color-text-primary);\n  --muted