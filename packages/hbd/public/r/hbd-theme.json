ocus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n.hbd-date-picker__footer-btn--muted {\n  color: var(--hbd-color-text-muted);\n}\n\n/* ── 8 · Date-time slot ────────────────────────────────────────────── */\n/* The date-time variant slots an <hbd-time-picker> inline below the\n   footer separator. The wrapper just gives it breathing room. */\n.hbd-date-picker__time-slot {\n  display: flex;\n  justify-content: center;\n  padding-top: var(--hbd-space-3);\n  margin-top: var(--hbd-space-2);\n  border-top: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n}\n\n/* ──────── divider.css ──────── */\n/*\n * Here Be Dragons DS\n * registry/new-york/styles/components/divider.css\n *\n * Divider — horizontal/vertical rules, colour + style modifiers, labelled\n * and ornamental variants. Flattened from ds/styles/components/divider.css.\n * Light-DOM component: no :host/::slotted/::part to de-shadow. Every value\n * references a --hbd-* token.\n */\n\n/* ── Base horizontal divider ────────────────────────────────────────── */\n.hbd-divider {\n  display: block;\n  border: none;\n  border-top: var(--hbd-border-width-hairline) solid var(--hbd-color-border-default);\n  margin: var(--hbd-space-6) 0;\n  width: 100%;\n}\n\n/* ── Vertical ───────────────────────────────────────────────────────── */\n.hbd-divider--vertical {\n  display: inline-block;\n  border: none;\n  border-left: var(--hbd-border-width-hairline) solid var(--hbd-color-border-default);\n  height: 1em;\n  width: 0;\n  margin: 0 var(--hbd-space-2);\n  vertical-align: middle;\n}\n\n/* ── Colour modifiers ───────────────────────────────────────────────────\n * Dividers are decorative — no contrast requirement (WCAG 1.4.11 exempts\n * pure decoration), so the lighter border tokens are intentional. */\n.hbd-divider--subtle { border-color: var(--hbd-color-border-subtle); }\n.hbd-divider--strong { border-color: var(--hbd-color-border-strong); }\n.hbd-divider--gold   { border-color: var(--hbd-color-gold); }\n\n/* ── Style modifiers ────────────────────────────────────────────────── */\n/* Dashed: a repeating-linear-gradient line gives finer, lighter dashes than\n   CSS `border-style: dashed`, whose dash size is tied to (and looks chunky at)\n   the border width. The border itself is removed and replaced by the line. */\n.hbd-divider--dashed {\n  border-top: none;\n  height: var(--hbd-border-width-hairline);\n  background: repeating-linear-gradient(\n    to right,\n    var(--hbd-color-border-default) 0,\n    var(--hbd-color-border-default) var(--hbd-space-1),\n    transparent var(--hbd-space-1),\n    transparent calc(var(--hbd-space-1) * 2)\n  );\n}\n.hbd-divider--dashed.hbd-divider--subtle { background: repeating-linear-gradient(to right, var(--hbd-color-border-subtle) 0, var(--hbd-color-border-subtle) var(--hbd-space-1), transparent var(--hbd-space-1), transparent calc(var(--hbd-space-1) * 2)); }\n.hbd-divider--dashed.hbd-divider--strong { background: repeating-linear-gradient(to right, var(--hbd-color-border-strong) 0, var(--hbd-color-border-strong) var(--hbd-space-1), transparent var(--hbd-space-1), transparent calc(var(--hbd-space-1) * 2)); }\n.hbd-divider--dashed.hbd-divider--gold   { background: repeating-linear-gradient(to right, var(--hbd-color-gold) 0, var(--hbd-color-gold) var(--hbd-space-1), transparent var(--hbd-space-1), transparent calc(var(--hbd-space-1) * 2)); }\n.hbd-divider--double {\n  border-top: var(--hbd-border-width-medium) double var(--hbd-color-border-default);\n}\n.hbd-divider--double.hbd-divider--gold {\n  border-top-color: var(--hbd-color-gold);\n}\n\n/* ── Labelled variant ───────────────────────────────────────────────── */\n.hbd-divider--with-label {\n  display: flex;\n  align-items: center;\n  gap: var(--hbd-space-3);\n  border: none;\n  margin: var(--hbd-space-6) 0;\n  width: 100%;\n}\n.hbd-divider--with-label::before,\n.hbd-divider--with-label::after {\n  content: \"\";\n  flex: 1;\n  border-top: var(--hbd-border-width-hairline) solid var(--hbd-color-border-default);\n}\n.hbd-divider--with-label.hbd-divider--subtle::before,\n.hbd-divider--with-label.hbd-divider--subtle::after { border-top-color: var(--hbd-color-border-subtle); }\n.hbd-divider--with-label.hbd-divider--strong::before,\n.hbd-divider--with-label.hbd-divider--strong::after { border-top-color: var(--hbd-color-border-strong); }\n.hbd-divider--with-label.hbd-divider--gold::before,\n.hbd-divider--with-label.hbd-divider--gold::after { border-top-color: var(--hbd-color-gold); }\n\n.hbd-divider__label {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  color: var(--hbd-color-text-muted);\n  letter-spacing: var(--hbd-letter-spacing-label);\n  text-transform: uppercase;\n  white-space: nowrap;\n  flex-shrink: 0;\n}\n\n/* ── Ornamental variant (HBD sigil) ─────────────────────────────────────\n * Decorative. Flanking lines use the legacy gradient fade\n * (transparent → gold-deep → transparent). The ornament glyph is provided\n * by the author as children. */\n.hbd-divider--ornamental {\n  display: flex;\n  align-items: center;\n  gap: var(--hbd-space-3);\n  border: none;\n  margin: var(--hbd-space-8) 0;\n  width: 100%;\n}\n.hbd-divider--ornamental::before,\n.hbd-divider--ornamental::after {\n  content: \"\";\n  flex: 1;\n  height: var(--hbd-border-width-hairline);\n  background: linear-gradient(to right, transparent, var(--hbd-color-gold-deep), transparent);\n}\n.hbd-divider__ornament {\n  flex-shrink: 0;\n  display: inline-flex;\n  align-items: center;\n  color: var(--hbd-color-gold-deep);\n}\n\n/* ──────── drawer.css ──────── */\n/*\n * Here Be Dragons DS\n * styles/components/drawer.css\n *\n * De-shadowed from ds/styles/components/drawer.css. The legacy WC was a\n * Shadow-DOM custom element whose .is-open / .is-closing modifiers drove\n * a `transition: transform` on the panel, and whose JS waited for the\n * panel's transitionend before tearing down (scroll-lock release,\n * focus-return, hbd:close). This React port plumbs portal + focus-trap +\n * scroll-lock + return-focus + Escape + outside-pointerdown via Radix\n * Dialog. Radix keeps the Content/Overlay mounted during the exit because\n * we express enter/exit as @keyframes keyed off data-state (Radix Presence\n * waits for the animation to finish before unmounting) — this reproduces\n * the WC's transitionend close lifecycle 1:1.\n *\n * Class bridging (Radix):\n * - .hbd-drawer__backdrop is re-applied to Radix Dialog.Overlay,\n *   .hbd-drawer__panel to Radix Dialog.Content. The wrapper .hbd-drawer\n *   (+ placement / --wide / --tall / --no-backdrop modifiers) is re-applied\n *   to the Content so the placement transforms resolve identically.\n * - data-state=\"open\" -> the WC's .is-open reveal (slide-in).\n *   data-state=\"closed\" -> the WC's .is-closing exit (slide-out).\n *   The legacy .is-open / .is-closing classes are ALSO emitted from the\n *   React side off the resolved data-state so any author CSS keyed on them\n *   keeps working.\n *\n * Notes:\n * - All values via --hbd-* tokens.\n * - The backdrop scrim uses rgba(ink-900, 0.6) — the documented inline-rgba\n *   exception carried verbatim from the source (a 60% ink-900 overlay is\n *   not representable as a single --hbd-color-* token without color-mix).\n * - Spec referenced --hbd-spacing-N; emitted tokens are --hbd-space-N.\n * - No absolute /paths: tokens come from the app globals, not a <link>.\n */\n\n/* ── 1 · Wrapper ──────────────────────────────────────────────────── */\n/* In the WC the wrapper was `display: contents` and the fixed children\n   (backdrop + panel) did the overlay work. With Radix the Overlay and\n   Content are portalled siblings, so the wrapper class lives on Content\n   alongside the panel class — it only carries the placement modifiers\n   that the panel transform rules below read. */\n.hbd-drawer {\n  display: contents;\n}\n\n/* ── 2 · Backdrop ─────────────────────────────────────────────────── */\n/* Semi-transparent scrim covering the viewport. Documented rgba\n   exception — a 60% ink-900 overlay is not representable as a single\n   --hbd-color-* token without color-mix at the call site. */\n.hbd-drawer__backdrop {\n  position: fixed;\n  inset: 0;\n  z-index: var(--hbd-z-overlay);\n  background: rgba(26, 20, 16, 0.6);\n  opacity: 0;\n  pointer-events: none;\n  transition: opacity var(--hbd-duration-normal) var(--hbd-ease-out);\n}\n.hbd-drawer__backdrop[data-state=\"open\"],\n.hbd-drawer.is-open .hbd-drawer__backdrop {\n  opacity: 1;\n  pointer-events: auto;\n}\n.hbd-drawer__backdrop[data-state=\"closed\"],\n.hbd-drawer.is-closing .hbd-drawer__backdrop {\n  opacity: 0;\n  /* Keep pointer-events on briefly so a backdrop click during the exit\n     animation doesn't fall through to the page underneath. */\n  pointer-events: auto;\n}\n\n/* ── 3 · Panel ────────────────────────────────────────────────────── */\n.hbd-drawer__panel {\n  position: fixed;\n  z-index: var(--hbd-z-modal);\n  background: var(--hbd-color-surface-default);\n  box-shadow: var(--hbd-shadow-xl);\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  /* All placements share the same transition timing on transform. The\n     prefers-reduced-motion global override collapses this to ~0ms.\n     Enter/exit are expressed as @keyframes (keyed off data-state) so\n     Radix Presence keeps the panel mounted through the exit, matching\n     the WC's transitionend-driven close. */\n  transition: transform var(--hbd-duration-normal) var(--hbd-ease-out);\n}\n\n/* Left placement (default). */\n.hbd-drawer--left .hbd-drawer__panel {\n  top: 0;\n  left: 0;\n  bottom: 0;\n  width: var(--hbd-drawer-width);\n  transform: translateX(-100%);\n}\n.hbd-drawer--left.is-open .hbd-drawer__panel { transform: translateX(0); }\n.hbd-drawer--left.is-closing .hbd-drawer__panel { transform: translateX(-100%); }\n.hbd-drawer--left .hbd-drawer__panel[data-state=\"open\"] {\n  transform: translateX(0);\n  animation: hbd-drawer-slide-in-left var(--hbd-duration-normal) var(--hbd-ease-out);\n}\n.hbd-drawer--left .hbd-drawer__panel[data-state=\"closed\"] {\n  transform: translateX(-100%);\n  animation: hbd-drawer-slide-out-left var(--hbd-duration-normal) var(--hbd-ease-out);\n}\n.hbd-drawer--left.hbd-drawer--wide .hbd-drawer__panel { width: var(--hbd-drawer-width-wide); }\n\n/* Right placement. */\n.hbd-drawer--right .hbd-drawer__panel {\n  top: 0;\n  right: 0;\n  bottom: 0;\n  width: var(--hbd-drawer-width);\n  transform: translateX(100%);\n}\n.hbd-drawer--right.is-open .hbd-drawer__panel { transform: translateX(0); }\n.hbd-drawer--right.is-closing .hbd-drawer__panel { transform: translateX(100%); }\n.hbd-drawer--right .hbd-drawer__panel[data-state=\"open\"] {\n  transform: translateX(0);\n  animation: hbd-drawer-slide-in-right var(--hbd-duration-normal) var(--hbd-ease-out);\n}\n.hbd-drawer--right .hbd-drawer__panel[data-state=\"closed\"] {\n  transform: translateX(100%);\n  animation: hbd-drawer-slide-out-right var(--hbd-duration-normal) var(--hbd-ease-out);\n}\n.hbd-drawer--right.hbd-drawer--wide .hbd-drawer__panel { width: var(--hbd-drawer-width-wide); }\n\n/* Top placement. */\n.hbd-drawer--top .hbd-drawer__panel {\n  top: 0;\n  left: 0;\n  right: 0;\n  height: var(--hbd-drawer-height);\n  transform: translateY(-100%);\n  border-radius: 0 0 var(--hbd-radius-lg) var(--hbd-radius-lg);\n}\n.hbd-drawer--top.is-open .hbd-drawer__panel { transform: translateY(0); }\n.hbd-drawer--top.is-closing .hbd-drawer__panel { transform: translateY(-100%); }\n.hbd-drawer--top .hbd-drawer__panel[data-state=\"open\"] {\n  transform: translateY(0);\n  animation: hbd-drawer-slide-in-top var(--hbd-duration-normal) var(--hbd-ease-out);\n}\n.hbd-drawer--top .hbd-drawer__panel[data-state=\"closed\"] {\n  transform: translateY(-100%);\n  animation: hbd-drawer-slide-out-top var(--hbd-duration-normal) var(--hbd-ease-out);\n}\n.hbd-drawer--top.hbd-drawer--tall .hbd-drawer__panel { height: var(--hbd-drawer-height-tall); }\n\n/* Bottom placement. */\n.hbd-drawer--bottom .hbd-drawer__panel {\n  bottom: 0;\n  left: 0;\n  right: 0;\n  height: var(--hbd-drawer-height);\n  transform: translateY(100%);\n  border-radius: var(--hbd-radius-lg) var(--hbd-radius-lg) 0 0;\n}\n.hbd-drawer--bottom.is-open .hbd-drawer__panel { transform: translateY(0); }\n.hbd-drawer--bottom.is-closing .hbd-drawer__panel { transform: translateY(100%); }\n.hbd-drawer--bottom .hbd-drawer__panel[data-state=\"open\"] {\n  transform: translateY(0);\n  animation: hbd-drawer-slide-in-bottom var(--hbd-duration-normal) var(--hbd-ease-out);\n}\n.hbd-drawer--bottom .hbd-drawer__panel[data-state=\"closed\"] {\n  transform: translateY(100%);\n  animation: hbd-drawer-slide-out-bottom var(--hbd-duration-normal) var(--hbd-ease-out);\n}\n.hbd-drawer--bottom.hbd-drawer--tall .hbd-drawer__panel { height: var(--hbd-drawer-height-tall); }\n\n/* ── Slide keyframes ──────────────────────────────────────────────── */\n/* These replace the WC's bare `transition: transform` so Radix Presence\n   keeps the node mounted through the exit (it watches animationName).\n   Endpoints + timing match the legacy is-open / is-closing transforms\n   exactly, so the motion is identical. */\n@keyframes hbd-drawer-slide-in-left {\n  from { transform: translateX(-100%); }\n  to   { transform: translateX(0); }\n}\n@keyframes hbd-drawer-slide-out-left {\n  from { transform: translateX(0); }\n  to   { transform: translateX(-100%); }\n}\n@keyframes hbd-drawer-slide-in-right {\n  from { transform: translateX(100%); }\n  to   { transform: translateX(0); }\n}\n@keyframes hbd-drawer-slide-out-right {\n  from { transform: translateX(0); }\n  to   { transform: translateX(100%); }\n}\n@keyframes hbd-drawer-slide-in-top {\n  from { transform: translateY(-100%); }\n  to   { transform: translateY(0); }\n}\n@keyframes hbd-drawer-slide-out-top {\n  from { transform: translateY(0); }\n  to   { transform: translateY(-100%); }\n}\n@keyframes hbd-drawer-slide-in-bottom {\n  from { transform: translateY(100%); }\n  to   { transform: translateY(0); }\n}\n@keyframes hbd-drawer-slide-out-bottom {\n  from { transform: translateY(0); }\n  to   { transform: translateY(100%); }\n}\n\n/* ── 4 · Header / body / footer ───────────────────────────────────── */\n.hbd-drawer__header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--hbd-space-3);\n  padding: var(--hbd-space-4) var(--hbd-space-4) var(--hbd-space-3);\n  border-bottom: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n  flex-shrink: 0;\n}\n\n.hbd-drawer__title {\n  font-family: var(--hbd-font-family-accent);\n  font-size: var(--hbd-font-size-h3);\n  font-weight: var(--hbd-font-weight-semibold);\n  letter-spacing: var(--hbd-letter-spacing-wide);\n  color: var(--hbd-color-text-primary);\n  margin: 0;\n}\n\n.hbd-drawer__close {\n  flex-shrink: 0;\n}\n\n.hbd-drawer__body {\n  flex: 1;\n  min-height: 0;\n  overflow-y: auto;\n  padding: var(--hbd-space-4);\n  overscroll-behavior: contain;\n  color: var(--hbd-color-text-primary);\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-body);\n  line-height: var(--hbd-line-height-body);\n}\n\n.hbd-drawer__footer {\n  display: flex;\n  gap: var(--hbd-space-2);\n  justify-content: flex-end;\n  padding: var(--hbd-space-3) var(--hbd-space-4);\n  border-top: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n  flex-shrink: 0;\n}\n/* Hide the footer row entirely when nothing is slotted in. The React side\n   sets data-empty=\"true\" when no footer content is provided, mirroring the\n   WC's slotchange-driven flag. */\n.hbd-drawer__footer[data-empty=\"true\"] {\n  display: none;\n}\n\n/* ── 5 · Sidebar mode ─────────────────────────────────────────────── */\n/* When the host has the no-backdrop attribute the drawer behaves as a\n   sidebar: no scrim, no pointer-blocking, but the same transform\n   transitions. */\n.hbd-drawer.hbd-drawer--no-backdrop .hbd-drawer__backdrop {\n  display: none;\n}\n\n/* ──────── empty.css ──────── */\n/*\n * Here Be Dragons DS — empty.css\n * Ported for React / light-DOM from ds/styles/components/empty-state.css.\n * The WC already used light DOM (no :host / ::slotted / ::part), so this is a\n * verbatim copy of the selectors. Every value still references a --hbd-* token\n * (defined in globals.css). 1:1 with the legacy look.\n */\n\n/* ── 1 · Base ─────────────────────────────────────────────────────── */\n.hbd-empty {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  text-align: center;\n  gap: var(--hbd-space-4);\n  padding: var(--hbd-space-8) var(--hbd-space-6);\n  width: 100%;\n}\n\n.hbd-empty--sm {\n  padding: var(--hbd-space-6) var(--hbd-space-4);\n  gap: var(--hbd-space-3);\n}\n\n.hbd-empty--lg {\n  min-height: var(--hbd-empty-state-min-height-lg);\n  padding: var(--hbd-space-12) var(--hbd-space-6);\n}\n\n/* ── 2 · Illustration ─────────────────────────────────────────────── */\n.hbd-empty__illustration {\n  width: var(--hbd-space-16);\n  height: var(--hbd-space-16);\n  color: var(--hbd-color-text-muted);\n  /*\n   * 0.6 opacity is a documented decorative-illustration exception —\n   * the icon reinforces the heading and is exempt from SC 1.4.3\n   * contrast. The heading text carries the meaning.\n   */\n  opacity: 0.6;\n  flex-shrink: 0;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.hbd-empty__illustration svg {\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n\n.hbd-empty--sm .hbd-empty__illustration {\n  width: var(--hbd-space-12);\n  height: var(--hbd-space-12);\n}\n\n.hbd-empty--lg .hbd-empty__illustration {\n  width: var(--hbd-space-24);\n  height: var(--hbd-space-24);\n}\n\n/* ── 3 · Content wrapper ──────────────────────────────────────────── */\n.hbd-empty__content {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: var(--hbd-space-3);\n}\n\n.hbd-empty--inline .hbd-empty__content {\n  align-items: flex-start;\n}\n\n/* ── 4 · Heading ──────────────────────────────────────────────────── */\n.hbd-empty__heading {\n  /* Tiamat Condensed SC for the empty-state heading — section-title\n     personality. 700-weight matches the only weight registered in\n     the Tiamat @font-face (foundations/typography.css). */\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-font-size-h3);\n  font-weight: var(--hbd-font-weight-bold);\n  color: var(--hbd-color-text-primary);\n  margin: 0;\n  line-height: var(--hbd-line-height-display);\n  max-width: var(--hbd-empty-state-heading-max-width);\n  letter-spacing: var(--hbd-letter-spacing-display);\n}\n\n.hbd-empty--sm .hbd-empty__heading {\n  font-size: var(--hbd-font-size-h4);\n}\n\n.hbd-empty--lg .hbd-empty__heading {\n  font-size: var(--hbd-font-size-h2);\n  max-width: var(--hbd-empty-state-heading-max-width-lg);\n}\n\n/* ── 5 · Description ──────────────────────────────────────────────── */\n.hbd-empty__description {\n  font-family: var(--hbd-font-family-serif);\n  font-size: var(--hbd-font-size-body);\n  color: var(--hbd-color-text-muted);\n  line-height: var(--hbd-line-height-body);\n  margin: 0;\n  max-width: var(--hbd-empty-state-description-max-width);\n}\n\n.hbd-empty--lg .hbd-empty__description {\n  max-width: var(--hbd-empty-state-description-max-width-lg);\n}\n\n/* ── 6 · Actions ──────────────────────────────────────────────────── */\n.hbd-empty__actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--hbd-space-2);\n  justify-content: center;\n  align-items: center;\n}\n\n/* When no children were authored, the actions row collapses so the\n   layout doesn't leave a phantom gap. The component sets data-empty on\n   the wrapper when no actions are appended. */\n.hbd-empty__actions[data-empty] {\n  display: none;\n}\n\n/* ── 7 · Inline modifier ──────────────────────────────────────────── */\n.hbd-empty--inline {\n  flex-direction: row;\n  text-align: left;\n  padding: var(--hbd-space-4);\n  align-items: center;\n  gap: var(--hbd-space-4);\n}\n\n.hbd-empty--inline .hbd-empty__illustration {\n  width: var(--hbd-space-12);\n  height: var(--hbd-space-12);\n}\n\n.hbd-empty--inline .hbd-empty__actions {\n  justify-content: flex-start;\n}\n\n/* Inline lays out as: [icon] [text + actions stacked, left-aligned]\n   The content takes the remaining width. */\n.hbd-empty--inline .hbd-empty__content {\n  flex: 1;\n  min-width: 0;\n}\n\n/* ── 8 · Semantic variants — error / success (Phase 5) ───────────── */\n/*\n * Applied when the template key starts with \"error-\" / \"success-\"\n * (e.g. error-404, success-completed). Also applied to the legacy\n * \"error\" template so it picks up the same tint retroactively.\n *\n * Only the illustration is tinted. The heading + description stay\n * neutral so contrast is preserved and the meaning is carried in\n * TEXT (SC 1.4.1, SC 3.3.1). The opacity here is slightly higher\n * than the base illustration (0.8 vs 0.6) so the tinted colour\n * reads at a usable contrast ratio against the parchment surface.\n */\n.hbd-empty--error .hbd-empty__illustration {\n  color: var(--hbd-color-status-error-border);\n  opacity: 0.8;\n}\n.hbd-empty--success .hbd-empty__illustration {\n  color: var(--hbd-color-status-success-border);\n  opacity: 0.8;\n}\n\n/* ──────── file-upload.css ──────── */\n/*\n * Here Be Dragons DS\n * registry/new-york/styles/components/file-upload.css\n *\n * Ported 1:1 (de-shadowed) from ds/styles/components/file-upload.css.\n * The WC rendered in Shadow DOM and adopted tokens.css + accessibility.css +\n * input.css alongside this file; in the React port the component renders in\n * light DOM, so there is no :host / ::slotted / ::part to rewrite — every\n * selector below is the verbatim original. The shared .hbd-field label / hint /\n * error / footer chrome comes from the input.css dependency; the global\n * .hbd-sr-only + :focus-visible ring come from hbd-theme globals.\n *\n * File upload — dropzone, file list rows, per-file progress, image previews.\n * The outer wrapper uses .hbd-field for label / hint / error / footer\n * continuity with the other form inputs.\n *\n * All values via --hbd-* tokens.\n */\n\n/* ── 1 · Block ─────────────────────────────────────────────────────── */\n.hbd-file-upload {\n  display: flex;\n  flex-direction: column;\n  gap: var(--hbd-space-2);\n  width: 100%;\n}\n\n/* ── 2 · Dropzone — the interactive drop target ────────────────────── */\n.hbd-file-upload__dropzone {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: var(--hbd-space-2);\n  min-height: var(--hbd-file-upload-dropzone-min-height);\n  padding: var(--hbd-space-6);\n  /* border-strong (ink-700, ~11.4:1 on parchment) — same SC 1.4.11\n     precedent as the input borders. border-default would be ~2.06:1. */\n  border: var(--hbd-border-width-thin) dashed var(--hbd-color-border-strong);\n  border-radius: var(--hbd-radius-lg);\n  background: var(--hbd-color-surface-subtle);\n  cursor: pointer;\n  text-align: center;\n  transition: border-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              background-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              box-shadow var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n\n.hbd-file-upload__dropzone:hover {\n  border-color: var(--hbd-color-surface-action);\n  background: var(--hbd-color-surface-default);\n}\n\n.hbd-file-upload__dropzone:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n/* Active drag state — solid border + soft halo. The halo uses\n   --hbd-color-gold-deep at the focus-ring offset distance to mirror the\n   focus pattern; fully tokenised, no inline rgba. */\n.hbd-file-upload--drag-over .hbd-file-upload__dropzone {\n  border-style: solid;\n  border-color: var(--hbd-color-surface-action);\n  background: var(--hbd-color-surface-default);\n  box-shadow: 0 0 0 var(--hbd-space-1) var(--hbd-color-gold-deep);\n}\n\n/* Field-level error — tint the dropzone border. */\n.hbd-file-upload--error .hbd-file-upload__dropzone {\n  border-color: var(--hbd-color-status-error-border);\n}\n\n/* Disabled — visual + cursor only; pointer events are also blocked. */\n.hbd-file-upload--disabled .hbd-file-upload__dropzone {\n  opacity: 0.5;\n  cursor: not-allowed;\n  pointer-events: none;\n}\n\n/* ── 3 · Prompt text & icon ────────────────────────────────────────── */\n.hbd-file-upload__icon {\n  color: var(--hbd-color-text-muted);\n  width: var(--hbd-space-8);\n  height: var(--hbd-space-8);\n}\n\n.hbd-file-upload__prompt {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-body);\n  color: var(--hbd-color-text-secondary);\n  margin: 0;\n}\n\n/* Browse affordance — visually-textual link inside the prompt. */\n.hbd-file-upload__browse {\n  color: var(--hbd-color-text-emphasis);\n  text-decoration: underline;\n  cursor: pointer;\n  font-weight: var(--hbd-font-weight-medium);\n}\n\n.hbd-file-upload__constraints {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-micro);\n  color: var(--hbd-color-text-muted);\n  margin: 0;\n}\n\n/* ── 4 · Hidden native file input ──────────────────────────────────── */\n/* Canonical visually-hidden technique lives in the global .hbd-sr-only\n   (hbd-theme) — applied to the native input in the React component to avoid\n   duplicating the hairline-clip literal here. This rule only adds the\n   component-specific pointer-events guard. */\n.hbd-file-upload__input {\n  pointer-events: none;\n}\n\n/* ── 5 · File list ─────────────────────────────────────────────────── */\n.hbd-file-upload__file-list {\n  display: flex;\n  flex-direction: column;\n  gap: var(--hbd-space-2);\n  margin: var(--hbd-space-3) 0 0;\n  padding: 0;\n  list-style: none;\n}\n\n.hbd-file-upload__file-item {\n  display: flex;\n  align-items: center;\n  gap: var(--hbd-space-3);\n  padding: var(--hbd-space-2) var(--hbd-space-3);\n  background: var(--hbd-color-surface-default);\n  border: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n  border-radius: var(--hbd-radius-md);\n}\n\n/* ── 6 · File preview thumbnail ────────────────────────────────────── */\n.hbd-file-upload__file-preview {\n  width: var(--hbd-file-upload-preview-size);\n  height: var(--hbd-file-upload-preview-size);\n  border-radius: var(--hbd-radius-sm);\n  overflow: hidden;\n  flex-shrink: 0;\n  background: var(--hbd-color-surface-subtle);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--hbd-color-text-muted);\n}\n.hbd-file-upload__file-preview img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n/* ── 7 · File info (name + size + progress) ────────────────────────── */\n.hbd-file-upload__file-info {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: var(--hbd-space-1);\n}\n\n.hbd-file-upload__file-name {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-body);\n  color: var(--hbd-color-text-primary);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.hbd-file-upload__file-size {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-micro);\n  color: var(--hbd-color-text-muted);\n}\n\n/* Per-file error message — on-page dark red, same precedent as the other\n   form inputs (status-error-text is near-white and unreadable here). */\n.hbd-file-upload__file-error {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-micro);\n  color: var(--hbd-color-text-emphasis);\n}\n\n/* ── 8 · Progress bar ──────────────────────────────────────────────── */\n.hbd-file-upload__file-progress {\n  height: var(--hbd-file-upload-progress-height);\n  background: var(--hbd-color-border-subtle);\n  border-radius: var(--hbd-radius-full);\n  overflow: hidden;\n}\n\n/* JS sets width inline — value-driven, cannot be expressed in pure CSS.\n   Documented exception (parallel to slider fill, textarea autoresize). */\n.hbd-file-upload__file-bar {\n  height: 100%;\n  width: 0;\n  background: var(--hbd-color-surface-action);\n  border-radius: var(--hbd-radius-full);\n  transition: width var(--hbd-duration-normal) var(--hbd-ease-out);\n}\n\n.hbd-file-upload__file-item.is-complete .hbd-file-upload__file-bar {\n  background: var(--hbd-color-status-success-border);\n}\n.hbd-file-upload__file-item.is-error .hbd-file-upload__file-bar {\n  background: var(--hbd-color-status-error-border);\n}\n\n/* ── 9 · File status icon (right of info) ──────────────────────────── */\n.hbd-file-upload__file-status {\n  flex-shrink: 0;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--hbd-space-6);\n  height: var(--hbd-space-6);\n  color: var(--hbd-color-text-muted);\n}\n.hbd-file-upload__file-item.is-complete .hbd-file-upload__file-status {\n  color: var(--hbd-color-status-success-border);\n}\n.hbd-file-upload__file-item.is-error .hbd-file-upload__file-status {\n  color: var(--hbd-color-status-error-border);\n}\n\n/* ── 10 · Remove button ────────────────────────────────────────────── */\n/* min-width/min-height lifts the tap area toward SC 2.5.8; the X icon\n   sits at its natural size inside via flex centring. */\n.hbd-file-upload__file-remove {\n  flex-shrink: 0;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-width: var(--hbd-space-8);\n  min-height: var(--hbd-space-8);\n  padding: var(--hbd-space-2);\n  background: none;\n  border: none;\n  border-radius: var(--hbd-radius-sm);\n  color: var(--hbd-color-text-muted);\n  cursor: pointer;\n  transition: background-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n/* Icon sizing — the SVG carries explicit width/height but ensure it\n   isn't crushed by the flex parent's defaults. */\n.hbd-file-upload__file-remove svg {\n  flex-shrink: 0;\n  width: var(--hbd-space-4);\n  height: var(--hbd-space-4);\n}\n.hbd-file-upload__file-remove:hover {\n  color: var(--hbd-color-text-emphasis);\n  background: var(--hbd-color-surface-subtle);\n}\n.hbd-file-upload__file-remove:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n/* ──────── full-banner.css ──────── */\n/*\n * Here Be Dragons DS — full-banner.css\n * Ported for React / light-DOM from ds/styles/components/full-page-banner.css.\n * The source WC uses Light DOM with no :host/::slotted/::part/@keyframes, so the\n * selectors already target the .hbd-full-banner BEM classes 1:1 — copied verbatim.\n * Every value still references a --hbd-* token (defined in globals.css).\n *\n * Full-page banner — fills the viewport with a single dominant\n * message (maintenance, launch, restricted, offline). Distinct\n * from the narrow .hbd-alert--banner ribbon: that is a top-of-page\n * strip, this is a full-screen takeover with hero typography.\n *\n * Naming notes:\n * - Spec referenced --hbd-spacing-N — emitted tokens are --hbd-space-N.\n * - Spec referenced --hbd-color-action-default for the launch\n *   eyebrow accent — emitted token is --hbd-color-text-emphasis\n *   (the canonical \"emphasis\"/action text colour, also consumed\n *   by hbd-input error text and hbd-link). The launch variant\n *   uses it so the eyebrow reads as a \"highlight\" tone against\n *   the neutral parchment surface.\n * - The 560px / 440px content widths are promoted to per-component\n *   tokens (--hbd-full-banner-inner-max-width /\n *   --hbd-full-banner-description-max-width) so the literals live\n *   in tokens.json.\n *\n * SC 2.4.2 (Page Titled): when used as a true full-page replacement,\n * the document <title> must reflect the banner state (e.g.\n * \"Maintenance — Here Be Dragons\"). That is the author's\n * responsibility, not this component's — there is no DOM-level\n * mechanism for the banner to mutate document.title safely.\n */\n\n/* ── 1 · Base ─────────────────────────────────────────────────────── */\n.hbd-full-banner {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 100vh;\n  padding: var(--hbd-space-8) var(--hbd-layout-container-padding);\n  background: var(--hbd-color-surface-default);\n  text-align: center;\n  font-family: var(--hbd-font-family-ui);\n  color: var(--hbd-color-text-primary);\n}\n\n/* ── 2 · Inner ────────────────────────────────────────────────────── */\n.hbd-full-banner__inner {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: var(--hbd-space-4);\n  max-width: var(--hbd-full-banner-inner-max-width);\n  width: 100%;\n}\n\n/* ── 3 · Illustration ─────────────────────────────────────────────── */\n.hbd-full-banner__illustration {\n  width: var(--hbd-space-24);\n  height: var(--hbd-space-24);\n  color: var(--hbd-color-text-muted);\n  /*\n   * 0.7 opacity is a documented decorative-illustration exception —\n   * the SVG reinforces the heading and is exempt from SC 1.4.3\n   * contrast. Same stance as hbd-empty.\n   */\n  opacity: 0.7;\n  margin-bottom: var(--hbd-space-2);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n.hbd-full-banner__illustration svg {\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n\n/* ── 4 · Eyebrow ──────────────────────────────────────────────────── */\n.hbd-full-banner__eyebrow {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  font-weight: var(--hbd-font-weight-semibold);\n  letter-spacing: var(--hbd-letter-spacing-label);\n  text-transform: uppercase;\n  color: var(--hbd-color-text-muted);\n  margin: 0;\n}\n\n.hbd-full-banner--maintenance .hbd-full-banner__eyebrow {\n  color: var(--hbd-color-status-warning-icon);\n}\n.hbd-full-banner--restricted .hbd-full-banner__eyebrow {\n  color: var(--hbd-color-status-error-border);\n}\n.hbd-full-banner--launch .hbd-full-banner__eyebrow {\n  color: var(--hbd-color-text-emphasis);\n}\n.hbd-full-banner--offline .hbd-full-banner__eyebrow {\n  color: var(--hbd-color-text-muted);\n}\n\n/* ── 5 · Heading ──────────────────────────────────────────────────── */\n/*\n * Fluid heading scale. clamp() interpolates between h2 (~1.75rem)\n * at small viewports and h1 (~2.5rem) at large viewports. The 5vw\n * preferred value is a fluid-typography geometric constant — it\n * cannot be tokenised without removing the responsiveness, and it\n * is a documented permitted exception (same pattern as\n * --hbd-font-size-hero in tokens.json).\n */\n.hbd-full-banner__heading {\n  font-family: var(--hbd-font-family-display);\n  font-size: clamp(var(--hbd-font-size-h2), 5vw, var(--hbd-font-size-h1));\n  font-weight: var(--hbd-font-weight-bold);\n  color: var(--hbd-color-text-primary);\n  margin: 0;\n  line-height: var(--hbd-line-height-display);\n  letter-spacing: var(--hbd-letter-spacing-display);\n}\n\n/* ── 6 · Description ──────────────────────────────────────────────── */\n.hbd-full-banner__description {\n  font-family: var(--hbd-font-family-serif);\n  font-size: var(--hbd-font-size-body);\n  color: var(--hbd-color-text-muted);\n  line-height: var(--hbd-line-height-body);\n  max-width: var(--hbd-full-banner-description-max-width);\n  margin: 0;\n}\n\n/* ── 7 · Actions ──────────────────────────────────────────────────── */\n.hbd-full-banner__actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--hbd-space-2);\n  justify-content: center;\n  align-items: center;\n}\n\n/* When no actions are slotted in, the wrapper collapses so it\n   doesn't leave a phantom gap below the description. */\n.hbd-full-banner__actions[data-empty=\"true\"] {\n  display: none;\n}\n\n/* ── 8 · Meta ─────────────────────────────────────────────────────── */\n.hbd-full-banner__meta {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-micro);\n  color: var(--hbd-color-text-muted);\n  margin-top: var(--hbd-space-4);\n}\n.hbd-full-banner__meta[data-empty=\"true\"] {\n  display: none;\n}\n\n/* ── 9 · Dark modifier — inverted colour scheme ───────────────────── */\n/*\n * Uses ink-900 as the canvas (the darkest primitive) so the banner\n * reads as a \"lights out\" takeover (maintenance / outage). All\n * inverted text colours pull from the parchment primitives so the\n * contrast pairs already exist in the system.\n */\n.hbd-full-banner--dark {\n  background: var(--hbd-color-ink-900);\n  color: var(--hbd-color-parchment-50);\n}\n.hbd-full-banner--dark .hbd-full-banner__heading {\n  color: var(--hbd-color-parchment-50);\n}\n.hbd-full-banner--dark .hbd-full-banner__description,\n.hbd-full-banner--dark .hbd-full-banner__meta {\n  color: var(--hbd-color-parchment-200);\n}\n.hbd-full-banner--dark .hbd-full-banner__illustration {\n  color: var(--hbd-color-parchment-300);\n}\n\n/* Per-variant eyebrow colours in dark mode — fall back to a brighter\n   accent from the same hue family so they still read against ink-900. */\n.hbd-full-banner--dark.hbd-full-banner--maintenance .hbd-full-banner__eyebrow {\n  color: var(--hbd-color-gold-300);\n}\n.hbd-full-banner--dark.hbd-full-banner--restricted .hbd-full-banner__eyebrow {\n  color: var(--hbd-color-crimson-300);\n}\n.hbd-full-banner--dark.hbd-full-banner--launch .hbd-full-banner__eyebrow {\n  color: var(--hbd-color-gold-300);\n}\n.hbd-full-banner--dark.hbd-full-banner--offline .hbd-full-banner__eyebrow {\n  color: var(--hbd-color-parchment-300);\n}\n\n/* ── 10 · Semantic variants — error / success (Phase 5) ──────────── */\n/*\n * Applied by the React component when the template key starts with\n * \"error-\" or \"success-\" (e.g. error-404, success-completed). The\n * eyebrow + illustration tint to the matching status hue; the heading\n * + description stay neutral so contrast is preserved and the meaning\n * is carried in TEXT (SC 1.4.1, SC 3.3.1).\n *\n * Token note: spec asked for --hbd-color-status-error-text /\n * --hbd-color-status-success-text. Those resolve to parchment-50\n * (near-white) — designed for placement on saturated surfaces, not\n * on the parchment page background. Using them here would render\n * the eyebrow / icon invisible. We use the matching -border tokens\n * (crimson-600 / forest-600) which sit on parchment with adequate\n * contrast.\n */\n.hbd-full-banner--error .hbd-full-banner__eyebrow {\n  color: var(--hbd-color-status-error-border);\n}\n.hbd-full-banner--error .hbd-full-banner__illustration {\n  color: var(--hbd-color-status-error-border);\n  /* 0.7 opacity matches the base illustration treatment — decorative,\n     SC 1.4.3-exempt because the heading carries the meaning. */\n  opacity: 0.7;\n}\n\n.hbd-full-banner--success .hbd-full-banner__eyebrow {\n  color: var(--hbd-color-status-success-border);\n}\n.hbd-full-banner--success .hbd-full-banner__illustration {\n  color: var(--hbd-color-status-success-border);\n  opacity: 0.7;\n}\n\n/* Dark-mode overrides for the semantic variants — brighter accent from\n   the same hue so the eyebrow / icon read against ink-900. The\n   illustration tints to the brighter shade because deep crimson /\n   forest on near-black ink would fall below 3:1. */\n.hbd-full-banner--dark.hbd-full-banner--error .hbd-full-banner__eyebrow,\n.hbd-full-banner--dark.hbd-full-banner--error .hbd-full-banner__illustration {\n  color: var(--hbd-color-crimson-300);\n}\n.hbd-full-banner--dark.hbd-full-banner--success .hbd-full-banner__eyebrow,\n.hbd-full-banner--dark.hbd-full-banner--success .hbd-full-banner__illustration {\n  color: var(--hbd-color-forest-300);\n}\n\n/* ──────── input.css ──────── */\n/*\n * Here Be Dragons DS — input.css\n * Ported for React / light-DOM from ds/styles/components/input.css\n * (+ the shared field helpers from ds/styles/components/form-validation.css).\n *\n * This file OWNS the shared field chrome — .hbd-field and its\n * __label / __input / __hint / __error / __success / __char-count /\n * prefix / suffix / toggle structure — plus the shared validation helpers\n * (validation icons, field-level warning, error summary, validate-on-blur).\n * Later form fields (textarea, otp-input, select trigger, stepper, combobox,\n * radio, switch, slider) depend on @hbd/input and reuse this scaffolding,\n * so the shared selectors keep the .hbd-field__textarea / __select-trigger\n * surface targets even though those controls ship in their own components.\n *\n * No Shadow DOM here: the legacy element used Shadow DOM but had no :host /\n * ::slotted / ::part rules — every selector is a plain class — so the port is\n * effectively verbatim. Every value still references a --hbd-* token\n * (defined in globals.css). No absolute /paths.\n */\n\n/* ── 2a · Field wrapper ─────────────────────────────────────────────── */\n.hbd-field {\n  display: flex;\n  flex-direction: column;\n  gap: var(--hbd-space-1);\n  width: 100%;\n  font-family: var(--hbd-font-family-ui);\n}\n\n/* ── 2b · Label (shared with .hbd-slider-field) ─────────────────────── */\n.hbd-field__label,\n.hbd-slider-field__label {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  font-weight: var(--hbd-font-weight-medium);\n  color: var(--hbd-color-text-primary);\n  cursor: pointer;\n}\n.hbd-field__label-required {\n  color: var(--hbd-color-text-emphasis);\n  margin-left: var(--hbd-space-1);\n}\n\n/* ── 2c · Input wrapper + prefix/suffix ─────────────────────────────── */\n.hbd-field__input-wrapper {\n  position: relative;\n  display: flex;\n  align-items: center;\n}\n.hbd-field__prefix,\n.hbd-field__suffix {\n  position: absolute;\n  top: 50%;\n  transform: translateY(-50%);\n  display: inline-flex;\n  align-items: center;\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-input-font-size);\n  color: var(--hbd-color-text-muted);\n  pointer-events: none;\n}\n.hbd-field__prefix { left: var(--hbd-input-padding-x); }\n.hbd-field__suffix { right: var(--hbd-input-padding-x); }\n\n.hbd-field--with-prefix .hbd-field__input {\n  padding-left: calc(var(--hbd-input-padding-x) + var(--hbd-space-6));\n}\n.hbd-field--with-suffix .hbd-field__input {\n  padding-right: calc(var(--hbd-input-padding-x) + var(--hbd-space-6));\n}\n\n/* ── 2d · Native input + textarea + select trigger (shared field surface) */\n/* Shared across .hbd-field__input, .hbd-field__textarea, and the custom\n   .hbd-field__select-trigger. Per-control overrides (textarea resize,\n   select-trigger flex layout) live in their own component CSS. */\n.hbd-field__input,\n.hbd-field__textarea,\n.hbd-field__select-trigger {\n  width: 100%;\n  min-height: var(--hbd-input-min-height);\n  padding: var(--hbd-input-padding-y) var(--hbd-input-padding-x);\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-input-font-size);\n  color: var(--hbd-color-text-primary);\n  background: var(--hbd-color-surface-default);\n  /* border-strong (ink-700, ~11:1 on parchment) meets SC 1.4.11 (≥3:1) */\n  border: var(--hbd-input-border-width) solid var(--hbd-color-border-strong);\n  border-radius: var(--hbd-input-border-radius);\n  outline: none;\n  appearance: none;\n  -webkit-appearance: none;\n  transition: border-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              box-shadow var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-field__input::placeholder,\n.hbd-field__textarea::placeholder {\n  color: var(--hbd-color-text-muted);\n  opacity: 1;\n}\n.hbd-field__input:hover,\n.hbd-field__textarea:hover,\n.hbd-field__select-trigger:hover {\n  border-color: var(--hbd-color-border-strong);\n}\n.hbd-field__input:focus-visible,\n.hbd-field__textarea:focus-visible,\n.hbd-field__select-trigger:focus-visible {\n  border-color: var(--hbd-color-input-focus-border);\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n/* ── 2e · Size modifiers ────────────────────────────────────────────── */\n.hbd-field--sm .hbd-field__input,\n.hbd-field--sm .hbd-field__textarea,\n.hbd-field--sm .hbd-field__select-trigger {\n  min-height: var(--hbd-space-8);\n  font-size: var(--hbd-font-size-label);\n  padding: var(--hbd-space-1) var(--hbd-space-2);\n}\n.hbd-field--lg .hbd-field__input,\n.hbd-field--lg .hbd-field__textarea,\n.hbd-field--lg .hbd-field__select-trigger {\n  min-height: calc(var(--hbd-input-min-height) + var(--hbd-space-2));\n  font-size: var(--hbd-font-size-body);\n  padding: var(--hbd-space-3) var(--hbd-space-4);\n}\n\n/* ── 2f · Validation / interaction states ───────────────────────────── */\n\n/* Error */\n.hbd-field--error .hbd-field__input,\n.hbd-field--error .hbd-field__textarea,\n.hbd-field--error .hbd-field__select-trigger {\n  border-color: var(--hbd-color-status-error-border);\n  /* text-emphasis (blood, ~12.8:1 on parchment) — AA-compliant error tint */\n  color: var(--hbd-color-text-emphasis);\n}\n/* Label text matches the error message colour for visual consistency. */\n.hbd-field--error .hbd-field__label {\n  color: var(--hbd-color-text-emphasis);\n}\n.hbd-field--error .hbd-field__input:focus-visible,\n.hbd-field--error .hbd-field__textarea:focus-visible,\n.hbd-field--error .hbd-field__select-trigger:focus-visible {\n  border-color: var(--hbd-color-status-error-border);\n  outline-color: var(--hbd-color-status-error-border);\n}\n.hbd-field--error .hbd-field__error { display: block; }\n.hbd-field--error .hbd-field__hint  { display: none; }\n\n/* Success */\n.hbd-field--success .hbd-field__input,\n.hbd-field--success .hbd-field__textarea,\n.hbd-field--success .hbd-field__select-trigger {\n  border-color: var(--hbd-color-status-success-border);\n  /* forest-700 (~5.5:1 on parchment) — AA-compliant dark green */\n  color: var(--hbd-color-forest-700);\n}\n.hbd-field--success .hbd-field__input:focus-visible,\n.hbd-field--success .hbd-field__textarea:focus-visible,\n.hbd-field--success .hbd-field__select-trigger:focus-visible {\n  border-color: var(--hbd-color-status-success-border);\n  outline-color: var(--hbd-color-status-success-border);\n}\n.hbd-field--success .hbd-field__success { display: block; }\n.hbd-field--success .hbd-field__hint    { display: none; }\n\n/* Disabled */\n.hbd-field--disabled .hbd-field__input,\n.hbd-field--disabled .hbd-field__textarea,\n.hbd-field--disabled .hbd-field__select-trigger {\n  background: var(--hbd-color-surface-subtle);\n  color: var(--hbd-color-text-disabled);\n  border-color: var(--hbd-color-border-subtle);\n  cursor: not-allowed;\n}\n.hbd-field--disabled .hbd-field__label {\n  color: var(--hbd-color-text-disabled);\n  cursor: not-allowed;\n}\n.hbd-field--disabled .hbd-field__input:hover,\n.hbd-field--disabled .hbd-field__textarea:hover,\n.hbd-field--disabled .hbd-field__select-trigger:hover {\n  border-color: var(--hbd-color-border-subtle);\n}\n\n/* Readonly — muted surface, default cursor; border/label unchanged */\n.hbd-field--readonly .hbd-field__input,\n.hbd-field--readonly .hbd-field__textarea {\n  background: var(--hbd-color-surface-subtle);\n  cursor: default;\n}\n.hbd-field--readonly .hbd-field__input:hover,\n.hbd-field--readonly .hbd-field__textarea:hover {\n  border-color: var(--hbd-color-border-strong);\n}\n\n/* ── 2g · Messages (hint / error / success / char-count) ────────────── */\n.hbd-field__hint,\n.hbd-field__error,\n.hbd-field__success,\n.hbd-field__char-count {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  line-height: var(--hbd-line-height-body);\n}\n.hbd-field__hint {\n  color: var(--hbd-color-text-muted);\n  display: block;\n}\n.hbd-field__error {\n  /* text-emphasis (blood, ~12.8:1 on parchment) — AA-compliant dark red */\n  color: var(--hbd-color-text-emphasis);\n  display: none;\n}\n.hbd-field__success {\n  /* forest-700 primitive: no dark-green semantic exists; readable on parchment */\n  color: var(--hbd-color-forest-700);\n  display: none;\n}\n.hbd-field__char-count {\n  color: var(--hbd-color-text-muted);\n  text-align: right;\n  margin-left: auto;\n}\n.hbd-field__char-count.is-at-limit {\n  color: var(--hbd-color-text-emphasis);\n  font-weight: var(--hbd-font-weight-bold);\n}\n\n/* ── Password show/hide toggle (suffix slot) ────────────────────────── */\n.hbd-field__toggle {\n  position: absolute;\n  right: var(--hbd-input-padding-x);\n  top: 50%;\n  transform: translateY(-50%);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-width: var(--hbd-space-6);\n  min-height: var(--hbd-space-6);\n  padding: 0;\n  background: none;\n  border: none;\n  color: var(--hbd-color-text-muted);\n  cursor: pointer;\n}\n.hbd-field__toggle:hover { color: var(--hbd-color-text-primary); }\n.hbd-field__toggle:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n  border-radius: var(--hbd-radius-sm);\n}\n/* When a password toggle occupies the suffix, reserve trailing room. */\n.hbd-field--with-toggle .hbd-field__input {\n  padding-right: calc(var(--hbd-input-padding-x) + var(--hbd-space-6));\n}\n\n/* ── 2i · Footer row (hint/error/success + char-count) ──────────────── */\n/* Allows the message to sit left and the counter to sit right. */\n.hbd-field__footer {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  gap: var(--hbd-space-2);\n}\n\n/* ── 2j · Character-count warning / over-limit states ───────────────── */\n/* On-page dark colours instead of the near-white status-*-text tokens. */\n.hbd-field__char-count--warning {\n  /* gold-deep (~5.6:1 on parchment) — AA-compliant warning tint */\n  color: var(--hbd-color-gold-deep);\n}\n.hbd-field__char-count--over {\n  /* text-emphasis (blood, ~12.8:1 on parchment) — AA-compliant over-limit tint */\n  color: var(--hbd-color-text-emphasis);\n  font-weight: var(--hbd-font-weight-medium);\n}\n\n/* ───────────────────────────────────────────────────────────────────── */\n/* Shared validation helpers (ported from form-validation.css). Every form\n   field that depends on @hbd/input participates in these cross-cutting\n   visual states. */\n\n/* ── Validation icons ──────────────────────────────────────────────── */\n/* Hidden by default; shown only when the matching field-level modifier\n   is active. SVG sizes match --hbd-space-4 for visual parity. */\n.hbd-field__validation-icon {\n  flex-shrink: 0;\n  width: var(--hbd-space-4);\n  height: var(--hbd-space-4);\n  display: none;\n}\n.hbd-field--error .hbd-field__validation-icon--error {\n  display: inline-block;\n  color: var(--hbd-color-text-emphasis);\n}\n.hbd-field--success .hbd-field__validation-icon--success {\n  display: inline-block;\n  color: var(--hbd-color-status-success-border);\n}\n.hbd-field--warning .hbd-field__validation-icon--warning {\n  display: inline-block;\n  color: var(--hbd-color-gold-deep);\n}\n\n/* ── Field-level warning (UI-only state) ───────────────────────────── */\n/* Warning is a non-blocking advisory; HTML5 validity has no equivalent. */\n.hbd-field__warning {\n  display: none;\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  line-height: var(--hbd-line-height-body);\n  /* gold-deep (~5.6:1 on parchment) — AA-compliant on-page warning text. */\n  color: var(--hbd-color-gold-deep);\n}\n.hbd-field--warning .hbd-field__warning { display: block; }\n.hbd-field--warning .hbd-field__hint    { display: none; }\n\n/* ── Form error summary ────────────────────────────────────────────── */\n/* Sits above a form when multiple fields are in error. Saturated panel,\n   so the on-saturated status-error-text token is the correct pairing. */\n.hbd-form-error-summary {\n  padding: var(--hbd-space-3) var(--hbd-space-4);\n  background: var(--hbd-color-status-error-surface);\n  border: var(--hbd-border-width-thin) solid var(--hbd-color-status-error-border);\n  border-radius: var(--hbd-radius-md);\n  margin-bottom: var(--hbd-space-4);\n  color: var(--hbd-color-status-error-text);\n}\n.hbd-form-error-summary__heading {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-body);\n  font-weight: var(--hbd-font-weight-semibold);\n  color: var(--hbd-color-status-error-text);\n  margin: 0 0 var(--hbd-space-2);\n}\n.hbd-form-error-summary__list {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n  display: flex;\n  flex-direction: column;\n  gap: var(--hbd-space-1);\n}\n.hbd-form-error-summary__item {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  color: var(--hbd-color-status-error-text);\n}\n.hbd-form-error-summary__link {\n  color: var(--hbd-color-status-error-text);\n  text-decoration: underline;\n}\n.hbd-form-error-summary__link:hover {\n  color: var(--hbd-color-status-error-text);\n  text-decoration: none;\n}\n.hbd-form-error-summary__link:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-status-error-text);\n  outline-offset: var(--hbd-focus-offset);\n  border-radius: var(--hbd-radius-sm);\n}\n\n/* ── Validate-on-blur modifier ─────────────────────────────────────── */\n/* Suppresses validation messages until the user has interacted with the\n   field. JS adds .hbd-field--touched on first blur. The !important\n   override is the documented exception: it has to beat the field-level\n   .hbd-field--error display:block above. */\n.hbd-field--validate-on-blur:not(.hbd-field--touched) .hbd-field__error,\n.hbd-field--validate-on-blur:not(.hbd-field--touched) .hbd-field__warning,\n.hbd-field--validate-on-blur:not(.hbd-field--touched) .hbd-field__success {\n  display: none !important;\n}\n.hbd-field--validate-on-blur:not(.hbd-field--touched) .hbd-field__hint {\n  display: block !important;\n}\n\n/* ──────── list.css ──────── */\n/*\n * Here Be Dragons DS\n * list.css (ported from ds/styles/components/list.css)\n *\n * Vertical-stack list with three personas: basic, interactive, rich.\n * Already light-DOM in the source WC — no :host / ::slotted / ::part to\n * de-shadow. Every var(--hbd-*) ref + the prefers-reduced-motion block are\n * carried over verbatim.\n *\n * Naming notes:\n * - Spec referenced --hbd-color-action-default — emitted token is\n *   --hbd-color-surface-action.\n * - Spec referenced --hbd-spacing-N — emitted tokens are --hbd-space-N.\n */\n\n/* ── 1 · List wrapper ─────────────────────────────────────────────── */\n.hbd-list {\n  display: flex;\n  flex-direction: column;\n  width: 100%;\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  font-family: var(--hbd-font-family-ui);\n}\n\n.hbd-list--bordered {\n  border: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n  border-radius: var(--hbd-radius-lg);\n  /* overflow:hidden rounds the corners of the FIRST and LAST item's\n     hover/selected backgrounds. The focus ring uses outline (painted\n     outside the box) WITH a negative offset so it lands INSIDE the\n     border-clip region — avoids being clipped at all. */\n  overflow: hidden;\n}\n\n/* ── 2 · List item ────────────────────────────────────────────────── */\n.hbd-list__item {\n  display: flex;\n  align-items: center;\n  gap: var(--hbd-space-3);\n  padding: var(--hbd-space-3) var(--hbd-space-4);\n  min-height: var(--hbd-list-item-min-height);\n  background: var(--hbd-color-surface-default);\n  color: var(--hbd-color-text-primary);\n  position: relative;\n  box-sizing: border-box;\n}\n\n/* Size modifiers — sm is below the 44px preferred touch target. Use\n   sparingly for dense secondary lists where the gain in density\n   outweighs the cost of a smaller hit target. */\n.hbd-list--sm .hbd-list__item {\n  min-height: var(--hbd-list-item-min-height-sm);\n  padding: var(--hbd-space-2) var(--hbd-space-3);\n}\n.hbd-list--lg .hbd-list__item {\n  min-height: var(--hbd-list-item-min-height-lg);\n  padding: var(--hbd-space-4);\n}\n\n/* Flush — drop the horizontal padding so the list aligns with its\n   container's text edge. Vertical padding stays so item heights\n   remain consistent. */\n.hbd-list--flush .hbd-list__item {\n  padding-left: 0;\n  padding-right: 0;\n}\n\n/* ── 3 · Dividers ─────────────────────────────────────────────────── */\n.hbd-list--divided .hbd-list__item + .hbd-list__item {\n  border-top: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n}\n\n/* Standalone divider — for use BETWEEN groups inside one list. */\n.hbd-list__divider {\n  height: var(--hbd-border-width-hairline);\n  background: var(--hbd-color-border-subtle);\n  margin: var(--hbd-space-1) 0;\n  border: 0;\n  list-style: none;\n}\n\n/* ── 4 · Interactive item ─────────────────────────────────────────── */\n/* Rendered as <a> (when href is set) or <button> by the JS. Both\n   inherit colour + family so the visual identity matches the static\n   <li> path. */\n.hbd-list__item--interactive {\n  cursor: pointer;\n  text-decoration: none;\n  color: inherit;\n  background: var(--hbd-color-surface-default);\n  border: 0;\n  font: inherit;\n  width: 100%;\n  /* When rendered as <button> the native chrome would otherwise add a\n     centre-text default — left-align matches the <a> + <li> paths. */\n  text-align: left;\n  transition: background-color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n\n.hbd-list__item--interactive:hover {\n  background: var(--hbd-color-surface-subtle);\n}\n\n/* Focus ring: outline with a NEGATIVE offset paints INSIDE the item's\n   box, which keeps the ring visible even when the parent list uses\n   overflow:hidden (bordered variant). */\n.hbd-list__item--interactive:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: calc(-1 * var(--hbd-border-width-thin));\n}\n\n/* Selected — background change PLUS a left action-bar indicator so\n   selection is not conveyed by colour alone (SC 1.4.1). The padding\n   compensation keeps the content from jumping when the indicator\n   appears. */\n.hbd-list__item--interactive.is-selected,\n.hbd-list__item--interactive.hbd-list__item--selected {\n  background: var(--hbd-color-surface-subtle);\n  border-left: var(--hbd-border-width-thick) solid var(--hbd-color-surface-action);\n  padding-left: calc(var(--hbd-space-4) - var(--hbd-border-width-thick));\n}\n.hbd-list--sm .hbd-list__item--interactive.is-selected,\n.hbd-list--sm .hbd-list__item--interactive.hbd-list__item--selected {\n  padding-left: calc(var(--hbd-space-3) - var(--hbd-border-width-thick));\n}\n.hbd-list--lg .hbd-list__item--interactive.is-selected,\n.hbd-list--lg .hbd-list__item--interactive.hbd-list__item--selected {\n  padding-left: calc(var(--hbd-space-4) - var(--hbd-border-width-thick));\n}\n.hbd-list--flush .hbd-list__item--interactive.is-selected,\n.hbd-list--flush .hbd-list__item--interactive.hbd-list__item--selected {\n  padding-left: 0;\n}\n\n.hbd-list__item--disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n  pointer-events: none;\n}\n\n/* ── 5 · Leading (avatar / icon / thumbnail) ──────────────────────── */\n.hbd-list__item-leading {\n  flex-shrink: 0;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n}\n\n/* ── 6 · Content column (primary + secondary) ─────────────────────── */\n.hbd-list__item-content {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: var(--hbd-space-1);\n}\n\n.hbd-list__item-primary {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-body);\n  font-weight: var(--hbd-font-weight-medium);\n  color: var(--hbd-color-text-primary);\n  line-height: var(--hbd-line-height-snug);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.hbd-list__item-secondary {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  color: var(--hbd-color-text-muted);\n  line-height: var(--hbd-line-height-snug);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n/* ── 7 · Trailing (badges, actions, timestamps) ───────────────────── */\n.hbd-list__item-trailing {\n  flex-shrink: 0;\n  display: inline-flex;\n  align-items: center;\n  gap: var(--hbd-space-2);\n  margin-left: auto;\n  color: var(--hbd-color-text-muted);\n  font-size: var(--hbd-font-size-label);\n}\n\n/* Action slot — visible on hover OR when any descendant is focused.\n   Opacity (not display:none) is intentional so the button STAYS in\n   the Tab order — a sighted-mouse-only show/hide would surprise\n   keyboard users when Tab landed on an invisible element. */\n.hbd-list__item-action {\n  opacity: 0;\n  transition: opacity var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-list__item:hover .hbd-list__item-action,\n.hbd-list__item:focus-within .hbd-list__item-action {\n  opacity: 1;\n}\n/* Reduced-motion — show actions instantly so the transition doesn't\n   look like a hover delay. */\n@media (prefers-reduced-motion: reduce) {\n  .hbd-list__item-action {\n    transition: none;\n  }\n}\n\n/* ──────── menu.css ──────── */\n/*\n * Here Be Dragons DS — menu.css\n * Ported for React / light-DOM from ds/styles/components/menu.css.\n * Shared menu panel owned by dropdown and reused by context-menu + split-button.\n * De-shadowed: the panel lived in a shadow root anchored to .hbd-dropdown; here\n * the same .hbd-menu / .hbd-menu__* classes render in the light DOM. Positioning\n * is still set inline by JS (top/left/right/bottom) on the .hbd-menu element.\n * Every value still references a --hbd-* token (defined in globals.css).\n * 1:1 with the legacy look.\n */\n\n/* ── 1 · Panel ────────────────────────────────────────────────────── */\n/* Slide-open animation: max-height + opacity + padding, on\n   --hbd-duration-slow with --hbd-ease-out. Mirrors the combobox /\n   select panel from input.css so all dropdown surfaces share one\n   motion. The global prefers-reduced-motion override in\n   foundations/motion.css collapses these to ~0ms automatically.\n   `overflow: hidden` clips the content during the height collapse. */\n.hbd-menu {\n  /* Positioning is set inline by JS via top/left/right/bottom. The menu\n     is `position: absolute` for dropdowns and `position: fixed` for\n     context menus — JS sets the right value. */\n  position: absolute;\n  z-index: var(--hbd-z-dropdown);\n  min-width: var(--hbd-menu-min-width);\n  max-width: var(--hbd-menu-max-width);\n  margin: 0;\n  list-style: none;\n  background: var(--hbd-color-surface-raised);\n  border: var(--hbd-border-width-hairline) solid var(--hbd-color-border-ink-brown);\n  border-radius: var(--hbd-radius-md);\n  box-shadow: var(--hbd-shadow-lg);\n  overflow: hidden;\n  overscroll-behavior: contain;\n  /* Closed state: collapsed to zero height + invisible + no padding. */\n  max-height: 0;\n  padding: 0;\n  opacity: 0;\n  pointer-events: none;\n  transition: max-height var(--hbd-duration-slow) var(--hbd-ease-out),\n              opacity var(--hbd-duration-slow) var(--hbd-ease-out),\n              padding var(--hbd-duration-slow) var(--hbd-ease-out);\n}\n.hbd-menu--open {\n  max-height: var(--hbd-menu-max-height);\n  padding: var(--hbd-space-1) 0;\n  opacity: 1;\n  pointer-events: auto;\n  overflow-y: auto;\n}\n\n/* ── 2 · Menu item ────────────────────────────────────────────────── */\n.hbd-menu__item {\n  display: flex;\n  align-items: center;\n  gap: var(--hbd-space-2);\n  padding: var(--hbd-space-2) var(--hbd-space-3);\n  width: 100%;\n  min-height: var(--hbd-space-8);\n  background: none;\n  border: none;\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-body);\n  color: var(--hbd-color-text-primary);\n  text-align: left;\n  cursor: pointer;\n  transition: background-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-menu__item:hover,\n.hbd-menu__item.is-focused {\n  background: var(--hbd-color-surface-subtle);\n}\n.hbd-menu__item:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: calc(-1 * var(--hbd-border-width-thin));\n}\n\n/* Destructive — on-page error colour (blood) for text + icon, with a\n   subtle blood-tinted hover. color-mix is well-supported in modern\n   browsers; the @supports fallback keeps older engines functional. */\n.hbd-menu__item--destructive {\n  color: var(--hbd-color-text-emphasis);\n}\n.hbd-menu__item--destructive:hover,\n.hbd-menu__item--destructive.is-focused {\n  background: color-mix(in srgb,\n    var(--hbd-color-status-error-surface) 15%,\n    transparent);\n}\n@supports not (background: color-mix(in srgb, red 50%, blue)) {\n  .hbd-menu__item--destructive:hover,\n  .hbd-menu__item--destructive.is-focused {\n    background: var(--hbd-color-surface-subtle);\n  }\n}\n\n/* Disabled — visual + pointer-events block. */\n.hbd-menu__item--disabled,\n.hbd-menu__item[aria-disabled=\"true\"] {\n  color: var(--hbd-color-text-disabled);\n  cursor: not-allowed;\n  pointer-events: none;\n}\n\n/* ── 3 · Item sub-elements ────────────────────────────────────────── */\n.hbd-menu__item-icon {\n  flex-shrink: 0;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--hbd-space-4);\n  height: var(--hbd-space-4);\n  color: var(--hbd-color-text-muted);\n}\n.hbd-menu__item--destructive .hbd-menu__item-icon {\n  color: var(--hbd-color-text-emphasis);\n}\n\n.hbd-menu__item-label {\n  flex: 1;\n  /* Long labels truncate with ellipsis rather than expand the panel\n     past max-width — the title attribute (set in JS) preserves full text. */\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.hbd-menu__item-shortcut {\n  flex-shrink: 0;\n  font-family: var(--hbd-font-family-mono);\n  font-size: var(--hbd-font-size-micro);\n  color: var(--hbd-color-text-muted);\n  letter-spacing: var(--hbd-letter-spacing-normal);\n}\n\n.hbd-menu__item-arrow {\n  flex-shrink: 0;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--hbd-space-3);\n  height: var(--hbd-space-3);\n  color: var(--hbd-color-text-muted);\n}\n\n/* ── 4 · Groups + separator ───────────────────────────────────────── */\n.hbd-menu__group {\n  display: block;\n}\n.hbd-menu__group + .hbd-menu__group {\n  border-top: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n  margin-top: var(--hbd-space-1);\n  padding-top: var(--hbd-space-1);\n}\n.hbd-menu__group-label {\n  display: block;\n  padding: var(--hbd-space-2) var(--hbd-space-3) var(--hbd-space-1);\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-micro);\n  font-weight: var(--hbd-font-weight-semibold);\n  color: var(--hbd-color-text-muted);\n  text-transform: uppercase;\n  letter-spacing: var(--hbd-letter-spacing-label);\n}\n\n.hbd-menu__separator {\n  height: var(--hbd-border-width-hairline);\n  margin: var(--hbd-space-1) 0;\n  background: var(--hbd-color-border-subtle);\n  border: none;\n}\n\n/* ── 5 · Host wrapper (dropdown / context-menu shells) ───────────── */\n/* The dropdown shell has the trigger + the menu. position:relative\n   makes the menu's absolute positioning anchor here. */\n.hbd-dropdown {\n  position: relative;\n  display: inline-block;\n}\n\n/* Context menu shell — the wrapped content area takes the host's\n   layout; the menu is position:fixed in JS so it doesn't need this. */\n.hbd-context-menu {\n  display: contents;\n}\n\n/* ──────── modal.css ──────── */\n/*\n * Here Be Dragons DS\n * styles/components/modal.css\n *\n * De-shadowed from ds/styles/components/modal.css. The legacy WC was a\n * Shadow-DOM custom element with adopted stylesheets; this React port\n * hand-ports the same backdrop / container / dialog structure into a\n * portalled Light-DOM tree, so :host becomes .hbd-modal and the ::slotted\n * body/footer become plain descendants. EVERY token-backed visual rule\n * and the is-open / is-closing opacity+transform transition lifecycle is\n * carried over verbatim — the React layer keeps .is-closing applied until\n * the dialog's opacity transitionend fires, exactly like the WC.\n *\n * Modal / dialog — overlays the page with a focused task. Unlike a\n * drawer it is centred on the screen, sized in absolute units, and\n * blocks interaction with the page behind via the backdrop.\n *\n * Three size variants (--sm / default / --lg / --full) and two\n * semantic sub-types (--alert for alertdialog). The JS layer drives\n * the role/aria-modal/labelling; the CSS is type-agnostic.\n *\n * Naming notes:\n * - Spec referenced --hbd-spacing-N — emitted tokens are --hbd-space-N.\n * - The backdrop scrim uses rgba(ink-900, 0.7). A semi-transparent\n *   scrim can't be expressed as a single --hbd-color-* token; this\n *   is the documented inline-rgba exception, same pattern as drawer.\n *   Drawer uses 0.6; modal is heavier-blocking and uses 0.7 because\n *   it must prevent the user from interpreting the page behind as\n *   interactive at all.\n *\n * Reduced motion: the global @media override in foundations/motion.css\n * collapses these transitions to 0.01ms.\n */\n\n/* ── 1 · Wrapper ──────────────────────────────────────────────────── */\n/* display:contents while closed so the wrapper occupies no layout\n   space; backdrop + container become a fixed overlay when .is-open\n   is applied. Same pattern as hbd-drawer. */\n.hbd-modal {\n  display: contents;\n}\n\n/* ── 2 · Backdrop ─────────────────────────────────────────────────── */\n.hbd-modal__backdrop {\n  position: fixed;\n  inset: 0;\n  z-index: var(--hbd-z-overlay);\n  background: rgba(26, 20, 16, 0.7);\n  opacity: 0;\n  pointer-events: none;\n  transition: opacity var(--hbd-duration-normal) var(--hbd-ease-out);\n}\n.hbd-modal.is-open .hbd-modal__backdrop {\n  opacity: 1;\n  pointer-events: auto;\n}\n.hbd-modal.is-closing .hbd-modal__backdrop {\n  opacity: 0;\n  /* Keep pointer-events on during exit so a stray click during the\n     animation can't fall through to the page underneath. */\n  pointer-events: auto;\n}\n\n/* ── 3 · Container — centres the dialog ──────────────────────────── */\n.hbd-modal__container {\n  position: fixed;\n  inset: 0;\n  z-index: var(--hbd-z-modal);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: var(--hbd-space-4);\n  pointer-events: none;\n}\n.hbd-modal.is-open .hbd-modal__container {\n  pointer-events: auto;\n}\n\n/* ── 4 · Dialog box ───────────────────────────────────────────────── */\n.hbd-modal__dialog {\n  position: relative;\n  background: var(--hbd-color-surface-default);\n  border-radius: var(--hbd-radius-lg);\n  box-shadow: var(--hbd-shadow-xl);\n  display: flex;\n  flex-direction: column;\n  width: 100%;\n  max-width: var(--hbd-modal-width-md);\n  max-height: var(--hbd-modal-max-height);\n  /*\n   * Intentionally NOT overflow:hidden. Descendant popovers (the\n   * hbd-select dropdown, hbd-popover, hbd-tooltip, etc.) must be\n   * able to paint OUTSIDE the dialog's rounded box; clipping here\n   * would hide them whenever they extend past a dialog edge. The\n   * body owns its own overflow so long content still scrolls\n   * inside the dialog without leaking past it.\n   *\n   * The rounded corners no longer clip the body's edges either, so\n   * the body's own background must be transparent (it inherits the\n   * dialog's surface) and rounded if it sits at a corner — done via\n   * the body radius rules below.\n   */\n  opacity: 0;\n  transform: translateY(var(--hbd-space-4)) scale(0.97);\n  transition: opacity var(--hbd-duration-normal) var(--hbd-ease-out),\n              transform var(--hbd-duration-normal) var(--hbd-ease-out);\n  font-family: var(--hbd-font-family-ui);\n  color: var(--hbd-color-text-primary);\n}\n\n.hbd-modal.is-open