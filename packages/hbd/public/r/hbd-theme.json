text-gold, …) */\n  --color-ink-950: var(--hbd-color-ink-950);\n  --color-ink-900: var(--hbd-color-ink-900);\n  --color-ink-800: var(--hbd-color-ink-800);\n  --color-ink-700: var(--hbd-color-ink-700);\n  --color-ink-600: var(--hbd-color-ink-600);\n  --color-ink-500: var(--hbd-color-ink-500);\n  --color-ink-400: var(--hbd-color-ink-400);\n  --color-ink-300: var(--hbd-color-ink-300);\n  --color-ink-200: var(--hbd-color-ink-200);\n  --color-ink-100: var(--hbd-color-ink-100);\n  --color-ink-50: var(--hbd-color-ink-50);\n  --color-ink-brown: var(--hbd-color-ink-brown);\n  --color-ink-faded: var(--hbd-color-ink-faded);\n  --color-parchment-950: var(--hbd-color-parchment-950);\n  --color-parchment-900: var(--hbd-color-parchment-900);\n  --color-parchment-800: var(--hbd-color-parchment-800);\n  --color-parchment-700: var(--hbd-color-parchment-700);\n  --color-parchment-600: var(--hbd-color-parchment-600);\n  --color-parchment-500: var(--hbd-color-parchment-500);\n  --color-parchment-400: var(--hbd-color-parchment-400);\n  --color-parchment-300: var(--hbd-color-parchment-300);\n  --color-parchment-200: var(--hbd-color-parchment-200);\n  --color-parchment-100: var(--hbd-color-parchment-100);\n  --color-parchment-50: var(--hbd-color-parchment-50);\n  --color-crimson-950: var(--hbd-color-crimson-950);\n  --color-crimson-900: var(--hbd-color-crimson-900);\n  --color-crimson-800: var(--hbd-color-crimson-800);\n  --color-crimson-700: var(--hbd-color-crimson-700);\n  --color-crimson-600: var(--hbd-color-crimson-600);\n  --color-crimson-500: var(--hbd-color-crimson-500);\n  --color-crimson-400: var(--hbd-color-crimson-400);\n  --color-crimson-300: var(--hbd-color-crimson-300);\n  --color-crimson-200: var(--hbd-color-crimson-200);\n  --color-crimson-100: var(--hbd-color-crimson-100);\n  --color-crimson-50: var(--hbd-color-crimson-50);\n  --color-gold-900: var(--hbd-color-gold-900);\n  --color-gold-800: var(--hbd-color-gold-800);\n  --color-gold-700: var(--hbd-color-gold-700);\n  --color-gold-600: var(--hbd-color-gold-600);\n  --color-gold-500: var(--hbd-color-gold-500);\n  --color-gold-400: var(--hbd-color-gold-400);\n  --color-gold-300: var(--hbd-color-gold-300);\n  --color-gold-200: var(--hbd-color-gold-200);\n  --color-gold-100: var(--hbd-color-gold-100);\n  --color-gold-50: var(--hbd-color-gold-50);\n  --color-gold: var(--hbd-color-gold);\n  --color-gold-bright: var(--hbd-color-gold-bright);\n  --color-gold-deep: var(--hbd-color-gold-deep);\n  --color-forest-900: var(--hbd-color-forest-900);\n  --color-forest-800: var(--hbd-color-forest-800);\n  --color-forest-700: var(--hbd-color-forest-700);\n  --color-forest-600: var(--hbd-color-forest-600);\n  --color-forest-500: var(--hbd-color-forest-500);\n  --color-forest-400: var(--hbd-color-forest-400);\n  --color-forest-300: var(--hbd-color-forest-300);\n  --color-forest-200: var(--hbd-color-forest-200);\n  --color-forest-100: var(--hbd-color-forest-100);\n  --color-forest-50: var(--hbd-color-forest-50);\n  --color-sapphire-900: var(--hbd-color-sapphire-900);\n  --color-sapphire-800: var(--hbd-color-sapphire-800);\n  --color-sapphire-700: var(--hbd-color-sapphire-700);\n  --color-sapphire-600: var(--hbd-color-sapphire-600);\n  --color-sapphire-500: var(--hbd-color-sapphire-500);\n  --color-sapphire-400: var(--hbd-color-sapphire-400);\n  --color-sapphire-300: var(--hbd-color-sapphire-300);\n  --color-sapphire-200: var(--hbd-color-sapphire-200);\n  --color-sapphire-100: var(--hbd-color-sapphire-100);\n  --color-sapphire-50: var(--hbd-color-sapphire-50);\n  --color-sapphire: var(--hbd-color-sapphire);\n  --color-blood: var(--hbd-color-blood);\n  --color-blood-deep: var(--hbd-color-blood-deep);\n  --color-emerald: var(--hbd-color-emerald);\n  --color-emerald-bright: var(--hbd-color-emerald-bright);\n  --color-azure: var(--hbd-color-azure);\n  --color-amethyst: var(--hbd-color-amethyst);\n  --color-rose: var(--hbd-color-rose);\n  --color-umber: var(--hbd-color-umber);\n  --color-nightshade: var(--hbd-color-nightshade);\n  --color-shadow-bg: var(--hbd-color-shadow-bg);\n\n  /* Font families → font-display, font-serif, font-accent, font-ui, font-mono */\n  --font-display: 'Tiamat Condensed SC', 'Cinzel', serif;\n  --font-serif: 'IM Fell English', 'Georgia', serif;\n  --font-accent: 'Cinzel', 'Palatino Linotype', 'Book Antiqua', serif;\n  --font-ui: 'Roboto', 'Helvetica Neue', 'Arial', sans-serif;\n  --font-sans: 'Roboto', 'Helvetica Neue', 'Arial', sans-serif;\n  --font-mono: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'Consolas', monospace;\n\n  /* Font sizes → text-xs … text-7xl plus semantic text-hero/h1/h2/h3/body/… */\n  --text-3xs: 0.5rem;\n  --text-2xs: 0.5625rem;\n  --text-xs: 0.75rem;\n  --text-sm: 0.875rem;\n  --text-md: 1rem;\n  --text-base: 1rem;\n  --text-lg: 1.125rem;\n  --text-xl: 1.25rem;\n  --text-2xl: 1.5rem;\n  --text-3xl: 1.875rem;\n  --text-4xl: 2.25rem;\n  --text-5xl: 3rem;\n  --text-6xl: 3.75rem;\n  --text-7xl: 4.5rem;\n  --text-hero: clamp(3rem, 7vw, 6rem);\n  --text-h1: clamp(2rem, 4.5vw, 2.5rem);\n  --text-h2: clamp(1.375rem, 3vw, 1.75rem);\n  --text-h3: clamp(1.0625rem, 2.2vw, 1.25rem);\n  --text-h4: 1.125rem;\n  --text-body: 1.0625rem;\n  --text-flavor: 0.9375rem;\n  --text-label: 0.8125rem;\n  --text-micro: 0.6875rem;\n\n  /* Font weights → font-light … font-black */\n  --font-weight-light: 300;\n  --font-weight-regular: 400;\n  --font-weight-normal: 400;\n  --font-weight-medium: 500;\n  --font-weight-semibold: 600;\n  --font-weight-bold: 700;\n  --font-weight-black: 900;\n\n  /* Line heights → leading-* */\n  --leading-none: 1;\n  --leading-tight: 1.2;\n  --leading-snug: 1.35;\n  --leading-normal: 1.5;\n  --leading-relaxed: 1.65;\n  --leading-loose: 2;\n  --leading-display: 1.1;\n  --leading-body: 1.7;\n  --leading-flavor: 1.6;\n\n  /* Letter spacing → tracking-* */\n  --tracking-tighter: -0.05em;\n  --tracking-tight: -0.025em;\n  --tracking-normal: 0em;\n  --tracking-wide: 0.025em;\n  --tracking-wider: 0.05em;\n  --tracking-widest: 0.15em;\n  --tracking-display: 0.02em;\n  --tracking-label: 0.3em;\n  --tracking-button: 0.2em;\n  --tracking-eyebrow: 0.25em;\n  --tracking-badge: 0.1em;\n\n  /* Spacing → p-1, gap-4, … (named to match HBD 4px scale) */\n  --spacing-1: 4px;\n  --spacing-2: 8px;\n  --spacing-3: 12px;\n  --spacing-4: 16px;\n  --spacing-6: 24px;\n  --spacing-8: 32px;\n  --spacing-12: 48px;\n  --spacing-16: 64px;\n  --spacing-24: 96px;\n  --spacing-32: 128px;\n\n  /* Radius → rounded-sm … rounded-full (shadcn uses --radius) */\n  --radius-none: 0;\n  --radius-sm: 1px;\n  --radius-md: 2px;\n  --radius-lg: 3px;\n  --radius-xl: 4px;\n  --radius-full: 9999px;\n\n  /* Shadows → shadow-sm … shadow-xl, shadow-inner */\n  --shadow-sm: 0 1px 2px rgba(26, 20, 16, 0.12);\n  --shadow-md: 0 2px 6px rgba(26, 20, 16, 0.16), 0 1px 2px rgba(26, 20, 16, 0.10);\n  --shadow-lg: 0 4px 12px rgba(26, 20, 16, 0.18), 0 2px 4px rgba(26, 20, 16, 0.12);\n  --shadow-xl: 0 8px 24px rgba(26, 20, 16, 0.22), 0 4px 8px rgba(26, 20, 16, 0.14);\n  --shadow-inner: inset 0 1px 3px rgba(26, 20, 16, 0.20);\n\n  /* Durations → duration-fast, … */\n  --duration-instant: 0ms;\n  --duration-fast: 120ms;\n  --duration-normal: 200ms;\n  --duration-slow: 350ms;\n  --duration-slower: 500ms;\n  --duration-spin: 750ms;\n  --duration-pulse: 1500ms;\n  --duration-linger: 5000ms;\n  --duration-linger-lg: 8000ms;\n\n  /* Easing → ease-out, ease-spring, … */\n  --ease-linear: linear;\n  --ease-in: cubic-bezier(0.4, 0, 1, 1);\n  --ease-out: cubic-bezier(0, 0, 0.2, 1);\n  --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);\n  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);\n  --ease-anticipate: cubic-bezier(0.4, -0.3, 0.2, 1.3);\n\n  /* Z-index → z-modal, z-toast, … */\n  --z-index-below: -1;\n  --z-index-base: 0;\n  --z-index-raised: 10;\n  --z-index-dropdown: 100;\n  --z-index-sticky: 200;\n  --z-index-overlay: 300;\n  --z-index-modal: 400;\n  --z-index-popover: 500;\n  --z-index-toast: 600;\n  --z-index-tooltip: 700;\n\n  /* Border widths → border-thin, border-medium, … */\n  --border-width-hairline: 1px;\n  --border-width-thin: 2px;\n  --border-width-medium: 3px;\n  --border-width-thick: 4px;\n\n  /* Layout containers */\n  --container-page: 68.75rem;\n}\n\n@layer base {\n  * { border-color: var(--hbd-color-border-default); }\n  body {\n    background-color: var(--hbd-color-surface-default);\n    color: var(--hbd-color-text-primary);\n    font-family: var(--hbd-font-family-serif);\n    font-size: var(--hbd-font-size-body);\n    line-height: var(--hbd-line-height-body);\n    -webkit-font-smoothing: antialiased;\n  }\n  h1 { font-family: var(--hbd-font-family-accent);  font-size: var(--hbd-font-size-h1); letter-spacing: var(--hbd-letter-spacing-display); line-height: var(--hbd-line-height-display); }\n  h2 { font-family: var(--hbd-font-family-display); font-size: var(--hbd-font-size-h2); font-weight: var(--hbd-font-weight-bold); letter-spacing: var(--hbd-letter-spacing-display); line-height: var(--hbd-line-height-display); }\n  h3 { font-family: var(--hbd-font-family-accent);  font-size: var(--hbd-font-size-h3); letter-spacing: var(--hbd-letter-spacing-display); line-height: var(--hbd-line-height-display); }\n  h4 { font-family: var(--hbd-font-family-accent);  font-size: var(--hbd-font-size-h4); letter-spacing: var(--hbd-letter-spacing-display); line-height: var(--hbd-line-height-display); }\n  code, pre, kbd { font-family: var(--hbd-font-family-mono); }\n  :focus { outline: none; }\n  :focus-visible {\n    outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n    outline-offset: var(--hbd-focus-offset);\n    border-radius: var(--hbd-radius-sm);\n  }\n  .hbd-sr-only {\n    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;\n    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;\n  }\n}\n\n@media (forced-colors: active) {\n  :focus-visible { outline: var(--hbd-border-width-thin) solid ButtonText; outline-offset: var(--hbd-focus-offset); }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n\n/* ════════════════════════════════════════════════════════════════════════════\n * HBD COMPONENT STYLES — 49 de-shadowed stylesheets, folded into\n * the theme so one globals import loads every component's styles (Next-safe).\n * Unlayered, after @layer base, to preserve the original ds/index.css cascade.\n * ════════════════════════════════════════════════════════════════════════════ */\n\n/* ──────── accordion.css ──────── */\n/*\n * Here Be Dragons DS\n * accordion.css — de-shadowed from ds/styles/components/accordion.css.\n *\n * The legacy WC was already Light-DOM (no :host / ::slotted / ::part), so the\n * selectors port verbatim against the .hbd-accordion BEM tree emitted by the\n * React component.\n *\n * Vertically-stacked expand/collapse panels. Two modes (single vs.\n * multi) handled in the component. The expand animation uses a\n * max-height transition so the height change is smooth, layout-correct,\n * and needs zero JS measurement — no scrollHeight read, no layout thrash.\n *\n * Naming notes:\n * - Spec referenced --hbd-duration-deliberate (350ms). The emitted\n *   token --hbd-duration-slow is already 350ms — we use it directly\n *   so the value lives in one place.\n * - Spec referenced --hbd-color-action-default — emitted token is\n *   --hbd-color-surface-action.\n * - Spec referenced --hbd-spacing-N — emitted tokens are --hbd-space-N.\n *\n * Reduced motion: the global override in hbd-theme globals.css collapses\n * transition-duration to 0.01ms when the user has requested reduced\n * motion. No accordion-specific override is required.\n */\n\n/* ── 1 · Wrapper ──────────────────────────────────────────────────── */\n.hbd-accordion {\n  width: 100%;\n  display: flex;\n  flex-direction: column;\n  font-family: var(--hbd-font-family-ui);\n}\n\n.hbd-accordion--bordered {\n  border: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n  border-radius: var(--hbd-radius-md);\n  overflow: hidden;\n}\n\n.hbd-accordion--divided .hbd-accordion__item + .hbd-accordion__item {\n  border-top: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n}\n\n/* ── 2 · Header + trigger ─────────────────────────────────────────── */\n.hbd-accordion__header {\n  padding: 0;\n  margin: 0;\n}\n\n.hbd-accordion__trigger {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  width: 100%;\n  padding: var(--hbd-space-4);\n  background: transparent;\n  border: none;\n  cursor: pointer;\n  text-align: left;\n  gap: var(--hbd-space-3);\n  min-height: var(--hbd-space-12);\n  font: inherit;\n  color: inherit;\n  transition: background-color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n\n.hbd-accordion__trigger:hover {\n  background: var(--hbd-color-surface-subtle);\n}\n\n/* Inset focus ring so it stays visible inside the bordered overflow\n   clip. Negative offset puts the outline inside the trigger's box. */\n.hbd-accordion__trigger:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: calc(-1 * var(--hbd-border-width-thin));\n}\n\n.hbd-accordion__item--open .hbd-accordion__trigger {\n  background: var(--hbd-color-surface-subtle);\n}\n\n.hbd-accordion__item--disabled .hbd-accordion__trigger {\n  cursor: not-allowed;\n  opacity: 0.5;\n  pointer-events: none;\n}\n\n/* ── 3 · Title ────────────────────────────────────────────────────── */\n.hbd-accordion__title {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-body);\n  font-weight: var(--hbd-font-weight-semibold);\n  color: var(--hbd-color-text-primary);\n  line-height: var(--hbd-line-height-snug);\n  flex: 1;\n  min-width: 0;\n}\n\n.hbd-accordion__item--open .hbd-accordion__title {\n  color: var(--hbd-color-text-emphasis);\n}\n\n/* ── 4 · Chevron ──────────────────────────────────────────────────── */\n.hbd-accordion__icon {\n  flex-shrink: 0;\n  width: var(--hbd-space-4);\n  height: var(--hbd-space-4);\n  color: var(--hbd-color-text-muted);\n  transition: transform var(--hbd-duration-fast) var(--hbd-ease-out);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n}\n.hbd-accordion__icon svg {\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n\n.hbd-accordion__item--open .hbd-accordion__icon {\n  transform: rotate(180deg);\n}\n\n/* ── 5 · Panel + body ─────────────────────────────────────────────── */\n/* The panel is the height-animated container: max-height transitions\n   from 0 to a generous ceiling. We use max-height (not grid-rows or\n   height:auto) because it works reliably across every supported\n   browser and animates cleanly on both directions.\n   Trade-off: max-height is a CEILING, not the natural height — the\n   easing curve runs across the full 0→ceiling distance even when the\n   real content height is much smaller. To minimise visible distortion\n   we cap at a content-realistic value (40rem at the default root font\n   size). Authors with\n   taller content can override the per-item ceiling via the\n   --hbd-accordion-panel-max-height custom property.\n   Closed: opacity also fades so very tall panels (rare) don't reveal\n   half-collapsed content while their max-height is still shrinking. */\n.hbd-accordion__panel {\n  max-height: 0;\n  overflow: hidden;\n  opacity: 0;\n  transition: max-height var(--hbd-duration-slow) var(--hbd-ease-out),\n              opacity   var(--hbd-duration-slow) var(--hbd-ease-out);\n}\n\n.hbd-accordion__item--open .hbd-accordion__panel {\n  max-height: var(--hbd-accordion-panel-max-height, 40rem);\n  opacity: 1;\n}\n\n.hbd-accordion__body {\n  padding: 0 var(--hbd-space-4) var(--hbd-space-4);\n  font-family: var(--hbd-font-family-serif);\n  font-size: var(--hbd-font-size-body);\n  color: var(--hbd-color-text-secondary);\n  line-height: var(--hbd-line-height-body);\n}\n\n.hbd-accordion--flush .hbd-accordion__body {\n  padding: 0;\n}\n\n/* ──────── alert.css ──────── */\n/*\n * Here Be Dragons DS\n * registry/new-york/styles/components/alert.css\n * Ported 1:1 from ds/styles/components/alert.css (already Light DOM — no\n * :host / ::slotted / ::part to de-shadow). Every var(--hbd-*) reference is\n * kept verbatim; no absolute /paths. Target: app/components/alert.css.\n *\n * The alert is the generic system-level equivalent of hbd-callout —\n * application feedback (form errors, system notices, API responses).\n * Same visual DNA (left-bar status surface, icon, body, dismiss),\n * different role (no sage-advice variant, adds banner + inline types,\n * adds focus-able action button).\n *\n * Naming notes:\n * - Spec referenced --hbd-color-status-*-bg / --hbd-color-status-*-text;\n *   emitted tokens are --hbd-color-status-*-surface / -text. The\n *   saturated \"-surface\" colour is the canonical \"filled\" status bg.\n * - Spec referenced --hbd-spacing-N — emitted tokens are --hbd-space-N.\n *\n * Reduced motion: dismiss + injection transitions collapse to 0.01ms\n * via the global motion override in foundations/motion.css.\n */\n\n/* ── 1 · Base ─────────────────────────────────────────────────────── */\n.hbd-alert {\n  display: flex;\n  align-items: flex-start;\n  gap: var(--hbd-space-3);\n  padding: var(--hbd-space-3) var(--hbd-space-4);\n  border-radius: var(--hbd-radius-md);\n  border-left: var(--hbd-border-width-thick) solid transparent;\n  position: relative;\n  font-family: var(--hbd-font-family-ui);\n  /*\n   * max-height + overflow:hidden is the open-state ceiling used so\n   * the dismiss transition can animate to 0. Same pattern as\n   * callout.css; --hbd-callout-dismiss-max-height is the shared\n   * ceiling token (no real alert exceeds it).\n   */\n  overflow: hidden;\n  max-height: var(--hbd-callout-dismiss-max-height);\n  transition: opacity var(--hbd-duration-normal) var(--hbd-ease-out),\n              transform var(--hbd-duration-normal) var(--hbd-ease-out),\n              max-height var(--hbd-duration-normal) var(--hbd-ease-out),\n              padding var(--hbd-duration-normal) var(--hbd-ease-out),\n              margin var(--hbd-duration-normal) var(--hbd-ease-out);\n}\n\n/* ── 2 · Variants ─────────────────────────────────────────────────── */\n.hbd-alert--info {\n  background-color: var(--hbd-color-status-info-surface);\n  border-left-color: var(--hbd-color-status-info-border);\n  color: var(--hbd-color-status-info-text);\n}\n.hbd-alert--success {\n  background-color: var(--hbd-color-status-success-surface);\n  border-left-color: var(--hbd-color-status-success-border);\n  color: var(--hbd-color-status-success-text);\n}\n.hbd-alert--warning {\n  background-color: var(--hbd-color-status-warning-surface);\n  border-left-color: var(--hbd-color-status-warning-border);\n  color: var(--hbd-color-status-warning-text);\n}\n.hbd-alert--error {\n  background-color: var(--hbd-color-status-error-surface);\n  border-left-color: var(--hbd-color-status-error-border);\n  color: var(--hbd-color-status-error-text);\n}\n\n/* ── 3 · Icon ─────────────────────────────────────────────────────── */\n.hbd-alert__icon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  width: var(--hbd-space-4);\n  height: var(--hbd-space-4);\n  margin-top: var(--hbd-space-1);\n  color: currentColor;\n}\n.hbd-alert__icon svg {\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n\n/* ── 4 · Body ─────────────────────────────────────────────────────── */\n.hbd-alert__body {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: var(--hbd-space-1);\n}\n\n.hbd-alert__title {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-body);\n  font-weight: var(--hbd-font-weight-semibold);\n  color: inherit;\n  margin: 0;\n  line-height: var(--hbd-line-height-snug);\n}\n\n.hbd-alert__content {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-body);\n  color: inherit;\n  margin: 0;\n  line-height: var(--hbd-line-height-body);\n}\n\n/* ── 5 · Action ───────────────────────────────────────────────────── */\n.hbd-alert__action {\n  margin-top: var(--hbd-space-2);\n  font-weight: var(--hbd-font-weight-semibold);\n  color: inherit;\n  text-decoration: underline;\n  cursor: pointer;\n  background: none;\n  border: none;\n  padding: 0;\n  font-family: inherit;\n  font-size: inherit;\n  align-self: flex-start;\n}\n.hbd-alert__action:hover {\n  text-decoration-thickness: var(--hbd-border-width-thin);\n}\n.hbd-alert__action:focus-visible {\n  outline: var(--hbd-border-width-thin) solid currentColor;\n  outline-offset: var(--hbd-focus-offset);\n}\n\n/* ── 6 · Dismiss button ───────────────────────────────────────────── */\n.hbd-alert__dismiss {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  align-self: flex-start;\n  /*\n   * ≥44px touch target (SC 2.5.8) via min-size; visual glyph stays\n   * small. Negative margin compensates so the bigger hit-box doesn't\n   * inflate the alert's visual height — same trick as callout.\n   */\n  min-width: var(--hbd-space-12);\n  min-height: var(--hbd-space-12);\n  margin: calc(-1 * var(--hbd-space-2)) calc(-1 * var(--hbd-space-2)) calc(-1 * var(--hbd-space-2)) 0;\n  padding: var(--hbd-space-1);\n  background: none;\n  border: none;\n  border-radius: var(--hbd-radius-sm);\n  color: currentColor;\n  opacity: 0.8;\n  cursor: pointer;\n  transition: opacity var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-alert__dismiss:hover {\n  opacity: 1;\n}\n.hbd-alert__dismiss:focus-visible {\n  outline: var(--hbd-border-width-thin) solid currentColor;\n  outline-offset: var(--hbd-focus-offset);\n}\n.hbd-alert__dismiss svg {\n  width: var(--hbd-space-3);\n  height: var(--hbd-space-3);\n  display: block;\n}\n\n/* ── 7 · Dismissed state — collapse height + fade ─────────────────── */\n.hbd-alert.is-dismissed {\n  opacity: 0;\n  transform: translateY(calc(-1 * var(--hbd-space-1)));\n  max-height: 0;\n  margin-top: 0;\n  margin-bottom: 0;\n  padding-top: 0;\n  padding-bottom: 0;\n}\n\n/* ── 8 · Banner — full-width sticky bar ───────────────────────────── */\n.hbd-alert--banner {\n  position: sticky;\n  top: 0;\n  z-index: var(--hbd-z-sticky);\n  border-radius: 0;\n  border-left: none;\n  border-bottom: var(--hbd-border-width-hairline) solid currentColor;\n  padding: var(--hbd-space-2) var(--hbd-layout-container-padding);\n  width: 100%;\n}\n.hbd-alert--banner .hbd-alert__body {\n  flex-direction: row;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: var(--hbd-space-2);\n}\n.hbd-alert--banner .hbd-alert__action {\n  margin-top: 0;\n}\n\n/* ── 9 · Inline — compact, field-adjacent ─────────────────────────── */\n.hbd-alert--inline {\n  border-left-width: var(--hbd-border-width-thin);\n  border-radius: var(--hbd-radius-sm);\n  padding: var(--hbd-space-2) var(--hbd-space-3);\n  gap: var(--hbd-space-2);\n}\n.hbd-alert--inline .hbd-alert__icon {\n  width: var(--hbd-space-3);\n  height: var(--hbd-space-3);\n  margin-top: 0;\n  align-self: center;\n}\n.hbd-alert--inline .hbd-alert__title {\n  font-size: var(--hbd-font-size-label);\n}\n.hbd-alert--inline .hbd-alert__content {\n  font-size: var(--hbd-font-size-label);\n  line-height: var(--hbd-line-height-snug);\n}\n.hbd-alert--inline .hbd-alert__body {\n  flex-direction: row;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: var(--hbd-space-2);\n}\n.hbd-alert--inline .hbd-alert__action {\n  margin-top: 0;\n}\n\n/* ──────── aspect-ratio.css ──────── */\n/*\n * Here Be Dragons DS\n * styles/components/aspect-ratio.css\n *\n * Constrains a single child to a fixed aspect ratio. Uses the\n * native `aspect-ratio` CSS property instead of the legacy\n * padding-top hack — supported in Chrome 88+, Firefox 89+, Safari\n * 15+ (the same minimum baseline the rest of the DS already\n * targets via Constructable Stylesheets in shared-styles.js).\n *\n * The ratio is driven by an internal custom property --_hbd-ar\n * (leading underscore marks it as instance-private, never to be\n * tokenised — it's a per-instance computed value, not a design\n * decision). The component writes it inline via the style prop.\n *\n * Direct children fill the box and crop with object-fit:cover so\n * <img>, <video>, <iframe>, <canvas> all \"do the right thing\".\n * The > * selector applies regardless of element type — authors\n * are responsible for the slotted element's own accessible name\n * (alt for img, aria-label for iframe/canvas, etc.).\n */\n\n.hbd-aspect-ratio {\n  position: relative;\n  width: 100%;\n  overflow: hidden;\n  /* Default fallback ratio so a forgotten attribute still renders\n     something sensible. The component overrides this inline. */\n  aspect-ratio: var(--_hbd-ar, 16 / 9);\n}\n\n.hbd-aspect-ratio > * {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n/* ──────── avatar-group.css ──────── */\n/*\n * Here Be Dragons DS\n * styles/components/avatar-group.css\n *\n * Extracted from ds/styles/components/avatar.css (.hbd-avatar-group* rules).\n * Composes <hbd-avatar> children into an overlapping stack with a \"+N\"\n * overflow bubble. The base .hbd-avatar / .hbd-avatar--{size} styling is\n * provided by the @hbd/avatar registry dependency (avatar.css); this file\n * ships ONLY the group-specific rules. The overflow bubble reuses the\n * .hbd-avatar + .hbd-avatar--{size} base classes for parity with siblings.\n *\n * Naming notes:\n * - Spec referenced --hbd-spacing-N — emitted tokens are --hbd-space-N.\n */\n\n/* ── Avatar group ─────────────────────────────────────────────────── */\n/* row-reverse + negative left margin produces a \"stack\" where the\n   FIRST authored avatar visually sits on the LEFT, layered on top of\n   the next one. The flex-direction handles the z-order naturally —\n   later children paint underneath earlier children. */\n.hbd-avatar-group {\n  display: inline-flex;\n  flex-direction: row-reverse;\n}\n\n.hbd-avatar-group > .hbd-avatar,\n.hbd-avatar-group > .hbd-avatar-group__overflow {\n  margin-left: calc(-1 * var(--hbd-space-2));\n}\n.hbd-avatar-group > .hbd-avatar:last-child,\n.hbd-avatar-group > .hbd-avatar-group__overflow:last-child {\n  margin-left: 0;\n}\n\n/* Overflow bubble — same size + shape as an avatar, neutral fill,\n   carries \"+N\" text. Inherits all .hbd-avatar base + size styles via\n   the dual class names the markup writes. */\n.hbd-avatar-group__overflow {\n  background: var(--hbd-color-surface-subtle);\n  color: var(--hbd-color-text-secondary);\n  font-family: var(--hbd-font-family-ui);\n  font-weight: var(--hbd-font-weight-semibold);\n  font-size: var(--hbd-font-size-label);\n  letter-spacing: var(--hbd-letter-spacing-normal);\n  user-select: none;\n}\n\n/* ──────── avatar.css ──────── */\n/*\n * Here Be Dragons DS — avatar.css\n * Ported for React / light-DOM from ds/styles/components/avatar.css.\n * The legacy stylesheet was already light-DOM friendly (no :host / ::slotted /\n * ::part), so this is a verbatim de-shadow: the host carries .hbd-avatar* and\n * the inner content is .hbd-avatar__img / .hbd-avatar__icon. Every value still\n * references a --hbd-* token (defined in globals.css). 1:1 with the legacy look.\n *\n * Naming notes:\n * - Spec referenced --hbd-spacing-N — emitted tokens are --hbd-space-N.\n * - avatar-group rules are retained here because the legacy stylesheet shipped\n *   them in this file; the overflow bubble reuses the .hbd-avatar base + size.\n */\n\n/* ── 1 · Base ─────────────────────────────────────────────────────── */\n.hbd-avatar {\n  display: inline-flex;\n  /* Always centre the inner content (image or icon) on both axes,\n     regardless of which branch picks. */\n  align-items: center;\n  justify-content: center;\n  border-radius: var(--hbd-radius-full);\n  /* overflow:hidden clips the image inside the round mask. */\n  overflow: hidden;\n  background: var(--hbd-color-surface-subtle);\n  color: var(--hbd-color-text-muted);\n  flex-shrink: 0;\n  position: relative;\n  /* surface-default border = a thin \"page-coloured\" ring around every\n     avatar. Decorative — provides separation when avatars overlap in\n     a group; NOT load-bearing for contrast. */\n  border: var(--hbd-border-width-thin) solid var(--hbd-color-surface-default);\n  vertical-align: middle;\n  /* Avatars are non-interactive by default. If an author wraps one in\n     a <button> or <a>, the touch-target size is the author's\n     responsibility — the avatar itself only carries visual chrome. */\n}\n\n/* ── 2 · Sizes ────────────────────────────────────────────────────── */\n.hbd-avatar--xs  { width: var(--hbd-avatar-size-xs);  height: var(--hbd-avatar-size-xs);  }\n.hbd-avatar--sm  { width: var(--hbd-avatar-size-sm);  height: var(--hbd-avatar-size-sm);  }\n.hbd-avatar--md  { width: var(--hbd-avatar-size-md);  height: var(--hbd-avatar-size-md);  }\n.hbd-avatar--lg  { width: var(--hbd-avatar-size-lg);  height: var(--hbd-avatar-size-lg);  }\n.hbd-avatar--xl  { width: var(--hbd-avatar-size-xl);  height: var(--hbd-avatar-size-xl);  }\n.hbd-avatar--2xl { width: var(--hbd-avatar-size-2xl); height: var(--hbd-avatar-size-2xl); }\n\n/* ── 3 · Image ────────────────────────────────────────────────────── */\n.hbd-avatar__img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  /* object-position:center keeps subject-of-interest in the middle of\n     the round mask when the source aspect ratio differs from 1:1. */\n  object-position: center;\n  display: block;\n}\n\n/* ── 4 · Generic icon ─────────────────────────────────────────────── */\n/* Sized to 55% of the host so the figure breathes inside the circle.\n   Centring is handled by the host's flex layout — the icon wrapper\n   doesn't need its own positioning. */\n.hbd-avatar__icon {\n  width: 55%;\n  height: 55%;\n  color: var(--hbd-color-text-muted);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n.hbd-avatar__icon svg {\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n\n/* ── 5 · Avatar group ─────────────────────────────────────────────── */\n/* row-reverse + negative left margin produces a \"stack\" where the\n   FIRST authored avatar visually sits on the LEFT, layered on top of\n   the next one. The flex-direction handles the z-order naturally —\n   later children paint underneath earlier children. */\n.hbd-avatar-group {\n  display: inline-flex;\n  flex-direction: row-reverse;\n}\n\n.hbd-avatar-group > .hbd-avatar,\n.hbd-avatar-group > .hbd-avatar-group__overflow {\n  margin-left: calc(-1 * var(--hbd-space-2));\n}\n.hbd-avatar-group > .hbd-avatar:last-child,\n.hbd-avatar-group > .hbd-avatar-group__overflow:last-child {\n  margin-left: 0;\n}\n\n/* Overflow bubble — same size + shape as an avatar, neutral fill,\n   carries \"+N\" text. Inherits all .hbd-avatar base + size styles via\n   the dual class names. */\n.hbd-avatar-group__overflow {\n  background: var(--hbd-color-surface-subtle);\n  color: var(--hbd-color-text-secondary);\n  font-family: var(--hbd-font-family-ui);\n  font-weight: var(--hbd-font-weight-semibold);\n  font-size: var(--hbd-font-size-label);\n  letter-spacing: var(--hbd-letter-spacing-normal);\n  user-select: none;\n}\n\n/* ──────── badge.css ──────── */\n/*\n * Here Be Dragons DS — badge.css\n * Ported for React / light-DOM from the Badge section of\n * ds/styles/components/badge.css. The legacy file co-located Badge + Chip;\n * this file ships only the Badge primitive (Chip lives in chip.css).\n *\n * Already light-DOM in the source — no :host/::slotted/::part to de-shadow.\n * Every value still references a --hbd-* token (defined in globals.css).\n * 1:1 with the legacy look.\n */\n\n/* ── Base ───────────────────────────────────────────────────────────── */\n/* Use a badge to indicate a count or a status dot. Positioning is the\n   author's responsibility — when overlaying another element, give that\n   element position:relative and absolutely-position the badge. */\n.hbd-badge {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-width: var(--hbd-badge-min-width);\n  height: var(--hbd-badge-size);\n  padding: 0 var(--hbd-space-1);\n  border-radius: var(--hbd-radius-full);\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-micro);\n  font-weight: var(--hbd-font-weight-semibold);\n  line-height: 1;\n  letter-spacing: var(--hbd-letter-spacing-normal);\n  white-space: nowrap;\n  overflow: hidden;\n  /* Default = neutral fill, used when no colour modifier is set. */\n  background: var(--hbd-color-surface-subtle);\n  color: var(--hbd-color-text-primary);\n  border: var(--hbd-border-width-hairline) solid transparent;\n  vertical-align: middle;\n}\n\n/* ── Colour variants ────────────────────────────────────────────────── */\n.hbd-badge--primary {\n  background: var(--hbd-color-surface-action);\n  color: var(--hbd-color-text-on-action);\n}\n.hbd-badge--success {\n  background: var(--hbd-color-status-success-surface);\n  color: var(--hbd-color-status-success-text);\n}\n.hbd-badge--warning {\n  background: var(--hbd-color-status-warning-surface);\n  color: var(--hbd-color-status-warning-text);\n}\n.hbd-badge--error {\n  background: var(--hbd-color-status-error-surface);\n  color: var(--hbd-color-status-error-text);\n}\n.hbd-badge--neutral {\n  background: var(--hbd-color-surface-subtle);\n  color: var(--hbd-color-text-primary);\n  border-color: var(--hbd-color-border-strong);\n}\n\n/* ── Dot variant ────────────────────────────────────────────────────── */\n/* No text, no padding, no min-width; just a coloured circle. A colour\n   modifier (--primary, --success…) still applies for the fill. */\n.hbd-badge--dot {\n  width: var(--hbd-badge-dot-size);\n  height: var(--hbd-badge-dot-size);\n  min-width: auto;\n  padding: 0;\n  font-size: 0;\n}\n\n/* ──────── breadcrumbs.css ──────── */\n/*\n * Here Be Dragons DS — breadcrumbs.css\n * De-shadowed from ds/styles/components/breadcrumbs.css.\n *\n * WAI-ARIA 1.2 breadcrumb trail. Every value references a --hbd-* token.\n * Already Light DOM in the source (no :host / ::slotted / ::part), so the\n * selectors are carried verbatim.\n *\n * Separator is a real \"›\" <span> marked aria-hidden=\"true\": the trail order is\n * conveyed solely by the <ol> structure, so the glyph is decorative only.\n */\n\n/* ── Base ───────────────────────────────────────────────────────────── */\n.hbd-breadcrumbs {\n  display: block;\n}\n\n.hbd-breadcrumbs__list {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: var(--hbd-space-1);\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n\n.hbd-breadcrumbs__item {\n  display: flex;\n  align-items: center;\n  gap: var(--hbd-space-1);\n}\n\n/* ── Link ───────────────────────────────────────────────────────────── */\n.hbd-breadcrumbs__link {\n  color: var(--hbd-color-text-secondary);\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-font-size-label);\n  letter-spacing: var(--hbd-letter-spacing-wider);\n  text-decoration: none;\n  white-space: nowrap;\n  border-bottom: var(--hbd-border-width-hairline) solid transparent;\n  transition: color var(--hbd-duration-fast) var(--hbd-ease-out),\n              border-bottom-color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n\n.hbd-breadcrumbs__link:hover {\n  color: var(--hbd-color-text-primary);\n  border-bottom-color: var(--hbd-color-text-primary);\n}\n\n.hbd-breadcrumbs__link:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n  border-bottom-color: transparent;\n}\n\n/* ── Current item (last; not a link) ────────────────────────────────── */\n.hbd-breadcrumbs__current {\n  color: var(--hbd-color-text-primary);\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-font-size-label);\n  letter-spacing: var(--hbd-letter-spacing-wider);\n  white-space: nowrap;\n  cursor: default;\n}\n\n/* ── Separator (decorative) ─────────────────────────────────────────── */\n.hbd-breadcrumbs__separator {\n  color: var(--hbd-color-text-muted);\n  font-size: var(--hbd-font-size-xs);\n  padding: 0 var(--hbd-space-1);\n  line-height: 1;\n  user-select: none;\n}\n\n/* ── Truncated / ellipsis ───────────────────────────────────────────── */\n.hbd-breadcrumbs__ellipsis {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  /* ≥24px touch target (SC 2.5.8) via padding, not a fixed size */\n  min-width: var(--hbd-space-6);\n  min-height: var(--hbd-space-6);\n  color: var(--hbd-color-text-secondary);\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-font-size-label);\n  letter-spacing: var(--hbd-letter-spacing-wider);\n  background: none;\n  border: none;\n  padding: 0 var(--hbd-space-1);\n  cursor: pointer;\n  transition: color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n\n.hbd-breadcrumbs__ellipsis:hover {\n  color: var(--hbd-color-text-primary);\n}\n\n.hbd-breadcrumbs__ellipsis:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n.hbd-breadcrumbs__item--hidden {\n  display: none;\n}\n\n.hbd-breadcrumbs--expanded .hbd-breadcrumbs__item--hidden {\n  display: flex;\n}\n\n/* ──────── button.css ──────── */\n/*\n * Here Be Dragons DS — button.css\n * Ported for React / light-DOM from ds/styles/components/button.css.\n * De-shadowed: ::slotted(x) -> descendant selectors; `> slot` -> `> :not(.hbd-button__spinner)`.\n * Toggle-group and split-button rules live in their own component CSS (toggle-group / split-button).\n * Every value still references a --hbd-* token (defined in globals.css). 1:1 with the legacy look.\n */\n\n/* ── Base ───────────────────────────────────────────────────────────── */\n.hbd-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--hbd-space-2);\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-font-size-label);\n  font-weight: var(--hbd-font-weight-bold);\n  letter-spacing: var(--hbd-letter-spacing-button);\n  text-transform: uppercase;\n  text-decoration: none;\n  cursor: pointer;\n  border-width: var(--hbd-border-width-thin);\n  border-style: solid;\n  border-radius: var(--hbd-radius-sm);\n  /* md is the default size — padding sized so total height ≥ 44px (SC 2.5.8) */\n  padding: var(--hbd-space-3) var(--hbd-space-6);\n  transition: background-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              border-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              box-shadow var(--hbd-duration-fast) var(--hbd-ease-out),\n              color var(--hbd-duration-fast) var(--hbd-ease-out),\n              transform var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n\n/* ── Size modifiers ─────────────────────────────────────────────────── */\n.hbd-button--sm {\n  padding: var(--hbd-space-2) var(--hbd-space-4);\n  font-size: var(--hbd-font-size-label);\n}\n.hbd-button--md {\n  padding: var(--hbd-space-3) var(--hbd-space-6);\n  font-size: var(--hbd-font-size-label);\n}\n.hbd-button--lg {\n  padding: var(--hbd-space-4) var(--hbd-space-8);\n  font-size: var(--hbd-font-size-body);\n}\n\n/* ── Variant: default ───────────────────────────────────────────────── */\n.hbd-button--default {\n  background: var(--hbd-color-surface-raised);\n  color: var(--hbd-color-text-primary);\n  border-color: var(--hbd-color-ink-900);\n  box-shadow: var(--hbd-button-shadow);\n}\n.hbd-button--default:hover {\n  background: var(--hbd-color-parchment-300);\n}\n.hbd-button--default:active {\n  transform: translate(var(--hbd-focus-offset), var(--hbd-focus-offset));\n  box-shadow: var(--hbd-button-shadow-active);\n}\n.hbd-button--default.is-disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n  pointer-events: none;\n}\n\n/* ── Variant: primary ───────────────────────────────────────────────── */\n.hbd-button--primary {\n  background: var(--hbd-color-surface-action);\n  color: var(--hbd-color-parchment-100);\n  border-color: var(--hbd-color-blood-deep);\n  box-shadow: var(--hbd-button-shadow-primary);\n}\n.hbd-button--primary:hover {\n  background: var(--hbd-color-surface-action-hover);\n}\n.hbd-button--primary:active {\n  transform: translate(var(--hbd-focus-offset), var(--hbd-focus-offset));\n  box-shadow: var(--hbd-button-shadow-primary-active);\n}\n.hbd-button--primary.is-disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n  pointer-events: none;\n}\n\n/* ── Variant: gold ──────────────────────────────────────────────────── */\n.hbd-button--gold {\n  background: var(--hbd-color-gold);\n  color: var(--hbd-color-ink-900);\n  border-color: var(--hbd-color-gold-deep);\n  box-shadow: var(--hbd-button-shadow-gold);\n}\n.hbd-button--gold:hover {\n  background: var(--hbd-color-gold-bright);\n}\n.hbd-button--gold:active {\n  transform: translate(var(--hbd-focus-offset), var(--hbd-focus-offset));\n  box-shadow: var(--hbd-button-shadow-gold-active);\n}\n.hbd-button--gold.is-disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n  pointer-events: none;\n}\n\n/* ── Focus ring ─────────────────────────────────────────────────────── */\n.hbd-button:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n/* ── Loading state ──────────────────────────────────────────────────── */\n.hbd-button.is-loading {\n  cursor: progress;\n  position: relative;\n  color: transparent;\n}\n/* de-shadowed from `.hbd-button.is-loading > slot[...]` — hide every child\n   except the centred spinner overlay. */\n.hbd-button.is-loading > :not(.hbd-button__spinner) {\n  opacity: 0;\n}\n.hbd-button__spinner {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  color: currentColor;\n  pointer-events: none;\n}\n\n/* ── Icon slots ─────────────────────────────────────────────────────── */\n.hbd-button__icon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--hbd-space-4);\n  height: var(--hbd-space-4);\n}\n\n/* ── Icon-only modifier ─────────────────────────────────────────────── */\n.hbd-button--icon-only {\n  padding: var(--hbd-space-2);\n  aspect-ratio: 1;\n  flex-shrink: 0;\n}\n.hbd-button--sm.hbd-button--icon-only { padding: var(--hbd-space-1); }\n.hbd-button--md.hbd-button--icon-only { padding: var(--hbd-space-2); }\n.hbd-button--lg.hbd-button--icon-only { padding: var(--hbd-space-3); }\n\n/* de-shadowed from ::slotted(svg)/::slotted(.hbd-button__icon) */\n.hbd-button--icon-only .hbd-button__icon,\n.hbd-button--icon-only svg {\n  width: var(--hbd-space-4);\n  height: var(--hbd-space-4);\n}\n.hbd-button--sm.hbd-button--icon-only .hbd-button__icon,\n.hbd-button--sm.hbd-button--icon-only svg {\n  width: var(--hbd-space-3);\n  height: var(--hbd-space-3);\n}\n.hbd-button--lg.hbd-button--icon-only .hbd-button__icon,\n.hbd-button--lg.hbd-button--icon-only svg {\n  width: var(--hbd-space-6);\n  height: var(--hbd-space-6);\n}\n\n/* ── Pressed (toggle) state ─────────────────────────────────────────── */\n.hbd-button--pressed {\n  background: var(--hbd-color-surface-action);\n  color: var(--hbd-color-text-on-action);\n  border-color: var(--hbd-color-surface-action);\n}\n.hbd-button--default.hbd-button--pressed,\n.hbd-button--primary.hbd-button--pressed,\n.hbd-button--gold.hbd-button--pressed {\n  background: var(--hbd-color-surface-action);\n  color: var(--hbd-color-text-on-action);\n  border-color: var(--hbd-color-blood-deep);\n  box-shadow: var(--hbd-button-shadow-primary);\n}\n.hbd-button--pressed:hover {\n  filter: brightness(0.92);\n}\n.hbd-button--pressed.is-disabled,\n.hbd-button--pressed:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n  pointer-events: none;\n}\n\n/* ──────── callout.css ──────── */\n/*\n * Here Be Dragons DS\n * callout.css (de-shadowed from ds/styles/components/callout.css)\n *\n * Callout — info / warning / error / success (saturated status surfaces,\n * F-02 tokens) plus the Here Be Dragons-specific \"sage-advice\" variant\n * (preserved pale-gold advisory look). Every value references a --hbd-* token.\n *\n * Status icon/dismiss colours use the variant's -text token via currentColor\n * so they keep the same contrast as body text on the saturated surface.\n *\n * Source has no Shadow DOM constructs (:host/::slotted/::part) — it is already\n * light-DOM BEM, so the rules are carried over verbatim.\n */\n\n/* ── Base ───────────────────────────────────────────────────────────── */\n/* Dismiss animation: opacity + max-height + padding collapse, on\n   --hbd-duration-slow + --hbd-ease-out — matches the panel-slide timing\n   used by select / time-picker for visual consistency across the DS.\n   --hbd-callout-dismiss-max-height is the open-state ceiling (CSS cannot\n   transition to or from auto); any real callout fits comfortably under it.\n   Reduced-motion override in hbd-theme globals collapses transitions. */\n.hbd-callout {\n  display: flex;\n  align-items: flex-start;\n  gap: var(--hbd-space-3);\n  padding: var(--hbd-space-3) var(--hbd-space-4);\n  border-radius: var(--hbd-radius-md);\n  border-left: var(--hbd-border-width-thick) solid transparent;\n  font-family: var(--hbd-font-family-ui);\n  overflow: hidden;\n  max-height: var(--hbd-callout-dismiss-max-height);\n  transition: opacity var(--hbd-duration-slow) var(--hbd-ease-out),\n              max-height var(--hbd-duration-slow) var(--hbd-ease-out),\n              padding var(--hbd-duration-slow) var(--hbd-ease-out),\n              margin var(--hbd-duration-slow) var(--hbd-ease-out);\n}\n\n/* ── Icon ───────────────────────────────────────────────────────────── */\n.hbd-callout__icon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  /* Center the icon vertically against the whole callout while the body\n     + dismiss button stay anchored at the top (the parent uses\n     align-items: flex-start). */\n  align-self: center;\n  width: var(--hbd-space-6);\n  height: var(--hbd-space-6);\n  color: currentColor;\n}\n\n/* ── Body ───────────────────────────────────────────────────────────── */\n.hbd-callout__body {\n  flex: 1;\n  min-width: 0;\n}\n\n.hbd-callout__title {\n  font-weight: var(--hbd-font-weight-semibold);\n  font-size: var(--hbd-font-size-body);\n  line-height: var(--hbd-line-height-snug);\n  margin-bottom: var(--hbd-space-1);\n  color: inherit;\n}\n\n.hbd-callout__content {\n  font-size: var(--hbd-font-size-body);\n  line-height: var(--hbd-line-height-body);\n  color: inherit;\n}\n\n/* ── Variant: info ──────────────────────────────────────────────────── */\n.hbd-callout--info {\n  background-color: var(--hbd-color-status-info-surface);\n  border-left-color: var(--hbd-color-status-info-border);\n  color: var(--hbd-color-status-info-text);\n}\n\n/* ── Variant: warning ───────────────────────────────────────────────── */\n.hbd-callout--warning {\n  background-color: var(--hbd-color-status-warning-surface);\n  border-left-color: var(--hbd-color-status-warning-border);\n  color: var(--hbd-color-status-warning-text);\n}\n\n/* ── Variant: error ─────────────────────────────────────────────────── */\n.hbd-callout--error {\n  background-color: var(--hbd-color-status-error-surface);\n  border-left-color: var(--hbd-color-status-error-border);\n  color: var(--hbd-color-status-error-text);\n}\n\n/* ── Variant: success ───────────────────────────────────────────────── */\n.hbd-callout--success {\n  background-color: var(--hbd-color-status-success-surface);\n  border-left-color: var(--hbd-color-status-success-border);\n  color: var(--hbd-color-status-success-text);\n}\n\n/* ── Variant: sage-advice (Here Be Dragons-specific) ────────────────────\n * In-world guidance, tips, and lore — NOT for system status messages.\n * Never repurpose this variant to convey info/warning/error/success state.\n * Preserves the legacy pale-gold advisory look: dashed gold accent, gold\n * uppercase label, serif-italic body. */\n.hbd-callout--sage-advice {\n  background-color: var(--hbd-callout-sage-advice-bg);\n  /* Full dashed border on all four sides (overrides the base left-only rule) */\n  border: var(--hbd-border-width-thin) dashed var(--hbd-callout-sage-advice-border);\n  color: var(--hbd-color-text-secondary);\n}\n.hbd-callout--sage-advice .hbd-callout__icon {\n  color: var(--hbd-color-gold-deep);\n}\n.hbd-callout--sage-advice .hbd-callout__title {\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-font-size-micro);\n  font-weight: var(--hbd-font-weight-bold);\n  letter-spacing: var(--hbd-letter-spacing-label);\n  text-transform: uppercase;\n  color: var(--hbd-color-gold-deep);\n}\n.hbd-callout--sage-advice .hbd-callout__content {\n  font-family: var(--hbd-font-family-serif);\n  font-style: italic;\n  font-size: var(--hbd-font-size-flavor);\n  line-height: var(--hbd-line-height-flavor);\n  color: var(--hbd-color-text-secondary);\n}\n\n/* ── Dismiss button ─────────────────────────────────────────────────── */\n.hbd-callout__dismiss {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  /* ≥44px touch target (SC 2.5.8) via min-size; visual glyph stays small */\n  min-width: var(--hbd-space-12);\n  min-height: var(--hbd-space-12);\n  margin: calc(-1 * var(--hbd-space-2)) calc(-1 * var(--hbd-space-2)) calc(-1 * var(--hbd-space-2)) 0;\n  padding: var(--hbd-space-1);\n  background: none;\n  border: none;\n  border-radius: var(--hbd-radius-sm);\n  color: currentColor;\n  opacity: 0.8;\n  cursor: pointer;\n  transition: opacity var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-callout__dismiss:hover {\n  opacity: 1;\n}\n.hbd-callout__dismiss:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n/* ── Dismissed state — opacity + height collapse together ───────────── */\n.hbd-callout.is-dismissed {\n  opacity: 0;\n  max-height: 0;\n  padding-top: 0;\n  padding-bottom: 0;\n  margin-top: 0;\n  margin-bottom: 0;\n}\n\n/* ──────── card.css ──────── */\n/*\n * Here Be Dragons DS — card.css\n * Ported for React / light-DOM from ds/styles/components/card.css.\n * The legacy WC was already Light DOM (no :host / ::slotted / ::part), so the\n * selectors carry over verbatim. Every value still references a --hbd-* token\n * (defined in globals.css). 1:1 with the legacy look.\n *\n * Card surface — groups related content + optional actions on a contained\n * rectangle. Four layouts (basic / interactive / media / horizontal) and three\n * surface modifiers (default shadow, bordered, elevated).\n */\n\n/* ── 1 · Base ─────────────────────────────────────────────────────── */\n.hbd-card {\n  display: flex;\n  flex-direction: column;\n  background: var(--hbd-color-surface-default);\n  border-radius: var(--hbd-card-border-radius);\n  box-shadow: var(--hbd-shadow-sm);\n  /* overflow:hidden clips media radii cleanly. The interactive focus\n     ring is painted via OUTLINE (not box-shadow), so the ring sits\n     OUTSIDE the box and is not affected by this clip. */\n  overflow: hidden;\n  position: relative;\n  border: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n  font-family: var(--hbd-font-family-ui);\n}\n\n/* Bordered — explicit border, no shadow. Used when cards sit on a\n   noisy backdrop where a shadow would muddy the edge. */\n.hbd-card--bordered {\n  box-shadow: var(--hbd-shadow-none);\n  border: var(--hbd-border-width-thin) solid var(--hbd-color-border-default);\n}\n\n/* Elevated — heavier drop shadow for callouts and feature lists. */\n.hbd-card--elevated {\n  box-shadow: var(--hbd-shadow-md);\n}\n\n/* ── 2 · Interactive ──────────────────────────────────────────────── */\n/* The card carries .hbd-card--interactive and is itself the focusable\n   element (either <a href> or a div with tabindex + role=\"button\" —\n   chosen by the component). Hover/active animation uses tokenised offsets\n   so no raw px sneaks in. */\n.hbd-card--interactive {\n  cursor: pointer;\n  text-decoration: none;\n  color: inherit;\n  transition: box-shadow var(--hbd-duration-fast) var(--hbd-ease-out),\n              transform var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n\n.hbd-card--interactive:hover {\n  box-shadow: var(--hbd-shadow-md);\n  transform: translateY(calc(-1 * var(--hbd-space-1)));\n}\n\n.hbd-card--interactive:active {\n  transform: translateY(0);\n  box-shadow: var(--hbd-shadow-sm);\n}\n\n/* Focus ring uses OUTLINE so it is painted outside the card's clip\n   region (the card sets overflow:hidden to round the media corners,\n   which would clip any inset box-shadow ring). Two cases:\n   - href-based interactive card: the inner .hbd-card__link is the\n     focusable element; paint the ring on the CARD when the link is\n     focused (via :focus-within) so the ring sits outside the clip.\n   - div-based interactive card: the card itself is focusable. */\n.hbd-card--interactive:focus-visible,\n.hbd-card--interactive:has(.hbd-card__link:focus-visible) {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n/* Suppress the inner anchor's default focus ring — the card paints\n   one outside the clip region via the rule above. */\n.hbd-card__link:focus-visible {\n  outline: none;\n}\n\n/* Anchor wrapper used when an href-based interactive card needs a\n   real <a> for native navigation. Fills the card's inner area and\n   inherits the card's flex direction so horizontal cards lay out\n   their image + content correctly. */\n.hbd-card__link {\n  display: flex;\n  flex-direction: inherit;\n  flex: 1;\n  color: inherit;\n  text-decoration: none;\n}\n\n/* ── 3 · Media ────────────────────────────────────────────────────── */\n.hbd-card__media {\n  width: 100%;\n  height: var(--hbd-card-media-height);\n  overflow: hidden;\n  flex-shrink: 0;\n  background: var(--hbd-color-surface-subtle);\n}\n\n.hbd-card__img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  display: block;\n}\n\n/* Placeholder div substituted when an image fails to load.\n   Same dimensions as the media slot so layout doesn't shift. */\n.hbd-card__media-placeholder {\n  width: 100%;\n  height: 100%;\n  background: var(--hbd-color-surface-subtle);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--hbd-color-text-muted);\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n}\n\n/* ── 4 · Header / title / subtitle ────────────────────────────────── */\n.hbd-card__header {\n  padding: var(--hbd-card-padding);\n  padding-bottom: 0;\n  display: flex;\n  flex-direction: column;\n  gap: var(--hbd-space-1);\n}\n\n.hbd-card__title {\n  font-family: var(--hbd-font-family-accent);\n  font-size: var(--hbd-font-size-h4);\n  font-weight: var(--hbd-font-weight-semibold);\n  color: var(--hbd-color-text-primary);\n  margin: 0;\n  line-height: var(--hbd-line-height-display);\n}\n\n.hbd-card__subtitle {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  color: var(--hbd-color-text-muted);\n  margin: 0;\n}\n\n/* ── 5 · Body ─────────────────────────────────────────────────────── */\n.hbd-card__body {\n  padding: var(--hbd-card-padding);\n  flex: 1;\n  font-family: var(--hbd-font-family-serif);\n  font-size: var(--hbd-font-size-body);\n  color: var(--hbd-color-text-secondary);\n  line-height: var(--hbd-line-height-body);\n}\n\n/* ── 6 · Footer ───────────────────────────────────────────────────── */\n.hbd-card__footer {\n  padding: var(--hbd-space-3) var(--hbd-card-padding);\n  display: flex;\n  align-items: center;\n  gap: var(--hbd-space-2);\n  border-top: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n  flex-wrap: wrap;\n}\n\n/* ── 7 · Size modifiers ───────────────────────────────────────────── */\n.hbd-card--sm .hbd-card__header,\n.hbd-card--sm .hbd-card__body  { padding: var(--hbd-card-padding-sm); }\n.hbd-card--sm .hbd-card__header { padding-bottom: 0; }\n.hbd-card--sm .hbd-card__footer {\n  padding: var(--hbd-space-2) var(--hbd-card-padding-sm);\n}\n\n.hbd-card--lg .hbd-card__header,\n.hbd-card--lg .hbd-card__body  { padding: var(--hbd-card-padding-lg); }\n.hbd-card--lg .hbd-card__header { padding-bottom: 0; }\n.hbd-card--lg .hbd-card__footer {\n  padding: var(--hbd-space-4) var(--hbd-card-padding-lg);\n}\n\n.hbd-card--flush .hbd-card__header,\n.hbd-card--flush .hbd-card__body,\n.hbd-card--flush .hbd-card__footer { padding: 0; }\n.hbd-card--flush .hbd-card__footer { border-top: 0; }\n\n/* ── 8 · Horizontal variant ───────────────────────────────────────── */\n.hbd-card--horizontal {\n  flex-direction: row;\n  align-items: stretch;\n}\n\n.hbd-card--horizontal .hbd-card__media {\n  /* Square thumbnail track on the left — same fixed dimension as the\n     vertical media height so both layouts share a visual rhythm. */\n  width: var(--hbd-card-media-height);\n  height: auto;\n  flex-shrink: 0;\n  align-self: stretch;\n}\n\n.hbd-card--horizontal .hbd-card__img {\n  height: 100%;\n}\n\n/* The horizontal layout's content column should occupy remaining\n   space and keep its own vertical flex layout so footer + body\n   distribute correctly. */\n.hbd-card--horizontal > .hbd-card__content {\n  display: flex;\n  flex-direction: column;\n  flex: 1;\n  min-width: 0;\n}\n\n/* ── 9 · Badge overlay ────────────────────────────────────────────── */\n/* Positioned absolutely over the card's top-right corner. Authors slot\n   their own badge content (e.g. a button or rarity chip). */\n.hbd-card__badge {\n  position: absolute;\n  top: var(--hbd-space-3);\n  right: var(--hbd-space-3);\n  z-index: var(--hbd-z-raised);\n  pointer-events: none;\n}\n\n/* ──────── checkbox.css ──────── */\n/*\n * Here Be Dragons DS — checkbox.css\n * Ported for React / light-DOM from ds/styles/components/checkbox.css.\n * The legacy WC already styled in light-DOM terms (the native <input> lived\n * inside the shadow root but the selectors are plain class selectors), so\n * de-shadowing is a no-op here: every .hbd-checkbox* selector is preserved\n * verbatim and the React markup re-emits the identical class/element tree.\n *\n * Token-driven checkbox. Native <input type=\"checkbox\"> is visually hidden\n * (clip technique, stays in the a11y tree) and a styled .hbd-checkbox__control\n * shows the state. Every value references a --hbd-* token (defined in globals.css).\n *\n * The hidden-input dimensions use --hbd-border-width-hairline (1px) so the\n * clip technique stays token-pure (the technique needs 1px / -1px).\n *\n * NOTE: the .hbd-field--error / .hbd-field__error shared validation classes\n * referenced by the markup live in the input / form-validation component CSS\n * (single source of truth) — not duplicated here.\n */\n\n/* ── Field wrapper ──────────────────────────────────────────────────── */\n.hbd-checkbox {\n  position: relative;\n  display: inline-flex;\n  align-items: flex-start;\n  gap: var(--hbd-space-2);\n  /* ≥44px touch target (SC 2.5.8): 22px control + 2×12px padding = 46px. */\n  padding: var(--hbd-space-3) 0;\n  cursor: pointer;\n}\n\n/* ── Visually-hidden native input (stays in a11y tree) ──────────────── */\n.hbd-checkbox__input {\n  position: absolute;\n  width: var(--hbd-border-width-hairline);\n  height: var(--hbd-border-width-hairline);\n  margin: calc(-1 * var(--hbd-border-width-hairline));\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n/* ── Visual control box ─────────────────────────────────────────────── */\n.hbd-checkbox__control {\n  position: relative;\n  flex-shrink: 0;\n  width: var(--hbd-checkbox-size);\n  height: var(--hbd-checkbox-size);\n  border: var(--hbd-border-width-thin) solid var(--hbd-color-border-strong);\n  border-radius: var(--hbd-radius-sm);\n  background: var(--hbd-color-surface-raised);\n  box-shadow: var(--hbd-checkbox-shadow);\n  transition: background-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              border-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              box-shadow var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n\n/* Checkmark — CSS-drawn tick, hidden until checked */\n.hbd-checkbox__control::after {\n  content: \"\";\n  position: absolute;\n  left: 50%;\n  top: 45%;\n  width: 0.3em;\n  height: 0.55em;\n  border: solid var(--hbd-color-parchment-100);\n  border-width: 0 var(--hbd-border-width-thin) var(--hbd-border-width-thin) 0;\n  transform: translate(-50%, -50%) rotate(45deg) scale(0.5);\n  opacity: 0;\n  transition: opacity var(--hbd-duration-fast) var(--hbd-ease-out),\n              transform var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n\n/* Indeterminate dash — hidden until indeterminate */\n.hbd-checkbox__control::before {\n  content: \"\";\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  width: 0.6em;\n  height: var(--hbd-border-width-thin);\n  background: var(--hbd-color-parchment-100);\n  transform: translate(-50%, -50%) scale(0.5);\n  opacity: 0;\n  transition: opacity var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n\n/* ── Checked ────────────────────────────────────────────────────────── */\n.hbd-checkbox--checked .hbd-checkbox__control {\n  background: var(--hbd-color-surface-action);\n  border-color: var(--hbd-color-blood-deep);\n  box-shadow: var(--hbd-checkbox-shadow-checked);\n}\n.hbd-checkbox--checked .hbd-checkbox__control::after {\n  opacity: 1;\n  transform: translate(-50%, -50%) rotate(45deg) scale(1);\n}\n\n/* ── Indeterminate ──────────────────────────────────────────────────── */\n.hbd-checkbox--indeterminate .hbd-checkbox__control {\n  background: var(--hbd-color-surface-action);\n  border-color: var(--hbd-color-blood-deep);\n  box-shadow: var(--hbd-checkbox-shadow-checked);\n}\n.hbd-checkbox--indeterminate .hbd-checkbox__control::before {\n  opacity: 1;\n  transform: translate(-50%, -50%) scale(1);\n}\n.hbd-checkbox--indeterminate .hbd-checkbox__control::after {\n  opacity: 0;\n}\n\n/* ── Hover ──────────────────────────────────────────────────────────── */\n.hbd-checkbox:hover .hbd-checkbox__control {\n  border-color: var(--hbd-color-border-strong);\n}\n\n/* ── Focus (native input drives the adjacent control's ring) ────────── */\n.hbd-checkbox__input:focus-visible + .hbd-checkbox__control {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n/* ── Disabled ───────────────────────────────────────────────────────── */\n.hbd-checkbox--disabled {\n  cursor: not-allowed;\n  opacity: 0.5;\n}\n.hbd-checkbox--disabled .hbd-checkbox__label {\n  color: var(--hbd-color-text-disabled);\n  cursor: not-allowed;\n}\n\n/* ── Error ──────────────────────────────────────────────────────────── */\n.hbd-checkbox--error .hbd-checkbox__control {\n  border-color: var(--hbd-color-status-error-surface);\n}\n/* Label text matches the error message colour for visual consistency. */\n.hbd-checkbox--error .hbd-checkbox__label {\n  color: var(--hbd-color-text-emphasis);\n}\n.hbd-checkbox__error {\n  display: block;\n  /* text-emphasis (blood, ~12.8:1 on parchment) — AA-compliant dark red.\n     status-error-text resolves to parchment-50 (near-white, for use on a\n     saturated surface) and would be invisible on the parchment page;\n     same on-page-dark precedent as input/textarea/select/radio-group. */\n  color: var(--hbd-color-text-emphasis);\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  margin-top: var(--hbd-space-1);\n}\n\n/* ── Label + hint (shared with .hbd-radio + .hbd-switch) ────────────── */\n/* Radio and switch both inherit these rules — kept here as the single\n   source of truth so any future tweak (font, spacing) applies to all\n   three controls. */\n.hbd-checkbox__label,\n.hbd-radio__label,\n.hbd-switch__label {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-body);\n  color: var(--hbd-color-text-primary);\n  line-height: var(--hbd-line-height-body);\n  cursor: pointer;\n}\n.hbd-checkbox__hint,\n.hbd-radio__hint,\n.hbd-switch__hint {\n  display: block;\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  color: var(--hbd-color-text-muted);\n  margin-top: var(--hbd-space-1);\n}\n\n/* ── Group ──────────────────────────────────────────────────────────── */\n.hbd-checkbox-group {\n  display: flex;\n  flex-direction: column;\n  gap: var(--hbd-space-3);\n  border: none;\n  padding: 0;\n  margin: 0;\n}\n.hbd-checkbox-group legend {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-body);\n  font-weight: var(--hbd-font-weight-semibold);\n  color: var(--hbd-color-text-primary);\n  margin-bottom: var(--hbd-space-2);\n}\n\n/* ──────── chip.css ──────── */\n/*\n * Here Be Dragons DS — chip.css\n * Ported for React / light DOM from the chip section of\n * ds/styles/components/badge.css. The source WC is already light-DOM\n * (no Shadow DOM, no ::slotted/::part), so this is a 1:1 transcription.\n * Every value still references a --hbd-* token (defined in globals.css).\n */\n\n.hbd-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--hbd-space-1);\n  height: var(--hbd-chip-height);\n  padding: 0 var(--hbd-space-3);\n  border-radius: var(--hbd-radius-full);\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  font-weight: var(--hbd-font-weight-medium);\n  line-height: 1;\n  white-space: nowrap;\n  border: var(--hbd-border-width-hairline) solid transparent;\n  background: var(--hbd-color-surface-subtle);\n  color: var(--hbd-color-text-primary);\n  max-width: var(--hbd-chip-max-width);\n  vertical-align: middle;\n}\n\n/* The chip label uses min-width:0 + overflow:hidden so a long label\n   truncates with an ellipsis without breaking the row layout. */\n.hbd-chip__label {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n/* Leading icon slot. Authors slot in a tokenised SVG (16x16). */\n.hbd-chip__icon {\n  width: var(--hbd-space-4);\n  height: var(--hbd-space-4);\n  flex-shrink: 0;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  color: inherit;\n}\n.hbd-chip__icon svg {\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n\n/* Chip colour variants — mirror the badge palette. */\n.hbd-chip--primary {\n  background: var(--hbd-color-surface-action);\n  color: var(--hbd-color-text-on-action);\n}\n.hbd-chip--success {\n  background: var(--hbd-color-status-success-surface);\n  color: var(--hbd-color-status-success-text);\n}\n.hbd-chip--warning {\n  background: var(--hbd-color-status-warning-surface);\n  color: var(--hbd-color-status-warning-text);\n}\n.hbd-chip--error {\n  background: var(--hbd-color-status-error-surface);\n  color: var(--hbd-color-status-error-text);\n}\n.hbd-chip--neutral {\n  background: var(--hbd-color-surface-subtle);\n  color: var(--hbd-color-text-primary);\n  border-color: var(--hbd-color-border-strong);\n}\n\n/* Outline modifier — transparent fill, coloured border. Stacked on a\n   colour variant the border + text both shift to that palette. */\n.hbd-chip--outline {\n  background: transparent;\n  color: var(--hbd-color-text-primary);\n  border-color: var(--hbd-color-border-strong);\n}\n.hbd-chip--outline.hbd-chip--primary {\n  background: transparent;\n  border-color: var(--hbd-color-surface-action);\n  color: var(--hbd-color-text-emphasis);\n}\n.hbd-chip--outline.hbd-chip--success {\n  background: transparent;\n  border-color: var(--hbd-color-status-success-border);\n  color: var(--hbd-color-status-success-border);\n}\n.hbd-chip--outline.hbd-chip--warning {\n  background: transparent;\n  border-color: var(--hbd-color-status-warning-icon);\n  color: var(--hbd-color-status-warning-icon);\n}\n.hbd-chip--outline.hbd-chip--error {\n  background: transparent;\n  border-color: var(--hbd-color-status-error-border);\n  color: var(--hbd-color-status-error-border);\n}\n\n/* Sizes — sm + lg adjust both height and padding so the pill keeps a\n   balanced aspect ratio. */\n.hbd-chip--sm {\n  height: var(--hbd-chip-height-sm);\n  font-size: var(--hbd-font-size-micro);\n  padding: 0 var(--hbd-space-2);\n}\n.hbd-chip--lg {\n  height: var(--hbd-chip-height-lg);\n  font-size: var(--hbd-font-size-body);\n  padding: 0 var(--hbd-space-4);\n}\n\n/* ─── Remove button ───────────────────────────────────────────────── */\n/* The icon is a small space-4 square, but the padding+negative-margin\n   trick expands the tap area without changing the painted size. */\n.hbd-chip__remove {\n  flex-shrink: 0;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--hbd-space-4);\n  height: var(--hbd-space-4);\n  padding: var(--hbd-space-2);\n  margin-right: calc(-1 * var(--hbd-space-2));\n  background: none;\n  border: none;\n  color: var(--hbd-color-text-muted);\n  cursor: pointer;\n  border-radius: var(--hbd-radius-full);\n  line-height: 1;\n  /* Box-sizing:content-box so the padding adds tap area instead of\n     shrinking the visual icon. */\n  box-sizing: content-box;\n  transition: color var(--hbd-duration-fast) var(--hbd-ease-out),\n              background-color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-chip__remove:hover {\n  color: var(--hbd-color-text-primary);\n  background: rgba(0, 0, 0, 0.06);\n}\n.hbd-chip__remove:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n.hbd-chip__remove svg {\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n\n/* ─── Selectable chip ─────────────────────────────────────────────── */\n/* Renders as a real <button type=\"button\"> so it inherits native\n   button semantics, Enter/Space activation, and the global focus ring.\n   The .is-selected class mirrors aria-pressed and changes the fill to\n   the action surface. */\n.hbd-chip--selectable {\n  cursor: pointer;\n  user-select: none;\n  /* Reset native button chrome so the chip looks identical whether\n     it's a span (static) or a button (selectable). */\n  font: inherit;\n  -webkit-appearance: none;\n  appearance: none;\n  transition: background-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              color var(--hbd-duration-fast) var(--hbd-ease-out),\n              border-color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-chip--selectable:hover {\n  filter: brightness(0.95);\n}\n.hbd-chip--selectable.is-selected,\n.hbd-chip--selectable[aria-pressed=\"true\"] {\n  background: var(--hbd-color-surface-action);\n  color: var(--hbd-color-text-on-action);\n  border-color: var(--hbd-color-surface-action);\n}\n.hbd-chip--selectable.hbd-chip--outline.is-selected,\n.hbd-chip--selectable.hbd-chip--outline[aria-pressed=\"true\"] {\n  background: var(--hbd-color-surface-action);\n  color: var(--hbd-color-text-on-action);\n  border-color: var(--hbd-color-surface-action);\n}\n.hbd-chip--selectable:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n/* ──────── codeblock.css ──────── */\n/*\n * Here Be Dragons DS — codeblock.css\n * Ported for React / light-DOM from ds/styles/components/codeblock.css.\n * The legacy WC already styled via .hbd-codeblock__* classes (no :host /\n * ::slotted selectors), so the CSS ports verbatim. Every value still\n * references a --hbd-* token (defined in globals.css). 1:1 with the legacy look.\n */\n\n/* ── Outer wrapper ──────────────────────────────────────────────────── */\n.hbd-codeblock {\n  border: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n  border-radius: var(--hbd-radius-md);\n  overflow: hidden;\n  background: var(--hbd-color-surface-code);\n}\n\n/* ── Header bar ─────────────────────────────────────────────────────── */\n.hbd-codeblock__header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--hbd-space-4);\n  padding: var(--hbd-space-2) var(--hbd-space-4);\n  /* one step darker than the code surface */\n  background: var(--hbd-color-ink-950);\n  border-bottom: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n}\n/* On the dark code surface, a LIGHT muted token is needed for ≥4.5:1\n   (text-muted is a dark ink and fails on dark surfaces). */\n.hbd-codeblock__filename {\n  font-family: var(--hbd-font-family-mono);\n  font-size: var(--hbd-font-size-label);\n  color: var(--hbd-color-parchment-300);\n}\n.hbd-codeblock__language {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-micro);\n  color: var(--hbd-color-parchment-300);\n  text-transform: uppercase;\n  letter-spacing: var(--hbd-letter-spacing-label);\n}\n\n/* ── Copy button ────────────────────────────────────────────────────── */\n.hbd-codeblock__copy {\n  position: absolute;\n  top: var(--hbd-space-2);\n  right: var(--hbd-space-2);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  /* ≥44px touch target (SC 2.5.8) */\n  min-width: var(--hbd-space-12);\n  min-height: var(--hbd-space-12);\n  padding: var(--hbd-space-1) var(--hbd-space-2);\n  background: none;\n  border: none;\n  border-radius: var(--hbd-radius-sm);\n  color: var(--hbd-color-parchment-300);\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-micro);\n  text-transform: uppercase;\n  letter-spacing: var(--hbd-letter-spacing-label);\n  cursor: pointer;\n  transition: color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-codeblock__copy:hover {\n  color: var(--hbd-color-text-inverse);\n}\n.hbd-codeblock__copy:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n.hbd-codeblock__copy.is-copied {\n  color: var(--hbd-color-status-success-text);\n}\n\n/* ── Code body ──────────────────────────────────────────────────────── */\n.hbd-codeblock__body {\n  position: relative;\n  display: flex;\n  overflow-x: auto;\n  padding: var(--hbd-space-4);\n}\n\n.hbd-codeblock__pre {\n  margin: 0;\n  padding: 0;\n  background: transparent;\n  overflow: visible;\n}\n\n.hbd-codeblock__code {\n  font-family: var(--hbd-font-family-mono);\n  font-size: var(--hbd-font-size-sm);\n  line-height: var(--hbd-line-height-relaxed);\n  color: var(--hbd-syntax-default);\n  white-space: pre;\n  tab-size: 2;\n}\n\n/* ── Line numbers ───────────────────────────────────────────────────── */\n.hbd-codeblock__line-numbers {\n  display: flex;\n  flex-direction: column;\n  flex-shrink: 0;\n  margin-right: var(--hbd-space-4);\n  padding-right: var(--hbd-space-4);\n  min-width: var(--hbd-space-8);\n  /* light muted on dark surface (text-muted is dark ink, illegible here) */\n  color: var(--hbd-color-parchment-400);\n  font-family: var(--hbd-font-family-mono);\n  font-size: var(--hbd-font-size-sm);\n  line-height: var(--hbd-line-height-relaxed);\n  text-align: right;\n  user-select: none;\n  border-right: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n}\n\n/* ── Syntax token colours (each --hbd-syntax-* references a primitive) ── */\n.hbd-codeblock__code .tok-keyword,\n.hbd-codeblock__code .tok-selector  { color: var(--hbd-syntax-keyword); }\n.hbd-codeblock__code .tok-string,\n.hbd-codeblock__code .tok-value     { color: var(--hbd-syntax-string); }\n.hbd-codeblock__code .tok-comment   { color: var(--hbd-syntax-comment); font-style: italic; }\n.hbd-codeblock__code .tok-number    { color: var(--hbd-syntax-number); }\n.hbd-codeblock__code .tok-property,\n.hbd-codeblock__code .tok-function  { color: var(--hbd-syntax-function); }\n.hbd-codeblock__code .tok-operator  { color: var(--hbd-syntax-operator); }\n\n/* ──────── combobox.css ──────── */\n/* Ported from the combobox section of ds/styles/components/input.css\n   (the WC adopts input.css into its shadow root). De-shadowed into this\n   self-contained file: the original lives in the light DOM already (no\n   :host / ::slotted / ::part to translate), so every selector is kept\n   verbatim. Only the parts UNIQUE to combobox live here — the field chrome\n   (.hbd-field + label/hint/error/footer) ships with @hbd/input, and the\n   dropdown panel + option rules (.hbd-field__select-panel / .hbd-field__option*)\n   ship with @hbd/select. Every var(--hbd-*) reference and the @keyframes are\n   kept verbatim; no absolute /paths. */\n\n/* ── Combobox (autocomplete / strict / multi) ───────────────────────── */\n/* Combobox combines a text input with a filterable suggestion list.\n   The wrapper hosts chips (multi mode) + the native <input>, with a clear\n   (×) button on the right when there is something to clear. The dropdown\n   panel reuses the select panel + option styles defined by @hbd/select —\n   .hbd-field__select-panel, .hbd-field__option(-group)(-label). The classes\n   below cover only the parts unique to combobox. */\n\n/* Shell — positioning context for the absolutely-positioned panel.\n   The combobox itself needs overflow:auto (multi mode), which would clip\n   the popover, so the panel is a SIBLING of the combobox inside this\n   shell rather than a child of it. */\n.hbd-combobox__shell {\n  position: relative;\n  width: 100%;\n}\n\n.hbd-combobox {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: var(--hbd-space-1);\n  width: 100%;\n  min-height: var(--hbd-input-min-height);\n  padding: var(--hbd-space-1) var(--hbd-space-3);\n  background: var(--hbd-color-surface-default);\n  /* border-strong (ink-700, ~11.4:1 on parchment) — same SC 1.4.11 precedent\n     as the other input borders. border-default would be ~2.06:1. */\n  border: var(--hbd-input-border-width) solid var(--hbd-color-border-strong);\n  border-radius: var(--hbd-input-border-radius);\n  cursor: text;\n  transition: border-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              box-shadow var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-combobox:focus-within {\n  border-color: var(--hbd-color-input-focus-border);\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n/* Field-level error / disabled — same convention as the other inputs. */\n.hbd-field--error .hbd-combobox {\n  border-color: var(--hbd-color-status-error-border);\n}\n/* Error: tint the typed value AND the placeholder so they match the label\n   + error message. Same precedent as input/textarea/select/stepper. */\n.hbd-field--error .hbd-combobox__input {\n  color: var(--hbd-color-text-emphasis);\n}\n.hbd-field--error .hbd-combobox__input::placeholder {\n  color: var(--hbd-color-text-emphasis);\n  opacity: 1;\n}\n.hbd-field--disabled .hbd-combobox {\n  background: var(--hbd-color-surface-subtle);\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n/* Internal text input — borderless, fills remaining flex track. */\n.hbd-combobox__input {\n  flex: 1;\n  min-width: var(--hbd-combobox-min-input-width);\n  border: none;\n  background: transparent;\n  outline: none;\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-body);\n  color: var(--hbd-color-text-primary);\n  padding: var(--hbd-space-1) 0;\n}\n.hbd-combobox__input::placeholder {\n  color: var(--hbd-color-text-muted);\n  opacity: 1;\n}\n\n/* Multi mode — cap visible chip area to ~3 rows; overflow scrolls\n   vertically. The input always sits after the last chip in source order\n   and wraps with them, so it appears at the end of the chip flow. */\n.hbd-combobox--multi {\n  max-height: var(--hbd-combobox-multi-max-height);\n  overflow-y: auto;\n  overscroll-behavior: contain;\n}\n\n/* Chips (multi mode) — pill-shaped selection tokens. */\n.hbd-combobox__chip {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--hbd-space-1);\n  height: var(--hbd-combobox-chip-height);\n  padding: 0 var(--hbd-space-2);\n  background: var(--hbd-color-surface-raised);\n  border: var(--hbd-border-width-hairline) solid var(--hbd-color-border-ink-brown);\n  border-radius: var(--hbd-radius-full);\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  color: var(--hbd-color-text-primary);\n  max-width: var(--hbd-combobox-chip-max-width);\n}\n.hbd-combobox__chip-label {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.hbd-combobox__chip-remove {\n  flex-shrink: 0;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  background: none;\n  border: none;\n  cursor: pointer;\n  color: var(--hbd-color-text-muted);\n  padding: 0;\n  line-height: 1;\n  border-radius: var(--hbd-radius-full);\n}\n.hbd-combobox__chip-remove:hover {\n  color: var(--hbd-color-text-emphasis);\n}\n.hbd-combobox__chip-remove:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n/* Clear (×) button — visible only when there is content to clear. */\n.hbd-combobox__clear {\n  flex-shrink: 0;\n  display: none;\n  align-items: center;\n  justify-content: center;\n  background: none;\n  border: none;\n  cursor: pointer;\n  color: var(--hbd-color-text-muted);\n  padding: var(--hbd-space-1);\n  border-radius: var(--hbd-radius-sm);\n}\n.hbd-combobox--has-value .hbd-combobox__clear {\n  display: inline-flex;\n}\n.hbd-combobox__clear:hover {\n  color: var(--hbd-color-text-emphasis);\n}\n.hbd-combobox__clear:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n/* Dropdown panel — inherits the select-panel slide animation + structure\n   from @hbd/select. Override max-height so combobox can tune it\n   independently from select. */\n.hbd-combobox__panel {\n  max-height: 0;\n}\n.hbd-field--open .hbd-combobox__panel {\n  max-height: var(--hbd-combobox-panel-max-height);\n}\n\n/* Empty / loading states inside the panel. */\n.hbd-combobox__no-results {\n  padding: var(--hbd-space-3) var(--hbd-space-4);\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-body);\n  color: var(--hbd-color-text-muted);\n  text-align: center;\n}\n.hbd-combobox__loading-row {\n  display: flex;\n  align-items: center;\n  gap: var(--hbd-space-2);\n  padding: var(--hbd-space-3) var(--hbd-space-4);\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  color: var(--hbd-color-text-muted);\n}\n\n/* Spinner — pure CSS, derived from tokenised border widths + colours. */\n.hbd-combobox__spinner {\n  width: var(--hbd-space-4);\n  height: var(--hbd-space-4);\n  border: var(--hbd-border-width-thin) solid var(--hbd-color-border-subtle);\n  border-top-color: var(--hbd-color-text-emphasis);\n  border-radius: var(--hbd-radius-full);\n  animation: hbd-combobox-spin var(--hbd-duration-slower) linear infinite;\n}\n@keyframes hbd-combobox-spin {\n  to { transform: rotate(360deg); }\n}\n\n/* ──────── date-picker.css ──────── */\n/*\n * Here Be Dragons DS\n * registry/new-york/styles/components/date-picker.css\n *\n * De-shadowed from ds/styles/components/date-picker.css (the Shadow-DOM\n * <hbd-date-picker>). Calendar popover with trigger, header (month label +\n * prev/next nav), weekday columnheader row, 6x7 grid of day cells, and a\n * footer with Today/Clear/Cancel/Confirm actions. Three variants: date,\n * date-time, date-range.\n *\n * Notes:\n * - All values via --hbd-* tokens. No hard-coded colour/size/radius/duration.\n * - The trigger reuses the shared field chrome (input.css) for the .hbd-field\n *   wrapper; only date-picker-specific classes live here.\n * - The panel is portalled by Radix Popover in the React port. Its open/enter\n *   reveal is driven by Radix data-state=\"open\" mapped onto the same\n *   max-height/opacity transition the WC drove via .hbd-date-picker--open, and\n *   the close fade plays via data-state=\"closed\". This mirrors popover.css.\n */\n\n/* ── 1 · Block + trigger ───────────────────────────────────────────── */\n.hbd-date-picker {\n  position: relative;\n  width: 100%;\n}\n\n/* Trigger — visually identical to the shared field input surface. */\n.hbd-date-picker__trigger {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--hbd-space-2);\n  width: 100%;\n  min-height: var(--hbd-input-min-height);\n  padding: var(--hbd-input-padding-y) var(--hbd-input-padding-x);\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-input-font-size);\n  color: var(--hbd-color-text-primary);\n  background: var(--hbd-color-surface-default);\n  /* border-strong (ink-700, ~11.4:1 on parchment) — same SC 1.4.11\n     precedent as the other input borders. */\n  border: var(--hbd-input-border-width) solid var(--hbd-color-border-strong);\n  border-radius: var(--hbd-input-border-radius);\n  cursor: pointer;\n  user-select: none;\n  text-align: left;\n  transition: border-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              box-shadow var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-date-picker__trigger:hover {\n  border-color: var(--hbd-color-border-strong);\n}\n.hbd-date-picker__trigger:focus-visible {\n  border-color: var(--hbd-color-input-focus-border);\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n.hbd-date-picker--open .hbd-date-picker__trigger {\n  border-color: var(--hbd-color-input-focus-border);\n}\n.hbd-date-picker--error .hbd-date-picker__trigger {\n  border-color: var(--hbd-color-status-error-border);\n}\n.hbd-date-picker--error .hbd-date-picker__trigger,\n.hbd-date-picker--error .hbd-date-picker__trigger-value--placeholder {\n  color: var(--hbd-color-text-emphasis);\n}\n.hbd-date-picker--disabled .hbd-date-picker__trigger {\n  opacity: 0.5;\n  cursor: not-allowed;\n  background: var(--hbd-color-surface-subtle);\n}\n\n/* Displayed value vs placeholder mode. */\n.hbd-date-picker__trigger-value {\n  flex: 1;\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.hbd-date-picker__trigger-value--placeholder {\n  color: var(--hbd-color-text-muted);\n}\n\n/* Calendar icon at the right edge of the trigger. */\n.hbd-date-picker__trigger-icon {\n  flex-shrink: 0;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--hbd-space-4);\n  height: var(--hbd-space-4);\n  color: var(--hbd-color-text-muted);\n}\n\n/* ── 2 · Panel ─────────────────────────────────────────────────────── */\n/* Slide-open animation mirrors the select panel (max-height + opacity,\n   --hbd-duration-slow). Global prefers-reduced-motion collapses it. In the\n   React port the panel is portalled by Radix Popover and positioned via the\n   floating-ui coords on the style prop; the legacy absolute top/left were\n   replaced by Radix positioning, so we keep only the box treatment here. */\n.hbd-date-picker__panel {\n  z-index: var(--hbd-z-dropdown);\n  width: var(--hbd-date-picker-panel-width);\n  background: var(--hbd-color-surface-raised);\n  border: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n  border-radius: var(--hbd-radius-lg);\n  box-shadow: var(--hbd-shadow-lg);\n  overflow: hidden;\n  max-height: 0;\n  opacity: 0;\n  pointer-events: none;\n  transition: max-height var(--hbd-duration-slow) var(--hbd-ease-out),\n              opacity var(--hbd-duration-slow) var(--hbd-ease-out),\n              padding var(--hbd-duration-slow) var(--hbd-ease-out);\n}\n/* Radix drives the open reveal via data-state=\"open\" on the Content node.\n   The WC drove the same reveal via the .hbd-date-picker--open block modifier;\n   both selectors apply so either render path matches 1:1. */\n.hbd-date-picker--open .hbd-date-picker__panel,\n.hbd-date-picker__panel[data-state=\"open\"] {\n  /* Generous cap: 6 rows × cell-size + header + weekdays + footer + padding.\n     Tied to per-row sizing so layout changes propagate. The date-time\n     variant adds a time picker below the footer and needs more room. */\n  max-height: calc(var(--hbd-date-picker-cell-size) * 14);\n  opacity: 1;\n  pointer-events: auto;\n  padding: var(--hbd-space-3);\n}\n/* Date-time variant: taller body (cell rows + footer + time picker) AND\n   the time picker has its OWN popover that must not be clipped by the\n   date picker's overflow. After open we let content escape. */\n.hbd-date-picker--open.hbd-date-picker--datetime .hbd-date-picker__panel,\n.hbd-date-picker__panel--datetime[data-state=\"open\"] {\n  max-height: calc(var(--hbd-date-picker-cell-size) * 22);\n  overflow: visible;\n}\n\n/* ── 3 · Header (month label + nav) ───────────────────────────────── */\n.hbd-date-picker__header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--hbd-space-2);\n  margin-bottom: var(--hbd-space-3);\n}\n.hbd-date-picker__nav-btn {\n  flex-shrink: 0;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--hbd-date-picker-nav-button-size);\n  height: var(--hbd-date-picker-nav-button-size);\n  background: none;\n  border: none;\n  cursor: pointer;\n  color: var(--hbd-color-text-secondary);\n  border-radius: var(--hbd-radius-sm);\n  transition: background-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-date-picker__nav-btn:hover {\n  background: var(--hbd-color-surface-subtle);\n  color: var(--hbd-color-text-primary);\n}\n.hbd-date-picker__nav-btn:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n.hbd-date-picker__nav-btn:disabled {\n  color: var(--hbd-color-text-disabled);\n  cursor: not-allowed;\n  pointer-events: none;\n}\n\n.hbd-date-picker__month-label {\n  flex: 1;\n  text-align: center;\n  font-family: var(--hbd-font-family-accent);\n  font-size: var(--hbd-font-size-label);\n  font-weight: var(--hbd-font-weight-semibold);\n  letter-spacing: var(--hbd-letter-spacing-wide);\n  color: var(--hbd-color-text-primary);\n  background: none;\n  border: none;\n  cursor: default;\n  padding: var(--hbd-space-1) var(--hbd-space-2);\n}\n\n/* ── 4 · Weekday labels row ────────────────────────────────────────── */\n.hbd-date-picker__weekdays {\n  display: grid;\n  grid-template-columns: repeat(7, 1fr);\n  gap: var(--hbd-space-1);\n  margin-bottom: var(--hbd-space-1);\n}\n.hbd-date-picker__weekday {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-micro);\n  font-weight: var(--hbd-font-weight-semibold);\n  color: var(--hbd-color-text-muted);\n  text-align: center;\n  padding-bottom: var(--hbd-space-1);\n  letter-spacing: var(--hbd-letter-spacing-wide);\n  text-transform: uppercase;\n}\n\n/* ── 5 · Grid (6 weeks × 7 days) ───────────────────────────────────── */\n.hbd-date-picker__grid {\n  display: grid;\n  grid-template-columns: repeat(7, 1fr);\n  gap: var(--hbd-space-1);\n}\n\n.hbd-date-picker__cell {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  position: relative;\n}\n\n.hbd-date-picker__cell-inner {\n  width: var(--hbd-date-picker-cell-size);\n  height: var(--hbd-date-picker-cell-size);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border: none;\n  background: none;\n  border-radius: var(--hbd-radius-full);\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  color: var(--hbd-color-text-primary);\n  cursor: pointer;\n  user-select: none;\n  transition: background-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-date-picker__cell-inner:hover {\n  background: var(--hbd-color-surface-subtle);\n}\n\n/* States: today (subtle highlight + bold), selected (action fill),\n   outside-month (muted), disabled (muted + pointer-blocked), focused. */\n.hbd-date-picker__cell.is-today .hbd-date-picker__cell-inner {\n  background: var(--hbd-color-surface-subtle);\n  font-weight: var(--hbd-font-weight-semibold);\n}\n.hbd-date-picker__cell.is-selected .hbd-date-picker__cell-inner {\n  background: var(--hbd-color-surface-action);\n  color: var(--hbd-color-text-on-action);\n  font-weight: var(--hbd-font-weight-semibold);\n}\n.hbd-date-picker__cell.is-outside-month .hbd-date-picker__cell-inner {\n  color: var(--hbd-color-text-muted);\n  opacity: 0.5;\n}\n.hbd-date-picker__cell.is-disabled .hbd-date-picker__cell-inner {\n  color: var(--hbd-color-text-disabled);\n  cursor: not-allowed;\n  pointer-events: none;\n}\n.hbd-date-picker__cell.is-focused .hbd-date-picker__cell-inner {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-border-width-hairline);\n}\n.hbd-date-picker__cell-inner:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-border-width-hairline);\n}\n\n/* ── 6 · Range states ──────────────────────────────────────────────── */\n/* Mid-range cells: full-width subtle background, square corners. */\n.hbd-date-picker__cell.is-in-range .hbd-date-picker__cell-inner {\n  background: var(--hbd-color-surface-subtle);\n  border-radius: 0;\n  width: 100%;\n}\n/* Start / end: half-fill the