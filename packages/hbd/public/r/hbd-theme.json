--sm {\n  --hbd-switch-width: var(--hbd-switch-sm-width);\n  --hbd-switch-height: var(--hbd-switch-sm-height);\n  --hbd-switch-thumb-size: var(--hbd-switch-sm-thumb-size);\n  --hbd-switch-thumb-offset: var(--hbd-switch-sm-thumb-offset);\n}\n.hbd-switch--lg {\n  --hbd-switch-width: var(--hbd-switch-lg-width);\n  --hbd-switch-height: var(--hbd-switch-lg-height);\n  --hbd-switch-thumb-size: var(--hbd-switch-lg-thumb-size);\n  --hbd-switch-thumb-offset: var(--hbd-switch-lg-thumb-offset);\n}\n\n/* ── Field error message ─────────────────────────────────────────────── */\n/* Carried from input.css so the switch's error wiring is self-contained:\n   the error message is hidden by default and revealed when the field is in\n   the error state. */\n.hbd-field__error {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  line-height: var(--hbd-line-height-body);\n  /* text-emphasis (blood, ~12.8:1 on parchment) — AA-compliant dark red */\n  color: var(--hbd-color-text-emphasis);\n  display: none;\n}\n.hbd-field--error .hbd-field__error {\n  display: block;\n}\n/* Label text matches the error message colour for visual consistency. */\n.hbd-switch--error .hbd-switch__label {\n  color: var(--hbd-color-text-emphasis);\n}\n\n/* ──────── table.css ──────── */\n/*\n * Here Be Dragons DS\n * table.css (de-shadowed from ds/styles/components/table.css)\n *\n * Tabular data display with optional sortable headers, row selection,\n * sticky headers, sticky first column, and three sizes. The React\n * <Table> emits the legacy .hbd-table* markup; this CSS works equally\n * well on a hand-authored <table class=\"hbd-table\"> for static cases.\n *\n * The source component is already Light DOM (no :host / ::slotted /\n * ::part), so this is a 1:1 flatten — every var(--hbd-*) reference is\n * preserved verbatim.\n *\n * Naming notes:\n * - Spec referenced --hbd-color-action-default — emitted token is\n *   --hbd-color-surface-action. The ACTIVE sort header uses\n *   --hbd-color-text-emphasis (blood) instead, because surface-action\n *   is a FILL colour pair only safe with text-on-action; using it as a\n *   text colour on parchment would fail SC 1.4.3.\n * - Spec referenced --hbd-spacing-N — emitted tokens are --hbd-space-N.\n * - SC 1.4.10 (Reflow): WCAG 2.1 Note B explicitly EXEMPTS data\n *   tables from the 320px-no-horizontal-scroll requirement. The\n *   wrapper's overflow-x:auto is the documented escape hatch.\n */\n\n/* ── 1 · Scroll wrapper ───────────────────────────────────────────── */\n.hbd-table-wrap {\n  width: 100%;\n  overflow-x: auto;\n  overscroll-behavior-x: contain;\n  border-radius: var(--hbd-radius-md);\n  font-family: var(--hbd-font-family-ui);\n}\n\n.hbd-table-wrap--bordered {\n  border: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n}\n\n/* ── 2 · Table ────────────────────────────────────────────────────── */\n.hbd-table {\n  width: 100%;\n  border-collapse: collapse;\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-body);\n  color: var(--hbd-color-text-primary);\n}\n\n/* ── 3 · Header cells ─────────────────────────────────────────────── */\n/* position:sticky on each <th> is the cross-browser-safe equivalent\n   of sticking the whole <thead>. The header sits at the top of the\n   scroll wrapper so long tables scroll their body under it. */\n.hbd-table__header {\n  position: sticky;\n  top: 0;\n  z-index: var(--hbd-z-raised);\n  height: var(--hbd-table-header-height);\n  padding: 0 var(--hbd-space-4);\n  text-align: left;\n  /* Tiamat Condensed SC (the DS display family) for column headers —\n     gives the rulebook-table look. Letter-spacing widened so the small\n     caps breathe at label/micro sizes. */\n  font-family: var(--hbd-font-family-display);\n  font-weight: var(--hbd-font-weight-bold);\n  font-size: var(--hbd-font-size-label);\n  letter-spacing: var(--hbd-letter-spacing-label);\n  text-transform: uppercase;\n  color: var(--hbd-color-text-muted);\n  background: var(--hbd-color-surface-default);\n  white-space: nowrap;\n  border-bottom: var(--hbd-border-width-thin) solid var(--hbd-color-border-subtle);\n  user-select: none;\n  vertical-align: middle;\n}\n\n.hbd-table__header--align-right  { text-align: right;  }\n.hbd-table__header--align-center { text-align: center; }\n\n/* Sortable affordance — pointer cursor + hover tint + keyboard focus.\n   The header is given tabindex=\"0\" in JS so it lands in the tab\n   sequence. */\n.hbd-table__header--sortable {\n  cursor: pointer;\n}\n.hbd-table__header--sortable:hover {\n  color: var(--hbd-color-text-primary);\n  background: var(--hbd-color-surface-subtle);\n}\n.hbd-table__header--sortable:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: calc(-1 * var(--hbd-border-width-thin));\n}\n\n/* Active sort — emphasis colour on parchment hits ~8.3:1 AA-safe.\n   surface-action would also pass but reads as a \"fill\" token elsewhere\n   in the DS, so emphasis preserves the visual idiom. */\n.hbd-table__header--sorted-asc,\n.hbd-table__header--sorted-desc {\n  color: var(--hbd-color-text-emphasis);\n}\n\n/* ── 4 · Sort icon ────────────────────────────────────────────────── */\n/* Single triangle SVG, rotated for asc/desc. Unsorted shows a neutral\n   \"swap\" double-arrow rendered separately via a sibling class — see\n   the JS for which variant fires. */\n.hbd-table__sort-icon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  margin-left: var(--hbd-space-1);\n  vertical-align: middle;\n  color: var(--hbd-color-text-muted);\n  width: var(--hbd-space-3);\n  height: var(--hbd-space-3);\n  transition: transform var(--hbd-duration-fast) var(--hbd-ease-out),\n              color     var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-table__sort-icon svg {\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n\n.hbd-table__header--sorted-asc .hbd-table__sort-icon {\n  color: var(--hbd-color-text-emphasis);\n}\n.hbd-table__header--sorted-desc .hbd-table__sort-icon {\n  color: var(--hbd-color-text-emphasis);\n  transform: rotate(180deg);\n}\n\n/* ── 5 · Body + rows ──────────────────────────────────────────────── */\n.hbd-table__body .hbd-table__row {\n  height: var(--hbd-table-row-height);\n  background: var(--hbd-color-surface-default);\n  border-bottom: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n  transition: background-color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n\n.hbd-table__body .hbd-table__row:hover {\n  background: var(--hbd-color-surface-subtle);\n}\n\n/* Selected row — color-mix gives a soft 8% action tint over the\n   default surface. The @supports fallback covers browsers without\n   color-mix; they get the plain subtle surface, which still reads as\n   \"selected\" against unselected rows. */\n.hbd-table__body .hbd-table__row.is-selected,\n.hbd-table__body .hbd-table__row.hbd-table__row--selected {\n  background: color-mix(\n    in srgb,\n    var(--hbd-color-surface-action) 8%,\n    var(--hbd-color-surface-default)\n  );\n}\n@supports not (color: color-mix(in srgb, red 50%, blue)) {\n  .hbd-table__body .hbd-table__row.is-selected,\n  .hbd-table__body .hbd-table__row.hbd-table__row--selected {\n    background: var(--hbd-color-surface-subtle);\n  }\n}\n\n.hbd-table__row--disabled {\n  opacity: 0.5;\n  pointer-events: none;\n}\n\n/* Striped rows — applied to even rows only. nth-child:even alternates\n   row backgrounds; selection + hover still win because their\n   selectors are more specific (class) than nth-child. */\n.hbd-table-wrap--striped .hbd-table__body .hbd-table__row:nth-child(even) {\n  background: var(--hbd-color-surface-subtle);\n}\n.hbd-table-wrap--striped .hbd-table__body .hbd-table__row:nth-child(even):hover {\n  background: var(--hbd-color-surface-raised);\n}\n\n/* ── 6 · Cells ────────────────────────────────────────────────────── */\n.hbd-table__cell {\n  padding: 0 var(--hbd-space-4);\n  vertical-align: middle;\n  color: var(--hbd-color-text-primary);\n  max-width: var(--hbd-space-32);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.hbd-table__cell--align-right  { text-align: right;  }\n.hbd-table__cell--align-center { text-align: center; }\n\n/* Roving-tabindex focus ring — the grid keyboard pattern keeps focus\n   on the currently active cell. The ring sits inside the cell box. */\n.hbd-table__cell:focus-visible,\n.hbd-table__header:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: calc(-1 * var(--hbd-border-width-thin));\n}\n\n/* ── 7 · Size modifiers ───────────────────────────────────────────── */\n.hbd-table-wrap--sm .hbd-table__body .hbd-table__row {\n  height: var(--hbd-table-row-height-sm);\n}\n.hbd-table-wrap--sm .hbd-table__cell {\n  padding: 0 var(--hbd-space-3);\n  font-size: var(--hbd-font-size-label);\n}\n.hbd-table-wrap--sm .hbd-table__header {\n  padding: 0 var(--hbd-space-3);\n  font-size: var(--hbd-font-size-micro);\n}\n\n.hbd-table-wrap--lg .hbd-table__body .hbd-table__row {\n  height: var(--hbd-table-row-height-lg);\n}\n\n/* ── 8 · Selection checkbox cell ──────────────────────────────────── */\n.hbd-table__check {\n  width: var(--hbd-space-12);\n  padding: 0 var(--hbd-space-3);\n  text-align: center;\n}\n.hbd-table__check input[type=\"checkbox\"] {\n  margin: 0;\n  vertical-align: middle;\n}\n\n/* ── 9 · Sticky first column ──────────────────────────────────────── */\n/* Sticks the first column to the left edge as the table scrolls.\n   Shadow + raised z-index give it a visible separation from the rest\n   of the row. The shadow uses --hbd-shadow-sm (token) — the previous\n   spec called for an rgba literal but the token already provides the\n   exact same warm-ink offset, so we reference it directly. */\n.hbd-table__header--sticky,\n.hbd-table__cell--sticky {\n  position: sticky;\n  left: 0;\n  z-index: calc(var(--hbd-z-raised) + 1);\n  background: inherit;\n  box-shadow: var(--hbd-shadow-sm);\n}\n/* Header cell that is BOTH a top-sticky header AND a left-sticky\n   first column needs the higher z so it sits on top of body cells\n   sticking left underneath it. */\n.hbd-table__head .hbd-table__header--sticky {\n  z-index: calc(var(--hbd-z-raised) + 2);\n}\n\n/* ── 10 · Empty state ─────────────────────────────────────────────── */\n.hbd-table__empty td {\n  text-align: center;\n  padding: var(--hbd-space-12);\n  color: var(--hbd-color-text-muted);\n  font-size: var(--hbd-font-size-body);\n  background: var(--hbd-color-surface-default);\n}\n\n/* ──────── tabs.css ──────── */\n/*\n * Here Be Dragons DS\n * tabs.css (de-shadowed from ds/styles/components/tabs.css)\n *\n * Tabs — first navigation component. Establishes the patterns Navbar,\n * Drawer, and Stepper Navigation will follow: tablist + roving tabindex\n * + active indicator + scrollable overflow.\n *\n * Notes:\n * - All values via --hbd-* tokens.\n * - Active tab colour uses --hbd-color-text-emphasis (blood) for on-page\n *   contrast; the spec's --hbd-color-action-default maps to surface-action\n *   (also blood) — same colour, but text-emphasis is the semantic match for\n *   \"emphatic text on parchment\". Active indicator uses surface-action\n *   directly (non-text contrast is OK for the line itself).\n * - Tab list border uses --hbd-color-border-strong (~11:1) for SC 1.4.11,\n *   same precedent as input borders. The spec's border-default would be\n *   ~2.06:1 and fail.\n * - Spec referenced --hbd-spacing-N; emitted tokens are --hbd-space-N.\n *\n * De-shadow note: the legacy WC was Light DOM, so the host `hbd-tabs`\n * display rules were merged onto the React root `.hbd-tabs` (which now\n * also carries the Radix Tabs.Root). No :host / ::slotted / ::part / slot\n * mappings were needed; the markup already used these BEM classes.\n */\n\n/* ── 1 · Block layout ─────────────────────────────────────────────── */\n\n/* The React root carries .hbd-tabs (Radix Tabs.Root). The legacy host's\n   block/width/min-width rules are merged here so the component participates\n   in its parent's layout instead of defaulting to inline. */\n.hbd-tabs {\n  display: flex;\n  flex-direction: column;\n  width: 100%;\n  /* min-width: 0 lets the tabs shrink to the parent's width instead of\n     pushing it wider when scrollable overflow occurs. Without this the\n     flex item's intrinsic min-content size wins and overflow leaks out\n     of the parent. */\n  min-width: 0;\n  max-width: 100%;\n  font-family: var(--hbd-font-family-ui);\n}\n.hbd-tabs--vertical {\n  flex-direction: row;\n  /* Vertical layout sized to the parent: width fills, height fills so\n     the vertical scrollable column can overflow within bounds. */\n  height: 100%;\n  min-height: 0;\n}\n\n/* List-wrap — the positioning context for the scroll buttons. The wrap\n   is a flex item of `.hbd-tabs`; on the horizontal-tabs path the parent\n   is flex-direction:column, so this item lays out in a column too and\n   we need to constrain its WIDTH (the cross axis here). On the\n   vertical-tabs path the parent is flex-direction:row, so the wrap is\n   a ROW item and we need to constrain its HEIGHT.\n\n   `width: 100%` plus `min-width: 0` (overrides default min-width:auto\n   which would expand to the widest single tab) is what lets horizontal\n   tabs scroll inside a constrained parent. Same idea on the Y axis for\n   vertical. */\n.hbd-tabs__list-wrap {\n  position: relative;\n  display: flex;\n  /* Horizontal tabs: take the full row width, allow shrink below\n     content size so scrollable overflow can happen. */\n  width: 100%;\n  min-width: 0;\n  /* Vertical tabs: this rule is inert because of the `auto` value, but\n     the `--vertical` override below replaces height/min-height. */\n  height: auto;\n  min-height: 0;\n  /* Belt-and-braces: even if the inner list refuses to honour its own\n     overflow (e.g. when an ancestor's flex layout fails to give it a\n     bounded width), the wrap itself clips so the tabs never visibly\n     escape the component box. */\n  overflow: hidden;\n}\n.hbd-tabs--vertical .hbd-tabs__list-wrap {\n  /* Vertical: the parent .hbd-tabs--vertical is flex-direction:row +\n     align-items:stretch, so this wrap stretches to the parent's full\n     height automatically. We additionally force flex-direction:column\n     inside so the scroll-prev/list/scroll-next stack vertically. */\n  flex-direction: column;\n  width: var(--hbd-tabs-vertical-min-width);\n  max-width: var(--hbd-tabs-vertical-min-width);\n  flex: 0 0 var(--hbd-tabs-vertical-min-width);\n  min-height: 0;\n  /* Stretch alignment from the parent (.hbd-tabs--vertical) does NOT\n     guarantee a determinate height for percent calculations inside;\n     align-self: stretch is the explicit version that does. */\n  align-self: stretch;\n}\n\n/* ── 2 · Tab list (tablist container) ─────────────────────────────── */\n/* The list sits on top of a thicker ink-coloured baseline so the unselected\n   tabs read as panels \"stacked\" behind the active one. The baseline uses\n   --hbd-border-width-thin (the next step up from hairline) for a stronger\n   visual seam between tabs and content. */\n.hbd-tabs__list {\n  display: flex;\n  flex-direction: row;\n  position: relative;\n  /* Fill the wrap on both axes so the wrap's bounds (set by its\n     flex sizing on .hbd-tabs__list-wrap) drive the visible area. The\n     `min-width: 0` undoes the default min-width:auto and lets overflow\n     happen — otherwise the list would refuse to shrink below its\n     content's intrinsic width. */\n  flex: 1 1 auto;\n  min-width: 0;\n  gap: var(--hbd-space-1);\n  padding: 0 var(--hbd-space-2);\n  border-bottom: var(--hbd-border-width-thin) solid var(--hbd-color-border-strong);\n}\n.hbd-tabs--vertical .hbd-tabs__list {\n  flex-direction: column;\n  border-bottom: none;\n  border-right: var(--hbd-border-width-thin) solid var(--hbd-color-border-strong);\n  min-width: var(--hbd-tabs-vertical-min-width);\n  padding: var(--hbd-space-2) 0;\n  /* Vertical axis: the list is a flex child of the wrap (which is\n     flex-direction:column in vertical mode). flex:1 1 0 makes it claim\n     the wrap's remaining main-axis space; min-height:0 lets the\n     content overflow on Y rather than expand the box. The base\n     .hbd-tabs__list rule's `flex: 1 1 auto` is on the X axis path —\n     we override here for the Y axis. */\n  flex: 1 1 0;\n  min-height: 0;\n  /* width MUST be auto/100% so the column doesn't try to size to its\n     content's intrinsic min-width. */\n  width: 100%;\n}\n\n/* Scrollable variant — hide native scrollbars; the JS-driven scroll\n   buttons take over. The axis follows the orientation: horizontal tabs\n   scroll along the X axis, vertical tabs along the Y axis. */\n.hbd-tabs--scrollable.hbd-tabs--horizontal .hbd-tabs__list {\n  overflow-x: auto;\n  overflow-y: hidden;\n  scrollbar-width: none;\n  -webkit-overflow-scrolling: touch;\n  /* Without an explicit max-width the inner flex content forces the list\n     to grow with its children. min-width:0 + max-width:100% keeps it\n     bounded by the wrap, which is bounded by the parent. */\n  max-width: 100%;\n  min-width: 0;\n}\n.hbd-tabs--scrollable.hbd-tabs--vertical .hbd-tabs__list {\n  overflow-x: hidden;\n  overflow-y: auto;\n  scrollbar-width: none;\n  -webkit-overflow-scrolling: touch;\n  /* Bound by the wrap; height comes from the parent container. */\n  max-height: 100%;\n  min-height: 0;\n}\n.hbd-tabs--scrollable .hbd-tabs__list::-webkit-scrollbar {\n  display: none;\n}\n\n/* ── 3 · Individual tab ───────────────────────────────────────────── */\n/* Each tab is a parchment-coloured panel with a manuscript-style top\n   border, rendered like a folder tab \"behind\" the active one. Inactive\n   tabs sit slightly below the baseline (border merges with the list's\n   bottom border); the active tab lifts out and \"covers\" the baseline\n   with a thicker top accent. */\n.hbd-tabs__tab {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--hbd-space-2);\n  padding: var(--hbd-space-3) var(--hbd-space-5, var(--hbd-space-4));\n  /* Visible card surface — subtle parchment background, ink border. */\n  background: var(--hbd-color-surface-subtle);\n  border: var(--hbd-border-width-hairline) solid var(--hbd-color-border-strong);\n  /* Pull the bottom edge OVER the list's baseline so inactive tabs\n     read as joined to it (no visible seam between tab bottom and list). */\n  border-bottom: none;\n  margin-bottom: calc(-1 * var(--hbd-border-width-thin));\n  /* Top corners rounded; bottom flat (sits flush with the baseline). */\n  border-radius: var(--hbd-radius-md) var(--hbd-radius-md) 0 0;\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-body);\n  font-weight: var(--hbd-font-weight-medium);\n  color: var(--hbd-color-text-muted);\n  cursor: pointer;\n  white-space: nowrap;\n  position: relative;\n  flex-shrink: 0;\n  transition: background-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              color var(--hbd-duration-fast) var(--hbd-ease-out),\n              border-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              transform var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n\n/* Top accent strip — inactive tabs have a muted gold-deep accent,\n   active tabs get a thicker blood accent (see .is-active below). The\n   ::before sits inside the tab and acts as the \"ribbon\" on top. */\n.hbd-tabs__tab::before {\n  content: \"\";\n  position: absolute;\n  left: calc(-1 * var(--hbd-border-width-hairline));\n  right: calc(-1 * var(--hbd-border-width-hairline));\n  top: calc(-1 * var(--hbd-border-width-hairline));\n  height: var(--hbd-tabs-indicator-height);\n  background: var(--hbd-color-gold-deep);\n  opacity: 0;\n  transition: opacity var(--hbd-duration-fast) var(--hbd-ease-out),\n              background-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              height var(--hbd-duration-fast) var(--hbd-ease-out);\n  border-radius: var(--hbd-radius-md) var(--hbd-radius-md) 0 0;\n}\n\n.hbd-tabs__tab:hover:not(.is-disabled):not(.is-active) {\n  background: var(--hbd-color-surface-raised);\n  color: var(--hbd-color-text-primary);\n}\n.hbd-tabs__tab:hover:not(.is-disabled)::before {\n  opacity: 1;\n}\n.hbd-tabs__tab:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: calc(-1 * var(--hbd-border-width-thin));\n  z-index: var(--hbd-z-raised);\n}\n\n/* Active tab — full surface treatment:\n   - background lifts to surface-default (the page colour) so the tab\n     looks like it's IN FRONT of the others\n   - thicker blood-coloured top ribbon\n   - text colour darkens to primary + semibold\n   - z-index lifts above the baseline so its bottom edge covers it\n   - small offset shadow to lift visually */\n.hbd-tabs__tab.is-active {\n  background: var(--hbd-color-surface-default);\n  color: var(--hbd-color-text-primary);\n  font-weight: var(--hbd-font-weight-semibold);\n  border-color: var(--hbd-color-border-strong);\n  z-index: var(--hbd-z-raised);\n}\n.hbd-tabs__tab.is-active::before {\n  opacity: 1;\n  height: calc(var(--hbd-tabs-indicator-height) * 1.5);\n  background: var(--hbd-color-surface-action);\n}\n\n.hbd-tabs__tab.is-disabled {\n  background: transparent;\n  color: var(--hbd-color-text-disabled);\n  border-color: var(--hbd-color-border-subtle);\n  cursor: not-allowed;\n  pointer-events: none;\n}\n\n/* Vertical orientation — same parchment-tab look, rotated 90°:\n   tabs sit to the LEFT of the baseline; their right edge merges with\n   the list's right border. Active accent moves to the left edge.   */\n.hbd-tabs--vertical .hbd-tabs__tab {\n  width: 100%;\n  justify-content: flex-start;\n  border-radius: var(--hbd-radius-md) 0 0 var(--hbd-radius-md);\n  border-right: none;\n  margin-bottom: 0;\n  margin-right: calc(-1 * var(--hbd-border-width-thin));\n}\n.hbd-tabs--vertical .hbd-tabs__tab::before {\n  /* Move the accent ribbon to the LEFT edge in vertical mode. */\n  left: calc(-1 * var(--hbd-border-width-hairline));\n  right: auto;\n  top: calc(-1 * var(--hbd-border-width-hairline));\n  bottom: calc(-1 * var(--hbd-border-width-hairline));\n  width: var(--hbd-tabs-indicator-width);\n  height: auto;\n  border-radius: var(--hbd-radius-md) 0 0 var(--hbd-radius-md);\n}\n.hbd-tabs--vertical .hbd-tabs__tab.is-active::before {\n  width: calc(var(--hbd-tabs-indicator-width) * 1.33);\n  height: auto;\n}\n\n/* ── 4 · Tab badge / count ────────────────────────────────────────── */\n.hbd-tabs__tab-badge {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-width: var(--hbd-space-4);\n  height: var(--hbd-space-4);\n  padding: 0 var(--hbd-space-1);\n  background: var(--hbd-color-surface-subtle);\n  border-radius: var(--hbd-radius-full);\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-micro);\n  font-weight: var(--hbd-font-weight-semibold);\n  color: var(--hbd-color-text-muted);\n}\n.hbd-tabs__tab.is-active .hbd-tabs__tab-badge {\n  background: var(--hbd-color-surface-action);\n  color: var(--hbd-color-text-on-action);\n}\n\n/* ── 5 · Scroll controls (scrollable variant) ─────────────────────── */\n/* Hidden by default; JS adds .is-visible when the tablist actually\n   overflows in that direction. */\n.hbd-tabs__scroll-prev,\n.hbd-tabs__scroll-next {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  width: var(--hbd-space-8);\n  display: none;\n  align-items: center;\n  justify-content: center;\n  background: linear-gradient(to right,\n    var(--hbd-color-surface-default),\n    transparent);\n  border: none;\n  cursor: pointer;\n  z-index: var(--hbd-z-raised);\n  color: var(--hbd-color-text-secondary);\n  transition: color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-tabs__scroll-prev { left: 0; }\n.hbd-tabs__scroll-next {\n  right: 0;\n  background: linear-gradient(to left,\n    var(--hbd-color-surface-default),\n    transparent);\n}\n\n/* Vertical scrollable — reposition the scroll buttons to top/bottom and\n   reorient the fade-gradient axis. */\n.hbd-tabs--vertical .hbd-tabs__scroll-prev,\n.hbd-tabs--vertical .hbd-tabs__scroll-next {\n  top: auto;\n  bottom: auto;\n  left: 0;\n  right: 0;\n  width: auto;\n  height: var(--hbd-space-6);\n}\n.hbd-tabs--vertical .hbd-tabs__scroll-prev {\n  top: 0;\n  background: linear-gradient(to bottom,\n    var(--hbd-color-surface-default),\n    transparent);\n}\n.hbd-tabs--vertical .hbd-tabs__scroll-next {\n  bottom: 0;\n  background: linear-gradient(to top,\n    var(--hbd-color-surface-default),\n    transparent);\n}\n.hbd-tabs__scroll-prev:hover,\n.hbd-tabs__scroll-next:hover {\n  color: var(--hbd-color-text-primary);\n}\n.hbd-tabs__scroll-prev:focus-visible,\n.hbd-tabs__scroll-next:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: calc(-1 * var(--hbd-border-width-thin));\n}\n\n.hbd-tabs--scrollable .hbd-tabs__scroll-prev.is-visible,\n.hbd-tabs--scrollable .hbd-tabs__scroll-next.is-visible {\n  display: flex;\n}\n\n/* ── 6 · Panels ───────────────────────────────────────────────────── */\n.hbd-tabs__panels {\n  flex: 1;\n  min-width: 0;\n}\n.hbd-tabs__panel {\n  display: none;\n  padding: var(--hbd-space-4) 0;\n}\n.hbd-tabs--vertical .hbd-tabs__panel {\n  padding: 0 0 0 var(--hbd-space-4);\n}\n.hbd-tabs__panel.is-active {\n  display: block;\n}\n.hbd-tabs__panel:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n/* ──────── textarea.css ──────── */\n/*\n * Here Be Dragons DS — textarea delta CSS\n * Ported from ds/styles/components/input.css (sections 2h, 2i, 2j).\n *\n * The textarea REUSES the shared .hbd-field chrome shipped by @hbd/input\n * (field wrapper, label, input-wrapper, base/state/size surface rules,\n * messages, footer-message colours). This file ships ONLY the\n * multiline-specific delta so the field chrome is never duplicated:\n *   - the textarea surface overrides (min/max-height, resize)\n *   - the auto-resize modifier\n *   - the footer row layout\n *   - the char-count warning / over-limit states\n *\n * Every value references a --hbd-* token (no hard-coded literals). These\n * selectors live in the light DOM (the source had no :host/::slotted/::part\n * constructs for the textarea delta), so no de-shadowing transform was\n * required beyond carrying the rules verbatim.\n */\n\n/* ── Textarea (multiline) — extends the shared input surface ─────────── */\n/* Inherits all base / state / size rules from the combined\n   .hbd-field__input,.hbd-field__textarea selectors provided by @hbd/input.\n   Only the multiline-specific properties are declared here. */\n.hbd-field__textarea {\n  min-height: var(--hbd-textarea-min-height);\n  max-height: var(--hbd-textarea-max-height);\n  resize: vertical;\n  overflow-y: auto;\n  line-height: var(--hbd-line-height-body);\n}\n\n/* Auto-resize: JS sizes the height inline; CSS only removes the manual\n   handle and the scrollbar so growth is seamless. */\n.hbd-field--autoresize .hbd-field__textarea {\n  resize: none;\n  overflow: hidden;\n  height: auto;\n}\n\n/* ── Footer row (hint/error/success + char-count) ───────────────────── */\n/* Allows the message to sit left and the counter to sit right. */\n.hbd-field__footer {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  gap: var(--hbd-space-2);\n}\n\n/* ── Character-count warning / over-limit states ────────────────────── */\n/* The status-*-text tokens are near-white (for text on a saturated\n   surface) and would be invisible on the parchment page, so on-page dark\n   colours are used instead. */\n.hbd-field__char-count--warning {\n  /* gold-deep (~5.6:1 on parchment) — AA-compliant warning tint */\n  color: var(--hbd-color-gold-deep);\n}\n.hbd-field__char-count--over {\n  /* text-emphasis (blood, ~12.8:1 on parchment) — AA-compliant over-limit tint */\n  color: var(--hbd-color-text-emphasis);\n  font-weight: var(--hbd-font-weight-medium);\n}\n\n/* ──────── time-picker.css ──────── */\n/*\n * Here Be Dragons DS — time-picker.css\n * Ported for React / light-DOM from ds/styles/components/time-picker.css.\n *\n * Time picker — keyboard-accessible scroll columns (hour / minute / AM·PM),\n * click-to-type hour header, Clear/Cancel/Confirm footer. Every value\n * references a --hbd-* token (defined in globals.css).\n *\n * No Shadow DOM here: the legacy element used Shadow DOM but the stylesheet\n * had no :host / ::slotted / ::part rules — every selector is already a plain\n * class — so the port is effectively verbatim. The inline absolutely-positioned\n * panel + max-height/opacity slide (driven by the .hbd-time-picker--open class\n * on the wrapper) is preserved exactly so the open/close animation lifecycle\n * runs in React unchanged. No absolute /paths.\n *\n * Cell/column heights are local custom properties composed from spacing tokens\n * (ITEM_H = 36px, COL_H = 180px = 5 rows).\n */\n\n.hbd-time-picker {\n  --tp-item-h: calc(var(--hbd-space-8) + var(--hbd-space-1)); /* 36px */\n  --tp-col-h: calc(var(--tp-item-h) * 5);                     /* 180px */\n  position: relative;\n  display: inline-block;\n  font-family: var(--hbd-font-family-display);\n}\n\n/* ── Trigger ────────────────────────────────────────────────────────── */\n.hbd-time-picker__trigger {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--hbd-space-2);\n  justify-content: space-between;\n  min-width: 11rem;\n  min-height: var(--hbd-space-12); /* 44px touch target (SC 2.5.8) */\n  padding: var(--hbd-space-2) var(--hbd-space-3);\n  background: var(--hbd-color-parchment-300);\n  /* border-strong (ink-700) so the active control boundary meets SC 1.4.11 (≥3:1) */\n  border: var(--hbd-border-width-hairline) solid var(--hbd-color-border-strong);\n  border-radius: var(--hbd-radius-md);\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-font-size-body);\n  color: var(--hbd-color-text-primary);\n  cursor: pointer;\n  transition: border-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              box-shadow var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-time-picker__trigger:hover {\n  border-color: var(--hbd-color-border-strong);\n}\n.hbd-time-picker__trigger:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n.hbd-time-picker--open .hbd-time-picker__trigger {\n  border-color: var(--hbd-color-input-focus-border);\n}\n.hbd-time-picker__trigger-label { flex: 1; text-align: left; white-space: nowrap; }\n.hbd-time-picker__trigger-label--placeholder { color: var(--hbd-color-text-muted); }\n/* CSS-drawn caret (no emoji): a downward triangle built from borders. */\n.hbd-time-picker__caret {\n  flex-shrink: 0;\n  width: 0;\n  height: 0;\n  border-left: var(--hbd-space-1) solid transparent;\n  border-right: var(--hbd-space-1) solid transparent;\n  border-top: var(--hbd-space-1) solid var(--hbd-color-text-muted);\n}\n\n/* ── Panel ──────────────────────────────────────────────────────────── */\n/* Slide-open animation: max-height + opacity, --hbd-duration-slow (350ms),\n   --hbd-ease-out — matches the select panel pattern. Requires the panel\n   <div> to persist across renders (it stays mounted in the React tree),\n   otherwise the transition cannot interpolate. Reduced-motion override in\n   globals.css collapses the transition to 0.01ms automatically. */\n.hbd-time-picker__panel {\n  position: absolute;\n  top: calc(100% + var(--hbd-space-1));\n  left: 0;\n  z-index: var(--hbd-z-dropdown);\n  min-width: 13.75rem;\n  background: var(--hbd-color-parchment-300);\n  border: var(--hbd-border-width-hairline) solid var(--hbd-color-border-strong);\n  border-radius: var(--hbd-radius-md);\n  box-shadow: var(--hbd-shadow-lg);\n  overflow: hidden;\n  /* Closed state: collapsed + invisible. */\n  max-height: 0;\n  opacity: 0;\n  pointer-events: none;\n  transition: max-height var(--hbd-duration-slow) var(--hbd-ease-out),\n              opacity var(--hbd-duration-slow) var(--hbd-ease-out);\n}\n.hbd-time-picker--open .hbd-time-picker__panel {\n  max-height: var(--hbd-time-picker-panel-max-height);\n  opacity: 1;\n  pointer-events: auto;\n}\n\n/* ── Header (current value + click-to-type hour) ────────────────────── */\n.hbd-time-picker__header {\n  display: flex;\n  align-items: baseline;\n  gap: var(--hbd-space-1);\n  padding: var(--hbd-space-2) var(--hbd-space-4);\n  background: var(--hbd-color-parchment-300);\n  border-bottom: var(--hbd-border-width-hairline) solid var(--hbd-color-parchment-400);\n}\n.hbd-time-picker__display-num {\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-font-size-2xl);\n  color: var(--hbd-color-text-primary);\n  line-height: var(--hbd-line-height-none);\n  font-variant-numeric: tabular-nums;\n}\n.hbd-time-picker__display-num--editable { cursor: pointer; border-bottom: var(--hbd-border-width-thin) solid transparent; }\n.hbd-time-picker__display-num--editable:hover { color: var(--hbd-color-gold-deep); border-bottom-color: var(--hbd-color-gold-deep); }\n.hbd-time-picker__display-sep { font-family: var(--hbd-font-family-display); font-size: var(--hbd-font-size-xl); color: var(--hbd-color-gold-deep); line-height: var(--hbd-line-height-none); }\n.hbd-time-picker__display-ampm {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-micro);\n  letter-spacing: var(--hbd-letter-spacing-widest);\n  color: var(--hbd-color-gold-deep);\n  margin-left: var(--hbd-space-2);\n  align-self: flex-end;\n}\n.hbd-time-picker__header-input {\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-font-size-2xl);\n  color: var(--hbd-color-text-secondary);\n  line-height: var(--hbd-line-height-none);\n  font-variant-numeric: tabular-nums;\n  background: transparent;\n  border: none;\n  border-bottom: var(--hbd-border-width-thin) solid var(--hbd-color-gold-deep);\n  outline: none;\n  width: 2.4ch;\n  padding: 0;\n  text-align: center;\n}\n\n/* ── Columns ────────────────────────────────────────────────────────── */\n.hbd-time-picker__columns {\n  display: flex;\n  border-bottom: var(--hbd-border-width-hairline) solid var(--hbd-color-parchment-400);\n}\n.hbd-time-picker__column { display: flex; flex-direction: column; flex: 1; }\n.hbd-time-picker__column-label {\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-font-size-micro);\n  letter-spacing: var(--hbd-letter-spacing-label);\n  text-transform: uppercase;\n  color: var(--hbd-color-gold-deep);\n  text-align: center;\n  padding: var(--hbd-space-2) var(--hbd-space-1) var(--hbd-space-1);\n  border-bottom: var(--hbd-border-width-hairline) solid var(--hbd-color-parchment-400);\n  background: var(--hbd-color-parchment-300);\n}\n.hbd-time-picker__scroll {\n  height: var(--tp-col-h);\n  overflow-y: auto;\n  overflow-x: hidden;\n  scrollbar-width: thin;\n  scrollbar-color: var(--hbd-color-parchment-400) var(--hbd-color-parchment-300);\n}\n.hbd-time-picker__scroll::-webkit-scrollbar { width: var(--hbd-space-1); }\n.hbd-time-picker__scroll::-webkit-scrollbar-track { background: var(--hbd-color-parchment-300); }\n.hbd-time-picker__scroll::-webkit-scrollbar-thumb { background: var(--hbd-color-parchment-400); }\n.hbd-time-picker__divider { width: var(--hbd-border-width-hairline); background: var(--hbd-color-parchment-400); flex-shrink: 0; }\n\n/* ── Cell ───────────────────────────────────────────────────────────── */\n.hbd-time-picker__cell {\n  height: var(--tp-item-h);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-font-size-body);\n  color: var(--hbd-color-text-primary);\n  cursor: pointer;\n  user-select: none;\n  transition: background-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-time-picker__cell:hover { background: var(--hbd-color-surface-subtle); }\n.hbd-time-picker__cell.is-selected,\n.hbd-time-picker__cell--selected {\n  background: var(--hbd-color-surface-action);\n  color: var(--hbd-color-text-on-action);\n}\n.hbd-time-picker__cell:focus-visible,\n.hbd-time-picker__cell.is-focused {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: calc(-1 * var(--hbd-border-width-thin));\n}\n\n/* ── AM/PM toggle ───────────────────────────────────────────────────── */\n.hbd-time-picker__ampm { display: flex; flex-direction: column; width: 3.25rem; flex-shrink: 0; }\n.hbd-time-picker__ampm-wrap {\n  height: var(--tp-col-h);\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  gap: var(--hbd-space-2);\n  padding: var(--hbd-space-2);\n}\n.hbd-time-picker__ampm-btn {\n  height: var(--tp-item-h);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-font-size-label);\n  letter-spacing: var(--hbd-letter-spacing-wide);\n  color: var(--hbd-color-text-secondary);\n  background: var(--hbd-color-surface-subtle);\n  border: var(--hbd-border-width-hairline) solid var(--hbd-color-parchment-400);\n  cursor: pointer;\n  transition: background-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-time-picker__ampm-btn:hover { color: var(--hbd-color-text-primary); }\n.hbd-time-picker__ampm-btn.is-active {\n  background: var(--hbd-color-surface-action);\n  border-color: var(--hbd-color-blood-deep);\n  color: var(--hbd-color-text-on-action);\n}\n.hbd-time-picker__ampm-btn:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n/* ── Footer ─────────────────────────────────────────────────────────── */\n.hbd-time-picker__footer {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: var(--hbd-space-2);\n  padding: var(--hbd-space-2) var(--hbd-space-3);\n  border-top: var(--hbd-border-width-hairline) solid var(--hbd-color-parchment-400);\n}\n.hbd-time-picker__clear {\n  background: none;\n  border: none;\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-font-size-label);\n  letter-spacing: var(--hbd-letter-spacing-wide);\n  text-transform: uppercase;\n  color: var(--hbd-color-text-muted);\n  cursor: pointer;\n  padding: var(--hbd-space-1) var(--hbd-space-2);\n  min-height: var(--hbd-space-12);\n  transition: color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-time-picker__clear:hover { color: var(--hbd-color-text-primary); }\n.hbd-time-picker__clear:focus-visible,\n.hbd-time-picker__cancel:focus-visible,\n.hbd-time-picker__confirm:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n/* Cancel — muted text button next to Confirm. Same visual weight as Clear,\n   sits on the right next to the prominent Confirm action. */\n.hbd-time-picker__cancel {\n  background: none;\n  border: none;\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-font-size-label);\n  letter-spacing: var(--hbd-letter-spacing-wide);\n  text-transform: uppercase;\n  color: var(--hbd-color-text-muted);\n  cursor: pointer;\n  padding: var(--hbd-space-1) var(--hbd-space-2);\n  min-height: var(--hbd-space-12);\n  transition: color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-time-picker__cancel:hover { color: var(--hbd-color-text-primary); }\n\n/* Right-side group: Cancel + Confirm clustered together. */\n.hbd-time-picker__footer-group {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--hbd-space-2);\n}\n.hbd-time-picker__confirm {\n  background: var(--hbd-color-surface-action);\n  border: none;\n  border-radius: var(--hbd-radius-sm);\n  box-shadow: var(--hbd-button-shadow-primary);\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-font-size-label);\n  font-weight: var(--hbd-font-weight-bold);\n  letter-spacing: var(--hbd-letter-spacing-button);\n  text-transform: uppercase;\n  color: var(--hbd-color-text-on-action);\n  cursor: pointer;\n  padding: var(--hbd-space-2) var(--hbd-space-4);\n  min-height: var(--hbd-space-12);\n  transition: box-shadow var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n\n/* ── Disabled / error ───────────────────────────────────────────────── */\n.hbd-time-picker--disabled .hbd-time-picker__trigger {\n  opacity: 0.5;\n  cursor: not-allowed;\n  pointer-events: none;\n  background: var(--hbd-color-surface-raised);\n}\n.hbd-time-picker--error .hbd-time-picker__trigger {\n  border-color: var(--hbd-color-status-error-surface);\n}\n/* error-message sits on the light page, so it uses a dark error colour\n   (status-error-text is parchment-50, for on-saturated-surface use only). */\n.hbd-time-picker__error-message {\n  display: block;\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  color: var(--hbd-color-blood);\n  margin-top: var(--hbd-space-1);\n}\n\n/* ──────── toast.css ──────── */\n/*\n * Here Be Dragons DS\n * styles/components/toast.css\n *\n * De-shadowed from ds/styles/components/toast.css. The legacy WC was already\n * a Light-DOM system (a singleton portal container + per-toast custom\n * elements), so there is no :host / ::slotted / ::part to flatten here — every\n * token-backed rule and ALL NINE @keyframes are carried over VERBATIM. The\n * React port renders the same .hbd-toast-container / .hbd-toast BEM markup\n * (via <ToastProvider> portal + useToast()/toast()), so these selectors match\n * 1:1. The only structural shift is the enter/leave state classes: the WC used\n * .is-entering / .is-leaving — those exact classes are preserved below.\n *\n * Toast is alert's floating, auto-dismissing sibling.\n * Alert lives in the document flow; toast floats at the viewport\n * edge inside a singleton portal container. A countdown progress\n * bar tells the user how much time remains; hovering or focusing\n * the toast pauses both the bar and the dismiss timer.\n *\n * Naming notes:\n * - Spec referenced --hbd-spacing-N — emitted tokens are --hbd-space-N.\n * - Spec asked for an animation literal \"100px\" max-height in the\n *   out keyframe; promoted to --hbd-toast-collapse-ceiling so the\n *   value lives in tokens.json. (Any real toast height fits under\n *   the ceiling; CSS cannot transition to/from auto, so a fixed\n *   open-state cap is required.)\n * - Spec referenced 3px progress-bar height; promoted to\n *   --hbd-toast-progress-height.\n *\n * Reduced motion: the global override in hbd-theme globals.css\n * collapses these animations + transitions to 0.01ms. The JS layer\n * also flips toasts to \"no auto-dismiss\" when the user prefers\n * reduced motion — see toast.tsx for SC 2.2.1 compliance notes.\n */\n\n/* ── 1 · Container — the viewport portal ──────────────────────────── */\n.hbd-toast-container {\n  position: fixed;\n  z-index: var(--hbd-z-toast);\n  display: flex;\n  flex-direction: column;\n  gap: var(--hbd-space-2);\n  /*\n   * pointer-events:none on the container so the portal does not\n   * intercept clicks on the page below. Individual toasts opt back\n   * into pointer events.\n   */\n  pointer-events: none;\n  padding: var(--hbd-space-4);\n  max-width: min(var(--hbd-toast-max-width), calc(100vw - var(--hbd-space-8)));\n  font-family: var(--hbd-font-family-ui);\n}\n\n/* Placement modifiers — each positions the portal at the viewport\n   edge and aligns toasts so they grow towards the centre of the\n   screen. Bottom variants reverse the flex direction so newer\n   toasts appear closest to the bottom edge. */\n.hbd-toast-container--top-right {\n  top: 0;\n  right: 0;\n  align-items: flex-end;\n}\n.hbd-toast-container--top-center {\n  top: 0;\n  left: 50%;\n  transform: translateX(-50%);\n  align-items: center;\n}\n.hbd-toast-container--bottom-right {\n  bottom: 0;\n  right: 0;\n  align-items: flex-end;\n  flex-direction: column-reverse;\n}\n.hbd-toast-container--bottom-center {\n  bottom: 0;\n  left: 50%;\n  transform: translateX(-50%);\n  align-items: center;\n  flex-direction: column-reverse;\n}\n.hbd-toast-container--bottom-left {\n  bottom: 0;\n  left: 0;\n  align-items: flex-start;\n  flex-direction: column-reverse;\n}\n\n/* ── 2 · Individual toast ─────────────────────────────────────────── */\n.hbd-toast {\n  pointer-events: auto;\n  display: flex;\n  align-items: flex-start;\n  gap: var(--hbd-space-2);\n  padding: var(--hbd-space-3);\n  /*\n   * Variant-saturated background + matching -text foreground —\n   * green for success, blue for info, gold for warning, blood for\n   * error. Contrast pairs are inherited from the F-02 status tokens\n   * (alert and callout use the same surfaces). The left border\n   * uses the deeper -border token from the same family so the rule\n   * reads as a sharper accent on the saturated fill.\n   */\n  border-radius: var(--hbd-radius-md);\n  box-shadow: var(--hbd-shadow-lg);\n  border-left: var(--hbd-border-width-thick) solid transparent;\n  position: relative;\n  overflow: hidden;\n  width: 100%;\n  max-width: 100%;\n}\n\n.hbd-toast--info {\n  background: var(--hbd-color-status-info-surface);\n  color: var(--hbd-color-status-info-text);\n  border-left-color: var(--hbd-color-status-info-border);\n}\n.hbd-toast--success {\n  background: var(--hbd-color-status-success-surface);\n  color: var(--hbd-color-status-success-text);\n  border-left-color: var(--hbd-color-status-success-border);\n}\n.hbd-toast--warning {\n  background: var(--hbd-color-status-warning-surface);\n  color: var(--hbd-color-status-warning-text);\n  border-left-color: var(--hbd-color-status-warning-border);\n}\n.hbd-toast--error {\n  background: var(--hbd-color-status-error-surface);\n  color: var(--hbd-color-status-error-text);\n  border-left-color: var(--hbd-color-status-error-border);\n}\n\n/* ── 3 · Icon ─────────────────────────────────────────────────────── */\n.hbd-toast__icon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  width: var(--hbd-space-4);\n  height: var(--hbd-space-4);\n  margin-top: var(--hbd-space-1);\n  /* color inherits from the host's variant -text token — the SVG\n     stroke uses currentColor so the icon always matches the toast\n     foreground regardless of variant. */\n  color: inherit;\n}\n.hbd-toast__icon svg {\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n\n/* ── 4 · Body and text ────────────────────────────────────────────── */\n.hbd-toast__body {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: var(--hbd-space-1);\n}\n\n.hbd-toast__title {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-body);\n  font-weight: var(--hbd-font-weight-semibold);\n  /* color inherits from the host's variant -text token. */\n  color: inherit;\n  margin: 0;\n  line-height: var(--hbd-line-height-snug);\n}\n\n.hbd-toast__content {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-body);\n  color: inherit;\n  margin: 0;\n  line-height: var(--hbd-line-height-body);\n}\n\n/* ── 5 · Action ───────────────────────────────────────────────────── */\n/*\n * Variant-coloured underline link/button — same role as the alert's\n * action. The colour comes from the variant's -text token so the\n * link reads as part of the status family, while the surrounding\n * body text stays neutral.\n */\n.hbd-toast__action {\n  margin-top: var(--hbd-space-2);\n  font-weight: var(--hbd-font-weight-semibold);\n  text-decoration: underline;\n  cursor: pointer;\n  background: none;\n  border: none;\n  padding: 0;\n  font-family: inherit;\n  font-size: inherit;\n  align-self: flex-start;\n  /* color inherits from the host's variant -text token; the action\n     therefore always has the same contrast as the body text on the\n     saturated variant surface. */\n  color: inherit;\n}\n\n.hbd-toast__action:focus-visible {\n  outline: var(--hbd-border-width-thin) solid currentColor;\n  outline-offset: var(--hbd-focus-offset);\n}\n\n/* ── 6 · Dismiss button ───────────────────────────────────────────── */\n.hbd-toast__dismiss {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  align-self: flex-start;\n  /*\n   * ≥44px touch target (SC 2.5.8) via min-size; visual glyph stays\n   * small. Negative margin compensates so the bigger hit-box doesn't\n   * inflate the toast's visual height — same trick as alert/callout.\n   */\n  min-width: var(--hbd-space-12);\n  min-height: var(--hbd-space-12);\n  margin: calc(-1 * var(--hbd-space-2)) calc(-1 * var(--hbd-space-2)) calc(-1 * var(--hbd-space-2)) 0;\n  padding: var(--hbd-space-1);\n  background: none;\n  border: none;\n  border-radius: var(--hbd-radius-sm);\n  /* color inherits from the host's variant -text token. */\n  color: inherit;\n  opacity: 0.85;\n  cursor: pointer;\n  transition: opacity var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-toast__dismiss:hover {\n  opacity: 1;\n}\n.hbd-toast__dismiss:focus-visible {\n  outline: var(--hbd-border-width-thin) solid currentColor;\n  outline-offset: var(--hbd-focus-offset);\n}\n.hbd-toast__dismiss svg {\n  width: var(--hbd-space-3);\n  height: var(--hbd-space-3);\n  display: block;\n}\n\n/* ── 7 · Progress bar ─────────────────────────────────────────────── */\n/*\n * Countdown bar at the bottom edge. Animation duration is set by\n * the React layer via an inline style — this is a documented inline-style\n * exception (per-instance value-driven property, same pattern as\n * the hbd-progress fill width). 30% opacity on currentColor keeps\n * the bar visible but subordinate to the toast content; it is\n * decorative and SC 1.4.11-exempt.\n */\n.hbd-toast__progress {\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  height: var(--hbd-toast-progress-height);\n  /* currentColor inherits the variant -text token, so the bar fades\n     against the saturated surface in the same hue as the body text. */\n  background: currentColor;\n  opacity: 0.3;\n  width: 100%;\n  transform-origin: left;\n  animation: hbd-toast-progress linear forwards;\n}\n\n@keyframes hbd-toast-progress {\n  from { transform: scaleX(1); }\n  to   { transform: scaleX(0); }\n}\n\n/* ── 8 · Enter / leave animations ─────────────────────────────────── */\n/*\n * Default enter/leave: slide from the right. Variants below swap\n * the X translation when the container sits on the left or in the\n * centre so the toast always slides in from off-screen.\n */\n@keyframes hbd-toast-in-right {\n  from { opacity: 0; transform: translateX(var(--hbd-space-8)); }\n  to   { opacity: 1; transform: translateX(0); }\n}\n@keyframes hbd-toast-out-right {\n  from {\n    opacity: 1;\n    transform: translateX(0);\n    max-height: var(--hbd-toast-collapse-ceiling);\n    margin-bottom: 0;\n  }\n  to {\n    opacity: 0;\n    transform: translateX(var(--hbd-space-8));\n    max-height: 0;\n    margin-bottom: calc(-1 * var(--hbd-space-2));\n  }\n}\n\n@keyframes hbd-toast-in-left {\n  from { opacity: 0; transform: translateX(calc(-1 * var(--hbd-space-8))); }\n  to   { opacity: 1; transform: translateX(0); }\n}\n@keyframes hbd-toast-out-left {\n  from {\n    opacity: 1;\n    transform: translateX(0);\n    max-height: var(--hbd-toast-collapse-ceiling);\n    margin-bottom: 0;\n  }\n  to {\n    opacity: 0;\n    transform: translateX(calc(-1 * var(--hbd-space-8)));\n    max-height: 0;\n    margin-bottom: calc(-1 * var(--hbd-space-2));\n  }\n}\n\n@keyframes hbd-toast-in-up {\n  from { opacity: 0; transform: translateY(calc(-1 * var(--hbd-space-4))); }\n  to   { opacity: 1; transform: translateY(0); }\n}\n@keyframes hbd-toast-out-up {\n  from {\n    opacity: 1;\n    transform: translateY(0);\n    max-height: var(--hbd-toast-collapse-ceiling);\n    margin-bottom: 0;\n  }\n  to {\n    opacity: 0;\n    transform: translateY(calc(-1 * var(--hbd-space-4)));\n    max-height: 0;\n    margin-bottom: calc(-1 * var(--hbd-space-2));\n  }\n}\n\n@keyframes hbd-toast-in-down {\n  from { opacity: 0; transform: translateY(var(--hbd-space-4)); }\n  to   { opacity: 1; transform: translateY(0); }\n}\n@keyframes hbd-toast-out-down {\n  from {\n    opacity: 1;\n    transform: translateY(0);\n    max-height: var(--hbd-toast-collapse-ceiling);\n    margin-bottom: 0;\n  }\n  to {\n    opacity: 0;\n    transform: translateY(var(--hbd-space-4));\n    max-height: 0;\n    margin-bottom: calc(-1 * var(--hbd-space-2));\n  }\n}\n\n/* Default: right-side slide. */\n.hbd-toast.is-entering {\n  animation: hbd-toast-in-right var(--hbd-duration-normal) var(--hbd-ease-out) forwards;\n}\n.hbd-toast.is-leaving {\n  animation: hbd-toast-out-right var(--hbd-duration-normal) var(--hbd-ease-out) forwards;\n}\n\n/* Left placement → slide from the left. */\n.hbd-toast-container--bottom-left .hbd-toast.is-entering {\n  animation-name: hbd-toast-in-left;\n}\n.hbd-toast-container--bottom-left .hbd-toast.is-leaving {\n  animation-name: hbd-toast-out-left;\n}\n\n/* Top-center → slide down from above. */\n.hbd-toast-container--top-center .hbd-toast.is-entering {\n  animation-name: hbd-toast-in-up;\n}\n.hbd-toast-container--top-center .hbd-toast.is-leaving {\n  animation-name: hbd-toast-out-up;\n}\n\n/* Bottom-center → slide up from below. */\n.hbd-toast-container--bottom-center .hbd-toast.is-entering {\n  animation-name: hbd-toast-in-down;\n}\n.hbd-toast-container--bottom-center .hbd-toast.is-leaving {\n  animation-name: hbd-toast-out-down;\n}\n\n/* ──────── toggle-group.css ──────── */\n/*\n * Here Be Dragons DS — toggle-group.css\n * Ported for React / light-DOM from the .hbd-toggle-group rules that lived\n * inside ds/styles/components/button.css.\n *\n * De-shadowed:\n *   `.hbd-toggle-group > hbd-button`            -> `.hbd-toggle-group > .hbd-button--in-group`\n *   `:host(.hbd-button--in-group) .hbd-button`  -> `.hbd-button--in-group` (the button IS the\n *                                                  in-group element in light DOM; no inner host).\n *   `:host(.hbd-button--in-group-vertical) ...` -> `.hbd-button--in-group-vertical`.\n *\n * Every value still references a --hbd-* token (defined in globals.css). 1:1 with the legacy look.\n */\n\n/* ── Toggle group ───────────────────────────────────────────────────── */\n/* Renders a single visually-joined control by stripping each button's own\n   border + radius (see .hbd-button--in-group rules below) and applying the\n   group's border + radius around the whole row. */\n.hbd-toggle-group {\n  display: inline-flex;\n  border: var(--hbd-border-width-hairline) solid var(--hbd-color-border-strong);\n  border-radius: var(--hbd-radius-md);\n  overflow: hidden;\n}\n.hbd-toggle-group > .hbd-button--in-group {\n  display: inline-flex;\n  /* Hairline separator between adjacent buttons inside the group. */\n  border-right: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n}\n.hbd-toggle-group > .hbd-button--in-group:last-child {\n  border-right: none;\n}\n\n/* Vertical orientation — separator on bottom instead of right. All\n   children stretch to the widest sibling so the column is a single\n   uniform stack (otherwise each row would shrink to its own label). */\n.hbd-toggle-group--vertical {\n  flex-direction: column;\n  align-items: stretch;\n}\n.hbd-toggle-group--vertical > .hbd-button--in-group {\n  border-right: none;\n  border-bottom: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n  width: 100%;\n}\n.hbd-toggle-group--vertical > .hbd-button--in-group:last-child {\n  border-bottom: none;\n}\n/* Stretch the in-group button to fill its column slot when vertical. */\n.hbd-button--in-group-vertical {\n  width: 100%;\n}\n\n/* ── In-group button overrides ──────────────────────────────────────── */\n/* Strip the button's own border + radius + offset shadow so the GROUP's\n   border is the only visible boundary. In the WC this lived inside each\n   button's shadow root as :host(.hbd-button--in-group) .hbd-button; in\n   light DOM the button element itself carries the marker class. */\n.hbd-button--in-group {\n  border-radius: 0;\n  border-width: 0;\n  box-shadow: none;\n}\n.hbd-button--in-group:active {\n  /* Suppress the translate-on-press inside a group — it would slide\n     individual buttons out of the joined row. Keep the colour change. */\n  transform: none;\n  box-shadow: none;\n}\n\n/* ──────── tooltip.css ──────── */\n/*\n * Here Be Dragons DS\n * registry/new-york/styles/components/tooltip.css\n *\n * Flattened from ds/styles/components/tooltip.css. The legacy WC rendered a\n * SINGLE shared .hbd-tooltip panel in <body> whose placement modifier + position\n * were mutated by hbd-tooltip.js for each active trigger. The React port renders\n * the panel per-instance via a Radix Tooltip portal; the styling is identical.\n *\n * De-shadow notes: the legacy tooltip was already Light DOM (no :host /\n * ::slotted / ::part), so the rules are carried verbatim. The only bridge is\n * the visibility flip: the WC toggled .hbd-tooltip--visible; Radix toggles\n * data-state=\"delayed-open\"/\"instant-open\"/\"closed\" on the content element. We\n * keep BOTH so the de-shadowed CSS renders the HBD look 1:1.\n *\n * Naming notes:\n * - Spec referenced --hbd-spacing-N — emitted tokens are --hbd-space-N.\n */\n\n/* ── 1 · Panel ────────────────────────────────────────────────────── */\n/* position:fixed (not absolute) so the tooltip is NEVER clipped by\n   an ancestor's overflow:hidden — the rect lives in viewport space.\n   Radix positions the portalled content with its own transform; we keep\n   the panel chrome identical to the legacy singleton. */\n.hbd-tooltip {\n  position: fixed;\n  top: 0;\n  left: 0;\n  z-index: var(--hbd-z-tooltip);\n  max-width: var(--hbd-tooltip-max-width);\n  padding: var(--hbd-space-1) var(--hbd-space-2);\n  background: var(--hbd-color-text-primary);\n  color: var(--hbd-color-text-inverse);\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-micro);\n  font-weight: var(--hbd-font-weight-regular);\n  line-height: var(--hbd-line-height-snug);\n  letter-spacing: var(--hbd-letter-spacing-normal);\n  text-transform: none;\n  border-radius: var(--hbd-radius-sm);\n  box-shadow: var(--hbd-shadow-md);\n  /* pointer-events:none keeps the tooltip from intercepting mouse\n     events on whatever sits beneath it. KNOWN LIMITATION (SC 1.4.13\n     \"Hoverable\"): the user cannot move the pointer onto the tooltip\n     itself without it dismissing. Acceptable here because tooltips\n     never contain interactive or selectable content by design. */\n  pointer-events: none;\n  white-space: normal;\n  word-wrap: break-word;\n  opacity: 0;\n  /* The visible/hidden flip is opacity-only — the panel stays in\n     the DOM. transition-property opacity so prefers-reduced-motion\n     can collapse it cleanly via the global motion override. */\n  transition: opacity var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n\n/* Legacy explicit visible class (kept verbatim) + the Radix open data-states\n   that drive the same opacity:1 flip. */\n.hbd-tooltip--visible,\n.hbd-tooltip[data-state=\"instant-open\"],\n.hbd-tooltip[data-state=\"delayed-open\"] {\n  opacity: 1;\n}\n\n/* ── 2 · Arrow ────────────────────────────────────────────────────── */\n/* The arrow is a CSS triangle: a zero-width/height box with a thick\n   coloured border on one side. The placement modifier on the panel\n   selects which side the arrow points from. */\n.hbd-tooltip__arrow {\n  position: absolute;\n  width: 0;\n  height: 0;\n  border: var(--hbd-tooltip-arrow-size) solid transparent;\n  pointer-events: none;\n}\n\n.hbd-tooltip--top .hbd-tooltip__arrow {\n  bottom: calc(-2 * var(--hbd-tooltip-arrow-size));\n  left: 50%;\n  transform: translateX(-50%);\n  border-top-color: var(--hbd-color-text-primary);\n}\n\n.hbd-tooltip--bottom .hbd-tooltip__arrow {\n  top: calc(-2 * var(--hbd-tooltip-arrow-size));\n  left: 50%;\n  transform: translateX(-50%);\n  border-bottom-color: var(--hbd-color-text-primary);\n}\n\n.hbd-tooltip--left .hbd-tooltip__arrow {\n  right: calc(-2 * var(--hbd-tooltip-arrow-size));\n  top: 50%;\n  transform: translateY(-50%);\n  border-left-color: var(--hbd-color-text-primary);\n}\n\n.hbd-tooltip--right .hbd-tooltip__arrow {\n  left: calc(-2 * var(--hbd-tooltip-arrow-size));\n  top: 50%;\n  transform: translateY(-50%);\n  border-right-color: var(--hbd-color-text-primary);\n}\n\n/* ── 3 · Content ──────────────────────────────────────────────────── */\n.hbd-tooltip__content {\n  display: inline;\n}\n\n",
