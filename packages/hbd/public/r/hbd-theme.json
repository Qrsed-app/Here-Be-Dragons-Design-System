ehavior: contain;\n  color: var(--hbd-color-text-primary);\n  font-size: var(--hbd-font-size-body);\n  line-height: var(--hbd-line-height-body);\n}\n\n/* ── 7 · Footer ───────────────────────────────────────────────────── */\n.hbd-modal__footer {\n  display: flex;\n  gap: var(--hbd-space-2);\n  justify-content: flex-end;\n  flex-wrap: wrap;\n  padding: var(--hbd-space-3) var(--hbd-space-6) var(--hbd-space-4);\n  border-top: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n  flex-shrink: 0;\n}\n\n/* When nothing is slotted into the footer the JS sets data-empty so\n   the row + its separator collapse out of the way. */\n.hbd-modal__footer[data-empty=\"true\"] {\n  display: none;\n}\n\n/* ──────── navbar.css ──────── */\n/*\n * Here Be Dragons DS\n * styles/components/navbar.css\n *\n * De-shadowed from ds/styles/components/navbar.css. The legacy WC was a\n * Light-DOM custom element (NOT Shadow DOM), so there were no :host /\n * ::slotted / ::part rules to rewrite — every selector below is carried\n * over verbatim, including the .is-open state class and EVERY token ref.\n *\n * Primary top navigation bar. Logo on the left, nav links in the centre,\n * actions on the right. Below the mobile breakpoint the nav collapses\n * into a hamburger that opens a full-height drawer-style menu.\n *\n * Notes:\n * - All values via --hbd-* tokens, with one documented exception: the\n *   media-query value 768px appears as a literal because CSS @media\n *   queries cannot consume CSS custom properties. The same value is\n *   exposed as --hbd-navbar-mobile-breakpoint for JS to read.\n * - Active link text uses --hbd-color-text-emphasis (blood) for on-page\n *   contrast — the spec's --hbd-color-action-default also resolves to\n *   blood, but text-emphasis is the semantic match for \"emphatic text\n *   on parchment\".\n * - Spec referenced --hbd-spacing-N; emitted tokens are --hbd-space-N.\n * - The React port renders the mobile menu via a portal to document.body\n *   (the WC kept it as a direct child of the host, but position:fixed +\n *   inset:0 makes the two equivalent). The .is-open class is applied to\n *   the portalled menu root so its transform/visibility reveal matches.\n */\n\n/* ── 1 · Wrapper ──────────────────────────────────────────────────── */\n.hbd-navbar {\n  display: block;\n  width: 100%;\n  height: var(--hbd-navbar-height);\n  background: var(--hbd-color-surface-default);\n  box-shadow: var(--hbd-shadow-sm);\n  z-index: var(--hbd-z-sticky);\n}\n.hbd-navbar--sticky {\n  position: sticky;\n  top: 0;\n}\n.hbd-navbar--transparent {\n  background: transparent;\n  box-shadow: none;\n}\n.hbd-navbar--bordered {\n  box-shadow: none;\n  border-bottom: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n}\n\n/* ── 2 · Inner container ──────────────────────────────────────────── */\n.hbd-navbar__inner {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  height: 100%;\n  max-width: var(--hbd-layout-container-max-width);\n  margin: 0 auto;\n  padding: 0 var(--hbd-layout-container-padding);\n  gap: var(--hbd-space-4);\n}\n\n/* ── 3 · Logo / brand area ────────────────────────────────────────── */\n.hbd-navbar__logo {\n  display: flex;\n  align-items: center;\n  flex-shrink: 0;\n  gap: var(--hbd-space-2);\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-font-size-h3);\n  font-weight: var(--hbd-font-weight-bold);\n  letter-spacing: var(--hbd-letter-spacing-display);\n  color: var(--hbd-color-text-primary);\n  text-decoration: none;\n}\n/* Slotted anchor tags get the logo styling automatically. */\n.hbd-navbar__logo a {\n  color: inherit;\n  text-decoration: none;\n  display: inline-flex;\n  align-items: center;\n  gap: var(--hbd-space-2);\n}\n.hbd-navbar__logo a:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n  border-radius: var(--hbd-radius-sm);\n}\n\n/* ── 4 · Desktop nav (hidden on mobile by default) ────────────────── */\n.hbd-navbar__nav {\n  display: none;\n}\n\n.hbd-navbar__link {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--hbd-space-1);\n  padding: var(--hbd-space-2) var(--hbd-space-3);\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-body);\n  font-weight: var(--hbd-font-weight-medium);\n  color: var(--hbd-color-text-secondary);\n  text-decoration: none;\n  border-radius: var(--hbd-radius-md);\n  transition: color var(--hbd-duration-fast) var(--hbd-ease-out),\n              background-color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-navbar__link:hover {\n  color: var(--hbd-color-text-primary);\n  background: var(--hbd-color-surface-subtle);\n}\n.hbd-navbar__link.is-active {\n  color: var(--hbd-color-text-emphasis);\n  background: var(--hbd-color-surface-subtle);\n  font-weight: var(--hbd-font-weight-semibold);\n}\n.hbd-navbar__link:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n/* ── 5 · Actions ──────────────────────────────────────────────────── */\n.hbd-navbar__actions {\n  display: flex;\n  align-items: center;\n  gap: var(--hbd-space-2);\n  flex-shrink: 0;\n}\n\n/* ── 6 · Hamburger (visible on mobile by default) ─────────────────── */\n.hbd-navbar__hamburger {\n  display: inline-flex;\n}\n\n/* ── 7 · Mobile menu ──────────────────────────────────────────────── */\n/* Full-viewport sliding panel with the same focus-trap + scroll-lock\n   semantics as <hbd-drawer>. Below the breakpoint it sits off-canvas\n   to the left and slides in when .is-open is added. */\n.hbd-navbar__mobile-menu {\n  position: fixed;\n  inset: 0;\n  z-index: var(--hbd-z-modal);\n  display: flex;\n  flex-direction: column;\n  background: var(--hbd-color-surface-default);\n  box-shadow: var(--hbd-shadow-xl);\n  transform: translateX(-100%);\n  transition: transform var(--hbd-duration-normal) var(--hbd-ease-out);\n  /* aria-hidden=true initially; JS flips it on open. visibility:hidden\n     also keeps the off-canvas panel out of the accessibility tree. */\n  visibility: hidden;\n}\n.hbd-navbar.is-open .hbd-navbar__mobile-menu,\n.hbd-navbar__mobile-menu.is-open {\n  transform: translateX(0);\n  visibility: visible;\n}\n\n.hbd-navbar__mobile-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--hbd-space-3);\n  height: var(--hbd-navbar-height);\n  padding: 0 var(--hbd-layout-container-padding);\n  border-bottom: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n  flex-shrink: 0;\n}\n\n.hbd-navbar__mobile-nav {\n  display: flex;\n  flex-direction: column;\n  gap: var(--hbd-space-1);\n  padding: var(--hbd-space-4);\n  flex: 1;\n  min-height: 0;\n  overflow-y: auto;\n  overscroll-behavior: contain;\n}\n\n.hbd-navbar__mobile-link {\n  display: flex;\n  align-items: center;\n  gap: var(--hbd-space-2);\n  width: 100%;\n  padding: var(--hbd-space-3) var(--hbd-space-4);\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-body);\n  font-weight: var(--hbd-font-weight-medium);\n  color: var(--hbd-color-text-secondary);\n  text-decoration: none;\n  border-radius: var(--hbd-radius-md);\n  /* min-height meets SC 2.5.8 touch target. */\n  min-height: var(--hbd-input-min-height);\n  transition: color var(--hbd-duration-fast) var(--hbd-ease-out),\n              background-color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-navbar__mobile-link:hover {\n  color: var(--hbd-color-text-primary);\n  background: var(--hbd-color-surface-subtle);\n}\n.hbd-navbar__mobile-link.is-active {\n  color: var(--hbd-color-text-emphasis);\n  background: var(--hbd-color-surface-subtle);\n  font-weight: var(--hbd-font-weight-semibold);\n}\n.hbd-navbar__mobile-link:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n.hbd-navbar__mobile-actions {\n  display: flex;\n  flex-direction: column;\n  gap: var(--hbd-space-2);\n  padding: var(--hbd-space-3) var(--hbd-space-4);\n  border-top: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n  flex-shrink: 0;\n}\n/* Hide the mobile-actions row when there's nothing slotted into it. */\n.hbd-navbar__mobile-actions:empty {\n  display: none;\n}\n\n/* ── 8 · Desktop breakpoint ───────────────────────────────────────── */\n/* The 768px literal mirrors --hbd-navbar-mobile-breakpoint. CSS @media\n   queries cannot consume custom properties — the navbar JS reads the\n   token for its own resize-handling so the two stay in sync. */\n@media (min-width: 768px) {\n  .hbd-navbar__nav {\n    display: flex;\n    align-items: center;\n    gap: var(--hbd-space-1);\n    flex: 1;\n    justify-content: center;\n  }\n  .hbd-navbar__hamburger {\n    display: none;\n  }\n  .hbd-navbar__mobile-menu {\n    /* Force the off-canvas panel hidden on desktop — even if the JS\n       didn't clean up .is-open on a fast resize, the media query wins. */\n    display: none;\n  }\n}\n\n/* ──────── otp-input.css ──────── */\n/* ── OTP input (one-time password) ──────────────────────────────────────\n   Ported from ds/styles/components/input.css (§2q · OTP input).\n   A row of single-character inputs for verification codes. Reuses the\n   .hbd-field label / hint / error / footer scaffolding from @hbd/input;\n   the cells live inside .hbd-otp__cells. Cell size meets SC 2.5.8 (the\n   cell-size token exceeds the touch-target minimum). All values reference\n   var(--hbd-*) tokens supplied by @hbd/hbd-theme. No shadow DOM — the\n   original :host-scoped rules already targeted plain class selectors. */\n\n.hbd-otp-field {\n  display: flex;\n  flex-direction: column;\n  gap: var(--hbd-space-2);\n}\n\n.hbd-otp__cells {\n  display: flex;\n  align-items: center;\n  gap: var(--hbd-otp-gap);\n}\n\n/* Optional inline separator (e.g. between two groups of three cells). */\n.hbd-otp__separator {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-h3);\n  color: var(--hbd-color-text-muted);\n  padding: 0 var(--hbd-space-1);\n  user-select: none;\n}\n\n.hbd-otp__cell {\n  width: var(--hbd-otp-cell-size);\n  height: var(--hbd-otp-cell-size);\n  text-align: center;\n  font-family: var(--hbd-font-family-mono);\n  font-size: var(--hbd-font-size-h3);\n  font-weight: var(--hbd-font-weight-semibold);\n  color: var(--hbd-color-text-primary);\n  background: var(--hbd-color-surface-default);\n  /* border-strong (ink-700, ~11.4:1 on parchment) — same SC 1.4.11\n     precedent as the other input borders. border-default would be ~2.06:1. */\n  border: var(--hbd-border-width-thin) solid var(--hbd-color-border-strong);\n  border-radius: var(--hbd-radius-md);\n  outline: none;\n  caret-color: var(--hbd-color-surface-action);\n  padding: 0;\n  appearance: none;\n  -webkit-appearance: none;\n  transition: border-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              background-color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-otp__cell:hover {\n  border-color: var(--hbd-color-border-strong);\n}\n.hbd-otp__cell:focus-visible {\n  border-color: var(--hbd-color-input-focus-border);\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n/* Filled cell: subtle background to mark the cell as occupied. */\n.hbd-otp__cell.is-filled {\n  background: var(--hbd-color-surface-subtle);\n}\n\n/* Field-level error / disabled / success — wrap-level modifier classes\n   apply to every cell within the row. */\n.hbd-otp-field--error .hbd-otp__cell {\n  border-color: var(--hbd-color-status-error-border);\n  color: var(--hbd-color-text-emphasis);\n}\n.hbd-otp-field--error .hbd-otp__cell:focus-visible {\n  border-color: var(--hbd-color-status-error-border);\n  outline-color: var(--hbd-color-status-error-border);\n}\n.hbd-otp-field--disabled .hbd-otp__cell {\n  opacity: 0.5;\n  cursor: not-allowed;\n  pointer-events: none;\n}\n.hbd-otp-field--success .hbd-otp__cell.is-filled {\n  border-color: var(--hbd-color-status-success-border);\n}\n/* Tint the typed characters to match the success message colour\n   (forest-700 — same on-page-dark green used by .hbd-field__success). */\n.hbd-otp-field--success .hbd-otp__cell {\n  color: var(--hbd-color-forest-700);\n}\n\n/* ──────── pagination.css ──────── */\n/*\n * Here Be Dragons DS\n * pagination.css (de-shadowed for the shadcn registry)\n *\n * Numbered page-navigation control with prev/next + ellipsis. Three\n * variants: full (numbered), compact (\"Page N of M\"), simple (arrows\n * only). The source WC is already Light-DOM so there is no :host /\n * ::slotted / ::part to flatten — these selectors target the legacy\n * .hbd-* BEM classes the React markup emits verbatim.\n *\n * Notes:\n * - All values via --hbd-* tokens.\n * - Spec referenced --hbd-color-action-default / -action-text; emitted\n *   tokens are --hbd-color-surface-action / --hbd-color-text-on-action.\n * - Spec referenced --hbd-spacing-N; emitted tokens are --hbd-space-N.\n */\n\n/* ── 1 · Wrapper ──────────────────────────────────────────────────── */\n/* Two display modes:\n   • Plain (no toolbar): host is an inline-flex row of items.\n   • Toolbar (info / goto / page-size present): host becomes a block\n     so the inner .hbd-pagination__toolbar can use its full-width\n     three-column layout. React adds .hbd-pagination--has-toolbar in\n     that case. */\n.hbd-pagination {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--hbd-space-1);\n  flex-wrap: wrap;\n  font-family: var(--hbd-font-family-ui);\n}\n.hbd-pagination--has-toolbar {\n  display: block;\n  width: 100%;\n}\n\n.hbd-pagination__list {\n  display: flex;\n  align-items: center;\n  gap: var(--hbd-space-1);\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n\n.hbd-pagination__item {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n/* ── 2 · Page link / number ───────────────────────────────────────── */\n.hbd-pagination__link {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--hbd-pagination-item-size);\n  height: var(--hbd-pagination-item-size);\n  padding: 0;\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  font-weight: var(--hbd-font-weight-medium);\n  color: var(--hbd-color-text-secondary);\n  background: transparent;\n  border: var(--hbd-border-width-hairline) solid transparent;\n  border-radius: var(--hbd-radius-md);\n  cursor: pointer;\n  text-decoration: none;\n  user-select: none;\n  transition: background-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              color var(--hbd-duration-fast) var(--hbd-ease-out),\n              border-color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-pagination__link:hover {\n  background: var(--hbd-color-surface-subtle);\n  color: var(--hbd-color-text-primary);\n}\n.hbd-pagination__link:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n/* Current page — solid action fill, non-interactive. The\n   background/colour properties are TRANSITIONED so swapping the\n   .is-active class to a different page crossfades the highlight\n   between cells instead of snapping. */\n.hbd-pagination__link {\n  /* Already defined above; this rule extends the transition list so\n     the transition applies to the active-state pair too. The base\n     selector's transition still wins for layered properties — adding\n     transform here covers the page-change zoom below. */\n  transition: background-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              color var(--hbd-duration-fast) var(--hbd-ease-out),\n              border-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              transform var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-pagination__link.is-active,\n.hbd-pagination__link[aria-current=\"page\"] {\n  background: var(--hbd-color-surface-action);\n  color: var(--hbd-color-text-on-action);\n  border-color: var(--hbd-color-blood-deep);\n  font-weight: var(--hbd-font-weight-semibold);\n  cursor: default;\n  pointer-events: none;\n}\n\n/* Page-change pop — React adds .is-just-activated to the new current\n   page after the slide-in. The pop runs at --hbd-duration-slow so it\n   lands alongside the slide rather than ahead of it. */\n.hbd-pagination__link.is-just-activated {\n  animation: hbd-pagination-pop var(--hbd-duration-slow) var(--hbd-ease-out);\n}\n@keyframes hbd-pagination-pop {\n  0%   { transform: scale(0.85); opacity: 0.5; }\n  60%  { transform: scale(1.08); opacity: 1; }\n  100% { transform: scale(1);    opacity: 1; }\n}\n\n/* Page-number carousel — only the page numbers (and any ellipses)\n   slide; Prev / Next stay anchored on the outer list. The wrap has a\n   FIXED width (computed via the --_pages-width custom property)\n   so Prev/Next never shift, regardless of which page is current or\n   how many cells the range algorithm produces.\n\n   The wrap is positioned + overflow-hidden so cells sliding from\n   beyond the visible area are clipped instead of pushing the row. */\n.hbd-pagination__pages-wrap {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  overflow: hidden;\n  /* Width is set inline as --_pages-width; the fallback covers\n     the rare case where it hasn't been computed yet. */\n  width: var(--_pages-width, auto);\n  flex-shrink: 0;\n}\n.hbd-pagination__pages {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--hbd-space-1);\n  list-style: none;\n  padding: 0;\n  margin: 0;\n  /* The inner list fills the fixed-width wrap so its content centres. */\n  width: 100%;\n}\n\n/* Carousel slide — only the .hbd-pagination__pages list moves. Runs at\n   --hbd-duration-slower (500ms) with a generous travel distance so the\n   motion reads as a deliberate slide, not a snap.\n   prefers-reduced-motion collapses this to ~0ms via the global\n   motion override in hbd-theme globals.css. */\n.hbd-pagination.is-paging-forward .hbd-pagination__pages {\n  animation: hbd-pagination-slide-forward var(--hbd-duration-slower) var(--hbd-ease-out);\n}\n.hbd-pagination.is-paging-backward .hbd-pagination__pages {\n  animation: hbd-pagination-slide-backward var(--hbd-duration-slower) var(--hbd-ease-out);\n}\n@keyframes hbd-pagination-slide-forward {\n  from { transform: translateX(var(--hbd-space-12)); opacity: 0; }\n  to   { transform: translateX(0); opacity: 1; }\n}\n@keyframes hbd-pagination-slide-backward {\n  from { transform: translateX(calc(-1 * var(--hbd-space-12))); opacity: 0; }\n  to   { transform: translateX(0); opacity: 1; }\n}\n\n/* ── 3 · Prev / next / first / last ───────────────────────────────── */\n/* Icon-only square chevrons across all variants — no text labels.\n   Same dimensions as a page-number cell so the row reads as one\n   consistent strip. */\n.hbd-pagination__prev,\n.hbd-pagination__next {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--hbd-space-1);\n  width: var(--hbd-pagination-item-size);\n  height: var(--hbd-pagination-item-size);\n  padding: 0;\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  font-weight: var(--hbd-font-weight-medium);\n  color: var(--hbd-color-text-secondary);\n  background: transparent;\n  border: var(--hbd-border-width-hairline) solid transparent;\n  border-radius: var(--hbd-radius-md);\n  cursor: pointer;\n  text-decoration: none;\n  user-select: none;\n  transition: background-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              color var(--hbd-duration-fast) var(--hbd-ease-out),\n              border-color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-pagination__prev:hover,\n.hbd-pagination__next:hover {\n  background: var(--hbd-color-surface-subtle);\n  color: var(--hbd-color-text-primary);\n}\n.hbd-pagination__prev:focus-visible,\n.hbd-pagination__next:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n/* Boundary disabled state. Kept FOCUSABLE per SC awareness — the\n   visible disabled treatment + aria-disabled=\"true\" tells SR + keyboard\n   users the boundary is reachable but inactive. */\n.hbd-pagination__prev.is-disabled,\n.hbd-pagination__next.is-disabled,\n.hbd-pagination__prev[aria-disabled=\"true\"],\n.hbd-pagination__next[aria-disabled=\"true\"] {\n  color: var(--hbd-color-text-disabled);\n  cursor: not-allowed;\n  background: transparent;\n}\n/* (Simple-variant Prev/Next sizing is now handled by the base rule\n   above — all variants render Prev/Next/First/Last as square icons.) */\n\n/* Arrow SVG sizing — wrapped in a span for a consistent box. */\n.hbd-pagination__icon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--hbd-space-3);\n  height: var(--hbd-space-3);\n}\n\n/* ── 4 · Ellipsis ─────────────────────────────────────────────────── */\n.hbd-pagination__ellipsis {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--hbd-pagination-item-size);\n  height: var(--hbd-pagination-item-size);\n  color: var(--hbd-color-text-muted);\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  cursor: default;\n  user-select: none;\n}\n\n/* ── 5 · Compact label ────────────────────────────────────────────── */\n.hbd-pagination__label {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  color: var(--hbd-color-text-secondary);\n  white-space: nowrap;\n  padding: 0 var(--hbd-space-2);\n}\n\n/* ── 6 · Extended toolbar — info-group / nav / goto ───────────────── */\n/* Three-column row: info+page-size cluster on the LEFT, the page nav\n   in the CENTRE, the goto field on the RIGHT. Each slot has a min/max\n   width so changing pages (and the digit counts in the info text)\n   doesn't shift the nav cluster. */\n/* Three-column grid: [start | center | end]. Grid gives each column\n   its OWN track that side content cannot invade. The centre track is\n   auto-sized to the nav's natural width; the sides share remaining\n   space equally and can shrink past their content's intrinsic width\n   (min-width:0). This was previously a 3-way flex layout that allowed\n   the start cluster's content to render UNDER the centred nav because\n   space-between only distributes leftover space — it doesn't reserve\n   tracks. */\n.hbd-pagination__toolbar {\n  display: grid;\n  /* Three tracks:\n     • start  — flexible, soaks up leftover horizontal space, pushing\n                the nav cluster to the right of centre.\n     • center — auto-sized to the nav's natural width.\n     • end    — auto-sized to the goto cluster's natural width (no\n                empty trailing space inside its track).\n     The end column sits at the right edge naturally because the start\n     column claims all leftover space. */\n  grid-template-columns: 1fr auto auto;\n  align-items: center;\n  width: 100%;\n  /* Tight inter-column gap so info / nav / goto fit on one line. */\n  column-gap: var(--hbd-space-2);\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  color: var(--hbd-color-text-secondary);\n}\n.hbd-pagination__toolbar-start,\n.hbd-pagination__toolbar-end {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--hbd-space-2);\n  /* min-width:0 lets the cluster shrink to fit its grid track. We\n     CANNOT use overflow:hidden here — that would clip the page-size\n     dropdown's popover panel when it opens. The auto-sized end track\n     (grid-template-columns: 1fr auto auto) means the end column is\n     never wider than its content, so there's no risk of leakage into\n     the centre column even without overflow clipping. */\n  min-width: 0;\n}\n.hbd-pagination__toolbar-end {\n  /* End column auto-sizes to its content (no leftover track to fill),\n     so flex alignment is irrelevant — but flex-end is still the safe\n     default if the column does receive extra space (e.g. responsive\n     overrides). */\n  justify-content: flex-end;\n}\n.hbd-pagination__toolbar-center {\n  display: inline-flex;\n  align-items: center;\n  /* Carousel width is already fixed by --_pages-width on the wrap;\n     this track auto-sizes around it. */\n}\n\n/* Combined \"Showing 1–10 of 240 · Show [select] per page\" group. */\n.hbd-pagination__info-group {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--hbd-space-2);\n  white-space: nowrap;\n  /* No reserved minimum — the toolbar must fit on one line, and\n     tabular-nums on the info text keeps the digit width stable\n     anyway so there's no layout twitch when paging through. */\n}\n.hbd-pagination__sep {\n  color: var(--hbd-color-text-muted);\n  /* No extra padding — the info-group's own gap already provides\n     breathing room. */\n  padding: 0;\n  user-select: none;\n}\n\n/* \"Showing 21–30 of 240\" info text. Inline-block + min-width so the\n   text doesn't reflow when digit widths grow/shrink between pages. */\n.hbd-pagination__info {\n  display: inline-block;\n  white-space: nowrap;\n  color: var(--hbd-color-text-secondary);\n  /* font-variant-numeric: tabular-nums keeps the digit advance equal\n     across glyphs so the string width is stable for a given format. */\n  font-variant-numeric: tabular-nums;\n}\n\n/* Page-size group: \"Show [select] per page\". */\n.hbd-pagination__page-size {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--hbd-space-1);\n  white-space: nowrap;\n}\n.hbd-pagination__page-size-label {\n  cursor: pointer;\n}\n\n/* hbd-select used as the page-size dropdown — given a FIXED width\n   so changing the value (10 → 100) or opening/closing the panel\n   doesn't shift the surrounding text. The .hbd-select--flat modifier\n   (defined in input.css) suppresses the chip-pill styling so the\n   select reads as a plain inline dropdown. */\n.hbd-pagination__page-size .hbd-select {\n  width: 5rem;\n  flex-shrink: 0;\n}\n\n/* Goto group: \"Go to page [input] Go\". Tight gap — the label + input\n   + button read as one connected control. */\n.hbd-pagination__goto {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--hbd-space-1);\n  white-space: nowrap;\n}\n.hbd-pagination__goto-input {\n  /* Narrower than before (1.5× cell vs 2×) so the goto cluster\n     consumes less horizontal space inside the single-line toolbar. */\n  width: calc(var(--hbd-pagination-item-size) * 1.5);\n  height: var(--hbd-pagination-item-size);\n  padding: 0 var(--hbd-space-1);\n  font-family: var(--hbd-font-family-mono);\n  font-size: var(--hbd-font-size-label);\n  font-weight: var(--hbd-font-weight-medium);\n  color: var(--hbd-color-text-primary);\n  background: var(--hbd-color-surface-default);\n  border: var(--hbd-input-border-width) solid var(--hbd-color-border-strong);\n  border-radius: var(--hbd-radius-md);\n  text-align: center;\n  /* Remove native number spin arrows so the field reads as a single\n     compact entry slot. */\n  -moz-appearance: textfield;\n}\n.hbd-pagination__goto-input::-webkit-outer-spin-button,\n.hbd-pagination__goto-input::-webkit-inner-spin-button {\n  -webkit-appearance: none;\n  margin: 0;\n}\n.hbd-pagination__goto-input:focus-visible {\n  border-color: var(--hbd-color-input-focus-border);\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n.hbd-pagination__goto-go {\n  /* Override the inherited square chevron sizing — the \"Go\" text needs\n     hugging padding, not a square item-size cell, so the goto cluster\n     stays compact inside the toolbar's right column. */\n  width: auto;\n  padding: 0 var(--hbd-space-2);\n}\n\n/* First / Last buttons — same base styling as Prev/Next via classes\n   added on render; the dedicated selectors below give them an\n   icon-size visual treatment. */\n.hbd-pagination__first,\n.hbd-pagination__last {\n  /* Inherit the same shape + transitions as Prev/Next. */\n}\n\n/* ──────── popover.css ──────── */\n/*\n * Here Be Dragons DS\n * styles/components/popover.css\n *\n * De-shadowed from ds/styles/components/popover.css. The legacy WC was a\n * Light-DOM custom element that built its own floating panel and wrote\n * top/left from JS. This React port drives positioning with Radix Popover\n * (floating-ui under the hood), so the panel coordinates come from Radix's\n * inline transform instead of JS top/left — but EVERY token-backed visual\n * rule below is carried over verbatim.\n *\n * Click-triggered floating panel containing interactive content.\n * Tooltip's interactive sibling — popover holds buttons/forms/links and\n * traps focus while open, where tooltip is passive and pointer-events\n * are disabled.\n *\n * Naming notes:\n * - Spec referenced --hbd-spacing-N — emitted tokens are --hbd-space-N.\n * - Arrow is a single-colour CSS triangle (surface-raised). Trade-off:\n *   the panel border doesn't extend over the arrow's tip. Acceptable\n *   given the arrow is tiny and aspect-correct against the strong\n *   shadow; a fully-bordered arrow would need two stacked triangles\n *   and isn't worth the complexity here.\n *\n * Class bridging (Radix):\n * - .hbd-popover--{placement} is emitted from the React side off Radix's\n *   resolved data-side, so the legacy placement modifiers and their arrow\n *   rules render identically. The visible/enter transition is driven by\n *   Radix data-state=\"open\" mapped onto .hbd-popover--visible, matching\n *   the WC's deferred-class reveal.\n */\n\n/* ── 1 · Panel ────────────────────────────────────────────────────── */\n/* position:fixed so the panel is never clipped by an ancestor's\n   overflow:hidden — Radix sets the floating coordinates via its wrapper. */\n.hbd-popover {\n  position: relative;\n  z-index: var(--hbd-z-dropdown);\n  min-width: var(--hbd-popover-min-width);\n  max-width: var(--hbd-popover-max-width);\n  background: var(--hbd-color-surface-raised);\n  border: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n  border-radius: var(--hbd-radius-lg);\n  box-shadow: var(--hbd-shadow-lg);\n  opacity: 0;\n  pointer-events: none;\n  transform: translateY(var(--hbd-space-1));\n  transition: opacity var(--hbd-duration-fast) var(--hbd-ease-out),\n              transform var(--hbd-duration-fast) var(--hbd-ease-out);\n  font-family: var(--hbd-font-family-ui);\n}\n\n/* Placement-specific entry transforms — each direction slides in\n   from the side the trigger sits on. */\n.hbd-popover--top {\n  transform: translateY(calc(-1 * var(--hbd-space-1)));\n}\n.hbd-popover--left {\n  transform: translateX(calc(-1 * var(--hbd-space-1)));\n}\n.hbd-popover--right {\n  transform: translateX(var(--hbd-space-1));\n}\n\n/* Shown state — resets transform and opacity, enables interaction. */\n.hbd-popover--visible {\n  opacity: 1;\n  pointer-events: auto;\n  transform: translateY(0);\n}\n.hbd-popover--top.hbd-popover--visible,\n.hbd-popover--left.hbd-popover--visible,\n.hbd-popover--right.hbd-popover--visible {\n  transform: none;\n}\n\n/* Radix bridge — the resolved data-side (after collision flip) and\n   data-state are authoritative, so mirror them onto the legacy modifiers\n   for placement-specific arrow + enter transform without relying on a\n   stale React render. */\n.hbd-popover[data-side=\"top\"] { transform: translateY(calc(-1 * var(--hbd-space-1))); }\n.hbd-popover[data-side=\"left\"] { transform: translateX(calc(-1 * var(--hbd-space-1))); }\n.hbd-popover[data-side=\"right\"] { transform: translateX(var(--hbd-space-1)); }\n.hbd-popover[data-state=\"open\"] {\n  opacity: 1;\n  pointer-events: auto;\n  transform: translateY(0);\n}\n.hbd-popover[data-side=\"top\"][data-state=\"open\"],\n.hbd-popover[data-side=\"left\"][data-state=\"open\"],\n.hbd-popover[data-side=\"right\"][data-state=\"open\"] {\n  transform: none;\n}\n\n/* ── 2 · Arrow ────────────────────────────────────────────────────── */\n.hbd-popover__arrow {\n  position: absolute;\n  width: 0;\n  height: 0;\n  border: var(--hbd-popover-arrow-size) solid transparent;\n  pointer-events: none;\n}\n\n.hbd-popover--top .hbd-popover__arrow {\n  bottom: calc(-2 * var(--hbd-popover-arrow-size));\n  left: 50%;\n  transform: translateX(-50%);\n  border-top-color: var(--hbd-color-surface-raised);\n}\n.hbd-popover--bottom .hbd-popover__arrow {\n  top: calc(-2 * var(--hbd-popover-arrow-size));\n  left: 50%;\n  transform: translateX(-50%);\n  border-bottom-color: var(--hbd-color-surface-raised);\n}\n.hbd-popover--left .hbd-popover__arrow {\n  right: calc(-2 * var(--hbd-popover-arrow-size));\n  top: 50%;\n  transform: translateY(-50%);\n  border-left-color: var(--hbd-color-surface-raised);\n}\n.hbd-popover--right .hbd-popover__arrow {\n  left: calc(-2 * var(--hbd-popover-arrow-size));\n  top: 50%;\n  transform: translateY(-50%);\n  border-right-color: var(--hbd-color-surface-raised);\n}\n\n/* Radix data-side bridge for the arrow (mirrors the modifier rules above\n   so the arrow tracks the resolved side after a collision flip). Radix's\n   own arrow is suppressed; this CSS triangle is the HBD arrow. */\n.hbd-popover[data-side=\"top\"] .hbd-popover__arrow {\n  bottom: calc(-2 * var(--hbd-popover-arrow-size));\n  left: 50%;\n  transform: translateX(-50%);\n  border-top-color: var(--hbd-color-surface-raised);\n}\n.hbd-popover[data-side=\"bottom\"] .hbd-popover__arrow {\n  top: calc(-2 * var(--hbd-popover-arrow-size));\n  left: 50%;\n  transform: translateX(-50%);\n  border-bottom-color: var(--hbd-color-surface-raised);\n}\n.hbd-popover[data-side=\"left\"] .hbd-popover__arrow {\n  right: calc(-2 * var(--hbd-popover-arrow-size));\n  top: 50%;\n  transform: translateY(-50%);\n  border-left-color: var(--hbd-color-surface-raised);\n}\n.hbd-popover[data-side=\"right\"] .hbd-popover__arrow {\n  left: calc(-2 * var(--hbd-popover-arrow-size));\n  top: 50%;\n  transform: translateY(-50%);\n  border-right-color: var(--hbd-color-surface-raised);\n}\n\n/* ── 3 · Header ───────────────────────────────────────────────────── */\n.hbd-popover__header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--hbd-space-2);\n  padding: var(--hbd-space-3) var(--hbd-space-4) var(--hbd-space-2);\n  border-bottom: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n}\n\n.hbd-popover__title {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  font-weight: var(--hbd-font-weight-semibold);\n  color: var(--hbd-color-text-primary);\n  margin: 0;\n  line-height: var(--hbd-line-height-snug);\n}\n\n/* Close button — uses hbd-button icon-only chrome via the component\n   when authored, but the CSS below covers the bare close-icon case\n   too. The button is positioned by the flex layout above. */\n.hbd-popover__close {\n  flex-shrink: 0;\n}\n\n/* ── 4 · Body ─────────────────────────────────────────────────────── */\n.hbd-popover__body {\n  padding: var(--hbd-space-3) var(--hbd-space-4);\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-body);\n  color: var(--hbd-color-text-primary);\n  line-height: var(--hbd-line-height-body);\n  overflow-y: auto;\n  max-height: 60vh;\n}\n\n/* ── 5 · Footer ───────────────────────────────────────────────────── */\n.hbd-popover__footer {\n  display: flex;\n  gap: var(--hbd-space-2);\n  justify-content: flex-end;\n  padding: var(--hbd-space-2) var(--hbd-space-4) var(--hbd-space-3);\n  border-top: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n  flex-wrap: wrap;\n}\n\n/* ──────── progress.css ──────── */\n/*\n * Here Be Dragons DS — progress.css\n * Ported for React / light-DOM from ds/styles/components/progress.css.\n * The WC was already light DOM (no :host / ::slotted / ::part), so every\n * selector, token ref, and @keyframes is preserved verbatim. 1:1 with the\n * legacy look. The fill's inline `width` (and segment fill count) is the one\n * documented inline-style exception, supplied from the component's style prop.\n *\n * Naming notes (carried from the source):\n * - --hbd-color-surface-action is the canonical \"filled\" colour pair.\n * - Status surfaces: --hbd-color-status-{success,warning,error}-surface.\n * - --hbd-duration-slow is 350ms (the \"deliberate\" timing).\n *\n * Reduced motion: handled globally by hbd-theme globals.css. The\n * indeterminate shimmer + striped scroll both collapse to 0.01ms via the\n * @media (prefers-reduced-motion: reduce) override there.\n */\n\n/* ── 1 · Wrapper ──────────────────────────────────────────────────── */\n.hbd-progress {\n  display: flex;\n  flex-direction: column;\n  gap: var(--hbd-space-1);\n  width: 100%;\n  font-family: var(--hbd-font-family-ui);\n}\n\n/* ── 2 · Label row ────────────────────────────────────────────────── */\n.hbd-progress__label-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: baseline;\n  gap: var(--hbd-space-3);\n}\n\n.hbd-progress__label {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  font-weight: var(--hbd-font-weight-medium);\n  color: var(--hbd-color-text-primary);\n}\n\n.hbd-progress__value {\n  font-family: var(--hbd-font-family-mono);\n  font-size: var(--hbd-font-size-label);\n  color: var(--hbd-color-text-muted);\n  font-variant-numeric: tabular-nums;\n}\n\n/* ── 3 · Track ────────────────────────────────────────────────────── */\n.hbd-progress__track {\n  width: 100%;\n  height: var(--hbd-progress-height);\n  background: var(--hbd-color-surface-subtle);\n  border-radius: var(--hbd-radius-full);\n  overflow: hidden;\n  position: relative;\n}\n\n.hbd-progress--sm .hbd-progress__track { height: var(--hbd-progress-height-sm); }\n.hbd-progress--lg .hbd-progress__track { height: var(--hbd-progress-height-lg); }\n\n/* ── 4 · Fill ─────────────────────────────────────────────────────── */\n/* The fill's inline `width` is the one documented inline-style\n   exception for this component — width is a value-driven property\n   that the author updates at runtime, and a CSS variable would force\n   every author to also write inline style to set it. The TRANSITION\n   that smooths the change is tokenised here so author code only sets\n   the new width. */\n.hbd-progress__fill {\n  height: 100%;\n  background: var(--hbd-color-surface-action);\n  border-radius: var(--hbd-radius-full);\n  width: 0%;\n  transition: width var(--hbd-duration-slow) var(--hbd-ease-out);\n}\n\n.hbd-progress--success .hbd-progress__fill {\n  background: var(--hbd-color-status-success-surface);\n}\n.hbd-progress--warning .hbd-progress__fill {\n  background: var(--hbd-color-status-warning-surface);\n}\n.hbd-progress--error .hbd-progress__fill {\n  background: var(--hbd-color-status-error-surface);\n}\n\n/* ── 5 · Striped fill ─────────────────────────────────────────────── */\n/* rgba(255,255,255, 0.15) is the documented permitted exception — a\n   semi-transparent white overlay for the diagonal stripe pattern can't\n   be expressed as a single token without losing the alpha layer. The\n   overlay reads as a soft highlight on every variant's fill colour. */\n.hbd-progress--striped .hbd-progress__fill {\n  background-image: repeating-linear-gradient(\n    45deg,\n    transparent,\n    transparent var(--hbd-space-2),\n    rgba(255, 255, 255, 0.15) var(--hbd-space-2),\n    rgba(255, 255, 255, 0.15) var(--hbd-space-4)\n  );\n  background-size: var(--hbd-space-8) var(--hbd-space-8);\n  animation: hbd-progress-stripe var(--hbd-duration-slow) linear infinite;\n}\n\n@keyframes hbd-progress-stripe {\n  from { background-position: var(--hbd-space-8) 0; }\n  to   { background-position: 0 0; }\n}\n\n/* ── 6 · Indeterminate ────────────────────────────────────────────── */\n/* The fill is a 40%-wide chip that slides from off-screen left to\n   off-screen right and repeats. The 350% end translation is a\n   calculated layout value — it equals (track-width / fill-width) - 1,\n   i.e. (100/40) - 1 = 1.5 in normal terms, expressed as 250% then\n   +100% offset to fully clear the right edge. This literal cannot be\n   tokenised; it is a documented animation keyframe constant. */\n.hbd-progress--indeterminate .hbd-progress__fill {\n  width: 40%;\n  animation: hbd-progress-indeterminate 1.5s var(--hbd-ease-in-out) infinite;\n}\n\n@keyframes hbd-progress-indeterminate {\n  0%   { transform: translateX(-100%); }\n  100% { transform: translateX(350%); }\n}\n\n/* ── 7 · Segmented ────────────────────────────────────────────────── */\n.hbd-progress__segments {\n  display: flex;\n  gap: var(--hbd-space-1);\n  width: 100%;\n}\n\n.hbd-progress__segment {\n  flex: 1;\n  height: var(--hbd-progress-height);\n  background: var(--hbd-color-surface-subtle);\n  border-radius: var(--hbd-radius-full);\n  transition: background-color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n\n.hbd-progress--sm .hbd-progress__segment {\n  height: var(--hbd-progress-height-sm);\n}\n.hbd-progress--lg .hbd-progress__segment {\n  height: var(--hbd-progress-height-lg);\n}\n\n.hbd-progress__segment.is-filled {\n  background: var(--hbd-color-surface-action);\n}\n.hbd-progress--success .hbd-progress__segment.is-filled {\n  background: var(--hbd-color-status-success-surface);\n}\n.hbd-progress--warning .hbd-progress__segment.is-filled {\n  background: var(--hbd-color-status-warning-surface);\n}\n.hbd-progress--error .hbd-progress__segment.is-filled {\n  background: var(--hbd-color-status-error-surface);\n}\n\n/* ──────── radio-group.css ──────── */\n/*\n * Here Be Dragons DS — radio-group.css\n * Ported for React (Radix RadioGroup) from ds/components/hbd-radio-group.js +\n * the radio-group section of ds/styles/components/input.css, plus the shared\n * label/hint rules from ds/styles/components/checkbox.css.\n *\n * The source WC rendered into a Shadow DOM but used no ::slotted/::part/:host\n * selectors — its rules were already plain class selectors. This file\n * transcribes them 1:1 into the consumer's light DOM. Every value still\n * references a --hbd-* token (defined in globals.css).\n *\n * Focus model note: the legacy WC drew the focus ring from a native\n * <input type=\"radio\"> via the adjacent-sibling selector\n * `.hbd-radio__input:focus-visible + .hbd-radio__control`. The Radix port\n * makes the control itself the focusable element (a Radix RadioGroupItem\n * button), so the ring rule targets `.hbd-radio__control:focus-visible`\n * directly — same visual outcome, same token.\n */\n\n/* ── Field wrapper (shared field message rules) ─────────────────────── */\n.hbd-field__hint,\n.hbd-field__error {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  line-height: var(--hbd-line-height-body);\n}\n.hbd-field__hint {\n  color: var(--hbd-color-text-muted);\n  display: block;\n}\n.hbd-field__error {\n  /* text-emphasis (blood, ~12.8:1 on parchment) — AA-compliant dark red */\n  color: var(--hbd-color-text-emphasis);\n  display: none;\n}\n.hbd-field--error .hbd-field__error { display: block; }\n.hbd-field--error .hbd-field__hint  { display: none; }\n\n/* ── Radio group ────────────────────────────────────────────────────── */\n/* Radio groups are the primary unit — a lone radio is invalid. The group\n   wrapper uses a real <fieldset> + <legend> for native semantics; the\n   individual .hbd-radio reuses the checkbox visually-hidden-input pattern\n   with a circular control + inner dot. */\n\n.hbd-radio-group {\n  display: flex;\n  flex-direction: column;\n  gap: var(--hbd-space-1);\n  border: none;\n  padding: 0;\n  margin: 0;\n  font-family: var(--hbd-font-family-ui);\n}\n.hbd-radio-group__legend {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-body);\n  font-weight: var(--hbd-font-weight-semibold);\n  color: var(--hbd-color-text-primary);\n  margin-bottom: var(--hbd-space-2);\n  padding: 0;\n}\n.hbd-radio-group__options {\n  display: flex;\n  flex-direction: column;\n  gap: var(--hbd-space-3);\n}\n.hbd-radio-group__options--horizontal {\n  flex-direction: row;\n  flex-wrap: wrap;\n  gap: var(--hbd-space-4);\n}\n\n.hbd-radio-group__hint {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  color: var(--hbd-color-text-muted);\n  margin-top: var(--hbd-space-1);\n}\n.hbd-radio-group__error {\n  /* text-emphasis (blood, ~12.8:1 on parchment) — AA-compliant on-page\n     error tint. status-error-text resolves to parchment-50 (near-white)\n     and would be invisible here; same on-page-dark precedent as the\n     input/textarea/select messages. */\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  color: var(--hbd-color-text-emphasis);\n  margin-top: var(--hbd-space-1);\n  display: none;\n}\n.hbd-radio-group--error .hbd-radio-group__error { display: block; }\n.hbd-radio-group--error .hbd-radio-group__hint  { display: none; }\n\n/* Individual radio — same wrapper shape + hidden-input pattern as\n   .hbd-checkbox. */\n.hbd-radio {\n  position: relative;\n  display: inline-flex;\n  align-items: flex-start;\n  gap: var(--hbd-space-2);\n  cursor: pointer;\n}\n.hbd-radio__input {\n  position: absolute;\n  width: var(--hbd-border-width-hairline);\n  height: var(--hbd-border-width-hairline);\n  margin: calc(-1 * var(--hbd-border-width-hairline));\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n/* Visible control — circular, with an inner dot that scales in on check.\n   In the Radix port the control IS the focusable RadioGroupItem button, so\n   it carries no default button chrome. */\n.hbd-radio__control {\n  position: relative;\n  flex-shrink: 0;\n  width: var(--hbd-space-4);\n  height: var(--hbd-space-4);\n  margin: 0;\n  /* border-strong (ink-700, ~11.4:1 on parchment) meets SC 1.4.11 — same\n     precedent as the input border. */\n  border: var(--hbd-border-width-thin) solid var(--hbd-color-border-strong);\n  border-radius: var(--hbd-radius-full);\n  background: var(--hbd-color-surface-default);\n  padding: 0;\n  transition: background-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              border-color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-radio__control::after {\n  content: '';\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  width: calc(var(--hbd-space-2) - var(--hbd-border-width-thin));\n  height: calc(var(--hbd-space-2) - var(--hbd-border-width-thin));\n  border-radius: var(--hbd-radius-full);\n  background: var(--hbd-color-text-on-action);\n  transform: translate(-50%, -50%) scale(0);\n  transition: transform var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n\n/* Checked — filled action background + inner dot scales in. In the Radix\n   port the checked state is driven by the item's data-state=\"checked\"\n   attribute (equivalent to the legacy .hbd-radio--checked modifier class,\n   which is also matched so an authored/SSR class still works). */\n.hbd-radio--checked .hbd-radio__control,\n.hbd-radio__control[data-state=\"checked\"] {\n  background: var(--hbd-color-surface-action);\n  border-color: var(--hbd-color-surface-action);\n}\n.hbd-radio--checked .hbd-radio__control::after,\n.hbd-radio__control[data-state=\"checked\"]::after {\n  transform: translate(-50%, -50%) scale(1);\n}\n\n/* Hover — only when the radio isn't disabled. */\n.hbd-radio:not(.hbd-radio--disabled):hover .hbd-radio__control {\n  border-color: var(--hbd-color-border-strong);\n}\n\n/* Focus ring — the control is the focusable element in the Radix port. */\n.hbd-radio__control:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n/* Disabled — visual + cursor only. */\n.hbd-radio--disabled,\n.hbd-radio:has(.hbd-radio__control:disabled) {\n  cursor: not-allowed;\n  opacity: 0.5;\n  pointer-events: none;\n}\n.hbd-radio--disabled .hbd-radio__label,\n.hbd-radio:has(.hbd-radio__control:disabled) .hbd-radio__label {\n  color: var(--hbd-color-text-disabled);\n  cursor: not-allowed;\n}\n\n/* Error — radios inside an errored group get a tinted border, and each\n   option's label matches the error message colour for visual consistency. */\n.hbd-radio-group--error .hbd-radio__control {\n  border-color: var(--hbd-color-status-error-surface);\n}\n.hbd-radio-group--error .hbd-radio__label {\n  color: var(--hbd-color-text-emphasis);\n}\n\n/* Vertical stack for the per-option label + optional hint. */\n.hbd-radio__label-wrap {\n  display: flex;\n  flex-direction: column;\n  gap: var(--hbd-space-1);\n}\n\n/* ── Label + hint (shared with .hbd-checkbox + .hbd-switch in the DS;\n   carried here so the radio port is self-contained) ─────────────────── */\n.hbd-radio__label {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-body);\n  color: var(--hbd-color-text-primary);\n  line-height: var(--hbd-line-height-body);\n  cursor: pointer;\n}\n.hbd-radio__hint {\n  display: block;\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  color: var(--hbd-color-text-muted);\n  margin-top: var(--hbd-space-1);\n}\n\n/* ──────── select.css ──────── */\n/*\n * Here Be Dragons DS — select delta CSS\n * Ported from ds/styles/components/input.css (section 2k · Select) and the\n * select panel/option/group rules.\n *\n * The select REUSES the shared .hbd-field chrome shipped by @hbd/input\n * (field wrapper, label, input-wrapper, the base/state/size .hbd-field__select-trigger\n * surface rules, messages, footer). This file ships ONLY the select-specific\n * delta so the field chrome is never duplicated:\n *   - the trigger flex layout + chevron\n *   - the selected-value chip + clear (×) affordance\n *   - the floating dropdown panel + slide animation\n *   - option groups, option rows, the selected check\n *   - the hidden native <select> fallback\n *   - the flat-select modifier (used by pagination)\n *\n * De-shadowing: the source used `:host(.hbd-select--flat) y` to match the\n * host element from inside its shadow root. In the light DOM, the modifier\n * class lives on the .hbd-select block element, so those rules become the\n * plain descendant selectors `.hbd-select--flat y`. No ::slotted / ::part\n * constructs were present. Every value references a --hbd-* token.\n */\n\n/* ── Select (custom) — extends the shared field surface ────────── */\n/* Inherits base / hover / focus / size / state rules from the combined\n   .hbd-field__input,.hbd-field__textarea,.hbd-field__select-trigger\n   selectors in input.css. Only select-specific properties live below. */\n\n/* Trigger button: lay out value + chevron horizontally. */\n.hbd-field__select-trigger {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  cursor: pointer;\n  user-select: none;\n  min-height: var(--hbd-input-min-height);\n  text-align: left;\n}\n\n/* Chevron icon — flips when the panel is open. */\n.hbd-field__select-chevron {\n  flex-shrink: 0;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--hbd-color-text-muted);\n  transition: transform var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-field--open .hbd-field__select-chevron {\n  transform: rotate(180deg);\n}\n\n/* Selected value display.\n   - Placeholder mode: plain muted text, truncated.\n   - Selected mode: styled as a DS chip (parchment-300 bg, ink-brown border,\n     display font, offset shadow) — matches the manuscript tag/badge pattern\n     used elsewhere in the system. */\n.hbd-field__select-value {\n  flex: 1;\n  min-width: 0; /* allow ellipsis inside flex */\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.hbd-field__select-value--placeholder {\n  color: var(--hbd-color-text-muted);\n}\n.hbd-field__select-value--chip {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--hbd-space-1);\n  align-self: center;\n  flex: 0 1 auto;\n  max-width: 100%;\n  padding: var(--hbd-space-1) var(--hbd-space-1) var(--hbd-space-1) var(--hbd-space-2);\n  background: var(--hbd-color-surface-raised);\n  border: var(--hbd-border-width-hairline) solid var(--hbd-color-border-ink-brown);\n  border-radius: var(--hbd-radius-sm);\n  box-shadow: var(--hbd-border-width-hairline) var(--hbd-border-width-hairline) 0 var(--hbd-color-parchment-400);\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-font-size-label);\n  letter-spacing: var(--hbd-letter-spacing-wider);\n  color: var(--hbd-color-text-primary);\n}\n/* Chip label text — truncates if the chip is wider than its container. */\n.hbd-field__select-chip-label {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  min-width: 0;\n}\n\n/* Clear (×) affordance — lives INSIDE the chip. HTML disallows nested\n   <button>s (the chip is inside the trigger <button>), so this is a\n   focusable role=\"button\" span with explicit keyboard handling in JS.\n   Pointerdown stops propagation so the chip click doesn't also toggle\n   the panel via the trigger. */\n.hbd-field__select-chip-clear {\n  flex-shrink: 0;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--hbd-space-4);\n  height: var(--hbd-space-4);\n  margin-left: var(--hbd-space-1);\n  padding: 0;\n  background: none;\n  border: none;\n  border-radius: var(--hbd-radius-sm);\n  color: var(--hbd-color-text-muted);\n  cursor: pointer;\n  transition: background-color var(--hbd-duration-fast) var(--hbd-ease-out),\n              color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-field__select-chip-clear:hover {\n  background: var(--hbd-color-surface-subtle);\n  color: var(--hbd-color-text-emphasis);\n}\n.hbd-field__select-chip-clear:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n/* Dropdown panel — uses position: fixed with author-supplied\n   viewport coordinates (set inline by the React component from the\n   trigger's getBoundingClientRect). This is the documented inline-\n   style exception for value-driven layout properties — without it,\n   the panel would be clipped by any scrolling/overflow ancestor\n   between the trigger and the viewport (e.g. a modal body's\n   scrollable region).\n   Slide-open animation: max-height + opacity, --hbd-duration-slow\n   (350ms), --hbd-ease-out. The global prefers-reduced-motion\n   override in hbd-theme globals collapses transitions to\n   0.01ms automatically. */\n.hbd-field__select-panel {\n  position: fixed;\n  z-index: var(--hbd-z-dropdown);\n  margin: 0;\n  padding: 0;\n  list-style: none;\n  background: var(--hbd-color-surface-raised);\n  border: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n  border-radius: var(--hbd-radius-md);\n  box-shadow: var(--hbd-shadow-lg);\n  overflow: hidden;\n  overscroll-behavior: contain;\n  /* Closed state: collapsed to zero height + invisible + no padding. */\n  max-height: 0;\n  opacity: 0;\n  pointer-events: none;\n  transition: max-height var(--hbd-duration-slow) var(--hbd-ease-out),\n              opacity var(--hbd-duration-slow) var(--hbd-ease-out),\n              padding var(--hbd-duration-slow) var(--hbd-ease-out);\n}\n.hbd-field--open .hbd-field__select-panel {\n  max-height: var(--hbd-select-panel-max-height);\n  opacity: 1;\n  pointer-events: auto;\n  padding: var(--hbd-space-1) 0;\n  overflow-y: auto;\n}\n\n/* Option group (presentational wrapper + label). */\n.hbd-field__option-group {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n.hbd-field__option-group-label {\n  display: block;\n  padding: var(--hbd-space-2) var(--hbd-space-3);\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-micro);\n  font-weight: var(--hbd-font-weight-semibold);\n  color: var(--hbd-color-text-muted);\n  letter-spacing: var(--hbd-letter-spacing-label);\n  text-transform: uppercase;\n}\n.hbd-field__option-group > ul {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n\n/* Individual option row. */\n.hbd-field__option {\n  position: relative;\n  display: flex;\n  align-items: center;\n  gap: var(--hbd-space-2);\n  padding: var(--hbd-space-2) var(--hbd-space-3);\n  min-height: var(--hbd-select-option-height);\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-body);\n  color: var(--hbd-color-text-primary);\n  cursor: pointer;\n  user-select: none;\n  transition: background-color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-field__option:hover {\n  background: var(--hbd-color-surface-subtle);\n}\n/* Selected row: parchment-tinted background + gold left-edge accent —\n   the manuscript \"marked entry\" treatment, consistent with the DS aesthetic\n   (instead of a saturated blood action fill that would shout in the panel). */\n.hbd-field__option.is-selected {\n  background: var(--hbd-color-surface-subtle);\n  color: var(--hbd-color-text-primary);\n  font-weight: var(--hbd-font-weight-medium);\n  box-shadow: inset var(--hbd-border-width-medium) 0 0 var(--hbd-color-gold-deep);\n}\n/* Inset outline so focus ring doesn't overflow the row's bounds. */\n.hbd-field__option.is-focused,\n.hbd-field__option:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: calc(-1 * var(--hbd-border-width-thin));\n}\n.hbd-field__option.is-disabled,\n.hbd-field__option[aria-disabled=\"true\"] {\n  color: var(--hbd-color-text-disabled);\n  cursor: not-allowed;\n  pointer-events: none;\n}\n\n/* Checkmark beside the selected option — gold-deep matches the accent edge. */\n.hbd-field__option-check {\n  margin-left: auto;\n  flex-shrink: 0;\n  color: var(--hbd-color-gold-deep);\n}\n.hbd-field__option:not(.is-selected) .hbd-field__option-check {\n  display: none;\n}\n\n/* Hidden native <select> — form-submission fallback only. The 1px/-1px\n   visually-hidden technique requires literal pixels (it cannot be tokenised);\n   the canonical implementation lives in hbd-theme globals under .hbd-sr-only.\n   The native select element is given that class directly in the markup to\n   avoid duplicating the literal here. This rule only adds component-specific\n   guarantees that are independent of the sr-only sizing. */\n.hbd-field__select-native {\n  pointer-events: none;\n}\n\n/* Flat-select modifier — in the source this matched the host element via\n   :host(.hbd-select--flat). In the light DOM the modifier class lives on the\n   .hbd-select block, so the rules become plain descendant selectors. Strips\n   the chip-pill treatment from the selected value AND locks the trigger to a\n   fixed geometry so opening/closing the panel doesn't cause any layout shift\n   in the surrounding inline flow. Used by pagination for \"Show N per page\". */\n.hbd-select--flat .hbd-field__select-value--chip {\n  background: transparent;\n  border: none;\n  box-shadow: none;\n  padding: 0;\n  font-family: var(--hbd-font-family-ui);\n  font-weight: var(--hbd-font-weight-medium);\n  letter-spacing: var(--hbd-letter-spacing-normal);\n  color: var(--hbd-color-text-primary);\n}\n/* The \"clear\" × span inside a flat-select chip is irrelevant — the\n   page-size value is always set, so let the user re-pick from the\n   menu rather than exposing a clear affordance. display:none avoids\n   it ever taking layout space. */\n.hbd-select--flat .hbd-field__select-chip-clear {\n  display: none;\n}\n/* Trigger geometry — tighter vertical padding so the flat select reads as\n   inline text, not a form-field row. */\n.hbd-select--flat .hbd-field__select-trigger {\n  min-height: 0;\n}\n\n/* ──────── skeleton-group.css ──────── */\n/*\n * Here Be Dragons DS\n * skeleton-group.css\n *\n * Preset layouts that arrange multiple .hbd-skeleton shapes into\n * recognisable patterns. Extracted from ds/styles/components/skeleton.css —\n * the base .hbd-skeleton rules (shape variants + shimmer) ship with the\n * @hbd/skeleton registry item, which this composes. Only the\n * .hbd-skeleton-group* rules live here.\n *\n * Light DOM, fully tokenised.\n */\n\n/* ── Group presets ────────────────────────────────────────────────── */\n.hbd-skeleton-group {\n  display: flex;\n  gap: var(--hbd-space-3);\n  width: 100%;\n  align-items: stretch;\n}\n\n.hbd-skeleton-group--avatar-text {\n  align-items: center;\n}\n\n.hbd-skeleton-group--card {\n  flex-direction: column;\n  gap: var(--hbd-space-3);\n}\n\n.hbd-skeleton-group--list-item {\n  align-items: center;\n}\n\n.hbd-skeleton-group--table-row {\n  align-items: center;\n}\n\n/*\n * Body wrapper used inside avatar-text and list-item presets — holds\n * the stacked text lines next to the circle. Light-DOM, all tokenised.\n */\n.hbd-skeleton-group__body {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  gap: var(--hbd-space-2);\n  min-width: 0;\n}\n\n.hbd-skeleton-group__body--tight {\n  gap: var(--hbd-space-1);\n}\n\n/*\n * Card preset body — padding inside the imaginary card surface so\n * the text lines don't kiss the edge.\n */\n.hbd-skeleton-group__card-body {\n  display: flex;\n  flex-direction: column;\n  gap: var(--hbd-space-2);\n  padding: var(--hbd-space-3);\n}\n\n/*\n * list-item preset has a fixed-size avatar slot. The avatar circle\n * inside it uses width/height: 100% of the slot.\n */\n.hbd-skeleton-group--list-item .hbd-skeleton--circle {\n  width: var(--hbd-avatar-size-sm);\n  height: var(--hbd-avatar-size-sm);\n}\n\n/* table-row preset distributes cells evenly across the row. */\n.hbd-skeleton-group--table-row .hbd-skeleton {\n  flex: 1;\n  height: var(--hbd-table-row-height-sm);\n  border-radius: var(--hbd-radius-md);\n}\n\n/* ──────── skeleton.css ──────── */\n/*\n * Here Be Dragons DS — skeleton.css\n * Ported for React / light-DOM from ds/styles/components/skeleton.css.\n * The legacy WC was already Light DOM (no :host/::slotted/::part), so the\n * de-shadow is a no-op — the .hbd-skeleton classes, every var(--hbd-*) ref,\n * and the @keyframes are kept verbatim for a 1:1 render.\n *\n * The .hbd-skeleton-group* preset rules ship with the separate\n * skeleton-group registry item, not here.\n *\n * Decorative placeholder shapes that mimic content while it loads.\n * The skeleton itself carries aria-hidden=\"true\"; the surrounding\n * container that BECOMES the real content owns aria-busy.\n *\n * Reduced motion: handled globally by hbd-theme globals.css. The\n * shimmer animation-duration collapses to 0.01ms under\n * @media (prefers-reduced-motion: reduce). The .hbd-skeleton--no-shimmer\n * modifier is a hard-coded equivalent (used to demo the reduced-motion\n * appearance without needing to toggle the OS pref).\n */\n\n/* ── 1 · Base ─────────────────────────────────────────────────────── */\n.hbd-skeleton {\n  display: block;\n  position: relative;\n  overflow: hidden;\n  background: var(--hbd-skeleton-base-color);\n  border-radius: var(--hbd-radius-sm);\n}\n\n/* ── 2 · Shimmer ──────────────────────────────────────────────────── */\n/*\n * The gradient stops 0% / 50% / 100% are POSITIONAL within the\n * linear-gradient function and have no token meaning — they describe\n * where the bright midpoint sits relative to the sweep. They are a\n * documented permitted structural literal exception.\n */\n.hbd-skeleton::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(\n    90deg,\n    transparent 0%,\n    var(--hbd-skeleton-shimmer-color) 50%,\n    transparent 100%\n  );\n  animation: hbd-skeleton-shimmer var(--hbd-duration-pulse)\n    ease-in-out infinite;\n}\n\n.hbd-skeleton--no-shimmer::after {\n  display: none;\n}\n\n@keyframes hbd-skeleton-shimmer {\n  0%   { transform: translateX(-100%); }\n  100% { transform: translateX(100%); }\n}\n\n/* ── 3 · Shape variants ───────────────────────────────────────────── */\n.hbd-skeleton--text {\n  height: var(--hbd-font-size-body);\n  width: 100%;\n  border-radius: var(--hbd-radius-sm);\n}\n\n.hbd-skeleton--text-sm {\n  height: var(--hbd-font-size-label);\n  width: 80%;\n  border-radius: var(--hbd-radius-sm);\n}\n\n.hbd-skeleton--text-lg {\n  height: var(--hbd-font-size-h3);\n  width: 60%;\n  border-radius: var(--hbd-radius-sm);\n}\n\n.hbd-skeleton--circle {\n  border-radius: var(--hbd-radius-full);\n  width: var(--hbd-avatar-size-md);\n  height: var(--hbd-avatar-size-md);\n  flex-shrink: 0;\n}\n\n/*\n * .hbd-skeleton--rect — height is author-supplied via inline style\n * (documented inline-style exception: rect height is a value-driven\n * layout property that varies per call site, like progress fill width).\n */\n.hbd-skeleton--rect {\n  width: 100%;\n  border-radius: var(--hbd-radius-md);\n}\n\n/* ──────── slider.css ──────── */\n/*\n * Here Be Dragons DS — slider.css\n * Ported for React / light-DOM from the slider rules in\n * ds/styles/components/input.css (shared input stylesheet).\n *\n * De-shadowed + re-based on @radix-ui/react-slider:\n *   - The legacy WC layered a custom thumb + fill over a native\n *     input[type=range]; the value-driven left/width were inline styles.\n *   - Radix positions its Track/Range/Thumb parts itself (data attributes +\n *     inline transforms), so the value-driven inline plumbing is gone.\n *   - The exact .hbd-slider* class names are re-applied to the Radix parts:\n *       Root  -> .hbd-slider           (the interactive flex rail)\n *       Track -> .hbd-slider__track    (the hairline rail)\n *       Range -> .hbd-slider__fill     (the filled portion)\n *       Thumb -> .hbd-slider__thumb    (the draggable handle)\n *   - Field chrome (.hbd-slider-field*, .hbd-field*) is unchanged.\n *\n * Every value still references a --hbd-* token (defined in globals.css).\n * 1:1 with the legacy look.\n */\n\n/* ── Field shell ────────────────────────────────────────────────────── */\n.hbd-slider-field {\n  display: flex;\n  flex-direction: column;\n  gap: var(--hbd-space-2);\n  width: 100%;\n}\n.hbd-slider-field__header {\n  display: flex;\n  justify-content: space-between;\n  align-items: baseline;\n}\n\n/* Label — shared typography with .hbd-field__label in the legacy sheet. */\n.hbd-slider-field__label {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  font-weight: var(--hbd-font-weight-medium);\n  color: var(--hbd-color-text-primary);\n  cursor: pointer;\n}\n\n.hbd-slider-field__value-display {\n  font-family: var(--hbd-font-family-mono);\n  font-size: var(--hbd-font-size-label);\n  color: var(--hbd-color-text-muted);\n  min-width: var(--hbd-space-8);\n  text-align: right;\n}\n\n/* Track container — also the tap surface. min-height lifts the\n   interaction area to the SC 2.5.8 minimum even though the visible\n   track is a thin hairline strip. */\n.hbd-slider__track-container {\n  position: relative;\n  min-height: var(--hbd-space-12); /* 48px — clears the 44px minimum */\n  height: var(--hbd-space-8);\n  display: flex;\n  align-items: center;\n}\n\n/* Radix Root — the relative rail that spans the track container and hosts\n   the absolutely-positioned Range + Thumbs. Replaces the legacy absolute\n   native input overlay. */\n.hbd-slider {\n  position: relative;\n  display: flex;\n  align-items: center;\n  width: 100%;\n  height: 100%;\n  touch-action: none;\n  user-select: none;\n  -webkit-user-select: none;\n  cursor: pointer;\n}\n.hbd-slider[data-disabled] {\n  cursor: not-allowed;\n}\n\n.hbd-slider__track {\n  position: relative;\n  flex-grow: 1;\n  width: 100%;\n  height: var(--hbd-slider-track-height);\n  /* border-strong (ink-700, ~11.4:1 on parchment) used as a surface —\n     same precedent as input/checkbox/radio/switch borders. The spec's\n     border-default would be ~2.06:1 and fail SC 1.4.11. */\n  background: var(--hbd-color-border-strong);\n  border-radius: var(--hbd-radius-full);\n}\n\n/* Fill — Radix sizes/positions this part inline from the value(s). */\n.hbd-slider__fill {\n  position: absolute;\n  height: 100%;\n  background: var(--hbd-color-surface-action);\n  border-radius: var(--hbd-radius-full);\n}\n\n/* Thumb — Radix positions it along the track; the legacy translate(-50%)\n   is unneeded because Radix accounts for thumb width. */\n.hbd-slider__thumb {\n  display: block;\n  width: var(--hbd-slider-thumb-size);\n  height: var(--hbd-slider-thumb-size);\n  background: var(--hbd-color-surface-default);\n  border: var(--hbd-border-width-thin) solid var(--hbd-color-surface-action);\n  border-radius: var(--hbd-radius-full);\n  box-shadow: var(--hbd-shadow-sm);\n  cursor: pointer;\n  transition: box-shadow var(--hbd-duration-fast) var(--hbd-ease-out),\n              transform var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n\n/* Active (press / drag) — Radix flags the grabbed thumb; mirror the legacy\n   .is-active scale-up. */\n.hbd-slider__thumb:active,\n.hbd-slider__thumb.is-active {\n  box-shadow: var(--hbd-shadow-md);\n  transform: scale(1.15);\n}\n\n/* Focus ring — legacy applied .is-focused via JS; Radix exposes native\n   focus, so target :focus-visible directly (plus the legacy class for\n   parity). */\n.hbd-slider__thumb:focus-visible,\n.hbd-slider__thumb.is-focused {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n/* Optional tick marks below the track. The hairline mark uses the\n   --hbd-border-width-hairline token so the literal in the spec is\n   fully tokenised. */\n.hbd-slider__ticks {\n  display: flex;\n  justify-content: space-between;\n  padding: 0 calc(var(--hbd-slider-thumb-size) / 2);\n  margin-top: var(--hbd-space-1);\n}\n.hbd-slider__tick {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: var(--hbd-space-1);\n}\n.hbd-slider__tick-mark {\n  width: var(--hbd-border-width-hairline);\n  height: var(--hbd-space-1);\n  background: var(--hbd-color-border-strong);\n}\n.hbd-slider__tick-label {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-micro);\n  color: var(--hbd-color-text-muted);\n  white-space: nowrap;\n}\n\n/* Disabled state. */\n.hbd-slider-field--disabled .hbd-slider__track,\n.hbd-slider-field--disabled .hbd-slider__thumb { opacity: 0.5; }\n.hbd-slider-field--disabled .hbd-slider,\n.hbd-slider-field--disabled .hbd-slider__thumb { cursor: not-allowed; }\n\n/* Size modifiers — re-point the thumb-size custom property at the\n   per-size token. Track height stays constant across sizes. */\n.hbd-slider-field--sm { --hbd-slider-thumb-size: var(--hbd-slider-thumb-size-sm); }\n.hbd-slider-field--lg { --hbd-slider-thumb-size: var(--hbd-slider-thumb-size-lg); }\n\n/* Error state — tint the fill + thumb border. */\n.hbd-slider-field--error .hbd-slider__fill {\n  background: var(--hbd-color-status-error-border);\n}\n.hbd-slider-field--error .hbd-slider__thumb {\n  border-color: var(--hbd-color-status-error-border);\n}\n.hbd-slider-field--error .hbd-slider-field__label {\n  color: var(--hbd-color-text-emphasis);\n}\n\n/* ── Field footer (hint / error) ────────────────────────────────────── */\n.hbd-field__footer {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  gap: var(--hbd-space-2);\n}\n.hbd-field__hint,\n.hbd-field__error {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  line-height: var(--hbd-line-height-body);\n}\n.hbd-field__hint {\n  color: var(--hbd-color-text-muted);\n  display: block;\n}\n/* The React port renders the error node only when an error exists, so it is\n   always visible (the legacy sheet kept it display:none until the error\n   modifier flipped it). */\n.hbd-field__error {\n  /* text-emphasis (blood, ~12.8:1 on parchment) — AA-compliant dark red */\n  color: var(--hbd-color-text-emphasis);\n  display: block;\n}\n\n/* ──────── spacer.css ──────── */\n/*\n * Here Be Dragons DS — spacer.css\n * Ported for React / light-DOM from ds/styles/components/spacer.css.\n * No Shadow DOM in the source, so nothing to de-shadow — the .hbd-spacer class\n * already targets the light-DOM element.\n *\n * Explicit-whitespace utility. The element's actual width / height are written\n * inline by <Spacer> based on the size + axis props — the documented inline-style\n * exception for value-driven layout properties (same pattern as skeleton rect\n * height and progress fill width).\n *\n * The component itself is purely decorative: <Spacer> sets role=\"none\" +\n * aria-hidden=\"true\" so the spacer never appears in the accessibility tree and\n * never shifts reading or Tab order.\n */\n\n.hbd-spacer {\n  display: block;\n  flex-shrink: 0;\n}\n\n/* ──────── spell-card.css ──────── */\n/*\n * Here Be Dragons DS — spell-card.css\n * Ported for React / light-DOM from ds/styles/components/spell-card.css.\n * The legacy <hbd-spell-card> already used Light DOM (no shadow root), so there\n * were no :host / ::slotted / ::part / slot constructs to de-shadow — the CSS is\n * carried over verbatim. Every value still references a --hbd-* token (defined\n * in globals.css). 1:1 with the legacy look.\n *\n * Spell card — a D&D spell in card format: school colour band, ornamental\n * corners, level badge, label/value meta grid (dl/dt/dd), description and\n * optional \"At Higher Levels\" / footer zones.\n *\n * School identity is set via the .hbd-spell-card--{school} modifier, which\n * maps the local --sc-school / --sc-school-accent / --sc-school-text vars to\n * the matching semantic --hbd-color-school-* tokens. Every value references a\n * --hbd-* token.\n *\n * Zone order: header → meta → body → higher levels → footer → modifiers → states.\n */\n\n.hbd-spell-card {\n  /* School theming: defaults to evocation; overridden per --{school} modifier. */\n  --sc-school: var(--hbd-color-school-evocation);\n  --sc-school-accent: var(--hbd-color-school-evocation-accent);\n  --sc-school-text: var(--hbd-color-school-evocation-text);\n\n  position: relative;\n  overflow: hidden;\n  background: linear-gradient(135deg, var(--hbd-color-surface-default), var(--hbd-color-surface-subtle));\n  border: var(--hbd-border-width-thin) solid var(--hbd-color-border-ink-brown);\n  box-shadow: var(--hbd-spell-card-shadow);\n  font-family: var(--hbd-font-family-ui);\n}\n.hbd-spell-card:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n/* ── Ornamental corners ─────────────────────────────────────────────── */\n.hbd-spell-card__corner {\n  position: absolute;\n  width: var(--hbd-spell-card-corner-size);\n  height: var(--hbd-spell-card-corner-size);\n  border-color: var(--hbd-color-gold);\n  border-style: solid;\n  pointer-events: none;\n}\n.hbd-spell-card__corner--tl { top: var(--hbd-spell-card-corner-inset); left: var(--hbd-spell-card-corner-inset); border-width: var(--hbd-spell-card-corner-weight) 0 0 var(--hbd-spell-card-corner-weight); }\n.hbd-spell-card__corner--tr { top: var(--hbd-spell-card-corner-inset); right: var(--hbd-spell-card-corner-inset); border-width: var(--hbd-spell-card-corner-weight) var(--hbd-spell-card-corner-weight) 0 0; }\n.hbd-spell-card__corner--bl { bottom: var(--hbd-spell-card-corner-inset); left: var(--hbd-spell-card-corner-inset); border-width: 0 0 var(--hbd-spell-card-corner-weight) var(--hbd-spell-card-corner-weight); }\n.hbd-spell-card__corner--br { bottom: var(--hbd-spell-card-corner-inset); right: var(--hbd-spell-card-corner-inset); border-width: 0 var(--hbd-spell-card-corner-weight) var(--hbd-spell-card-corner-weight) 0; }\n\n/* ── Header: school colour band, eyebrow (school), name, level badge ── */\n.hbd-spell-card__bar {\n  height: var(--hbd-spell-card-bar-height);\n  background: linear-gradient(to right, var(--sc-school), var(--sc-school-accent), var(--sc-school));\n}\n.hbd-spell-card__body {\n  padding: var(--hbd-spell-card-padding-y) var(--hbd-spell-card-padding-x);\n}\n.hbd-spell-card__level {\n  position: absolute;\n  top: var(--hbd-spell-card-badge-offset);\n  right: var(--hbd-spell-card-badge-offset);\n  padding: var(--hbd-spell-card-badge-pad-y) var(--hbd-spell-card-badge-pad-x);\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-font-size-2xs);\n  letter-spacing: var(--hbd-letter-spacing-badge);\n  text-transform: uppercase;\n  background: var(--sc-school);\n  color: var(--sc-school-text);\n}\n.hbd-spell-card__school {\n  display: block;\n  margin-bottom: var(--hbd-space-1);\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-font-size-2xs);\n  letter-spacing: var(--hbd-letter-spacing-eyebrow);\n  text-transform: uppercase;\n  color: var(--hbd-color-gold-deep);\n}\n.hbd-spell-card__name {\n  margin-bottom: var(--hbd-space-2);\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-font-size-body);\n  font-weight: var(--hbd-font-weight-bold);\n  letter-spacing: var(--hbd-letter-spacing-display);\n  line-height: var(--hbd-line-height-tight);\n  color: var(--hbd-color-text-primary);\n}\n.hbd-spell-card__rule {\n  border: none;\n  border-top: var(--hbd-border-width-hairline) dashed var(--hbd-color-text-muted);\n  margin: var(--hbd-space-2) 0;\n}\n\n/* ── Meta grid: casting time / range / components / duration ─────────── */\n.hbd-spell-card__meta {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: var(--hbd-space-1) var(--hbd-space-2);\n  margin-bottom: var(--hbd-space-2);\n}\n.hbd-spell-card__meta-label {\n  display: block;\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-font-size-3xs);\n  letter-spacing: var(--hbd-letter-spacing-button);\n  text-transform: uppercase;\n  color: var(--hbd-color-blood);\n}\n.hbd-spell-card__meta-value {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-micro);\n  color: var(--hbd-color-text-secondary);\n}\n\n/* ── Body: description / flavour text ───────────────────────────────── */\n.hbd-spell-card__description {\n  font-family: var(--hbd-font-family-serif);\n  font-style: italic;\n  font-size: var(--hbd-font-size-micro);\n  line-height: var(--hbd-line-height-normal);\n  color: var(--hbd-color-text-secondary);\n}\n\n/* ── Higher levels ──────────────────────────────────────────────────── */\n.hbd-spell-card__higher-levels {\n  margin-top: var(--hbd-space-2);\n  font-family: var(--hbd-font-family-serif);\n  font-size: var(--hbd-font-size-micro);\n  line-height: var(--hbd-line-height-normal);\n  color: var(--hbd-color-text-secondary);\n}\n.hbd-spell-card__higher-levels-label {\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-font-size-3xs);\n  letter-spacing: var(--hbd-letter-spacing-button);\n  text-transform: uppercase;\n  color: var(--hbd-color-gold-deep);\n}\n\n/* ── Footer: source / tags ──────────────────────────────────────────── */\n.hbd-spell-card__footer {\n  margin-top: var(--hbd-space-2);\n  padding-top: var(--hbd-space-2);\n  border-top: var(--hbd-border-width-hairline) dashed var(--hbd-color-text-muted);\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-3xs);\n  letter-spacing: var(--hbd-letter-spacing-badge);\n  text-transform: uppercase;\n  color: var(--hbd-color-text-muted);\n}\n\n/* ── Ritual / concentration indicators ──────────────────────────────── */\n.hbd-spell-card__tags {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--hbd-space-1);\n  margin-bottom: var(--hbd-space-2);\n}\n.hbd-spell-card__tag {\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-font-size-3xs);\n  letter-spacing: var(--hbd-letter-spacing-badge);\n  text-transform: uppercase;\n  padding: var(--hbd-spell-card-badge-pad-y) var(--hbd-spell-card-badge-pad-x);\n  color: var(--sc-school-text);\n  background: var(--sc-school);\n}\n\n/* ── School modifiers ───────────────────────────────────────────────── */\n.hbd-spell-card--abjuration {\n  --sc-school: var(--hbd-color-school-abjuration);\n  --sc-school-accent: var(--hbd-color-school-abjuration-accent);\n  --sc-school-text: var(--hbd-color-school-abjuration-text);\n}\n.hbd-spell-card--conjuration {\n  --sc-school: var(--hbd-color-school-conjuration);\n  --sc-school-accent: var(--hbd-color-school-conjuration-accent);\n  --sc-school-text: var(--hbd-color-school-conjuration-text);\n}\n.hbd-spell-card--divination {\n  --sc-school: var(--hbd-color-school-divination);\n  --sc-school-accent: var(--hbd-color-school-divination-accent);\n  --sc-school-text: var(--hbd-color-school-divination-text);\n}\n.hbd-spell-card--enchantment {\n  --sc-school: var(--hbd-color-school-enchantment);\n  --sc-school-accent: var(--hbd-color-school-enchantment-accent);\n  --sc-school-text: var(--hbd-color-school-enchantment-text);\n}\n.hbd-spell-card--evocation {\n  --sc-school: var(--hbd-color-school-evocation);\n  --sc-school-accent: var(--hbd-color-school-evocation-accent);\n  --sc-school-text: var(--hbd-color-school-evocation-text);\n}\n.hbd-spell-card--illusion {\n  --sc-school: var(--hbd-color-school-illusion);\n  --sc-school-accent: var(--hbd-color-school-illusion-accent);\n  --sc-school-text: var(--hbd-color-school-illusion-text);\n}\n.hbd-spell-card--necromancy {\n  --sc-school: var(--hbd-color-school-necromancy);\n  --sc-school-accent: var(--hbd-color-school-necromancy-accent);\n  --sc-school-text: var(--hbd-color-school-necromancy-text);\n}\n.hbd-spell-card--transmutation {\n  --sc-school: var(--hbd-color-school-transmutation);\n  --sc-school-accent: var(--hbd-color-school-transmutation-accent);\n  --sc-school-text: var(--hbd-color-school-transmutation-text);\n}\n\n/* ── Special-type modifiers ─────────────────────────────────────────── */\n/* Cantrip / ritual / concentration are conveyed by visible text (school\n   eyebrow + tags); these modifiers only carry optional emphasis hooks. */\n.hbd-spell-card--cantrip .hbd-spell-card__level,\n.hbd-spell-card--ritual .hbd-spell-card__level,\n.hbd-spell-card--concentration .hbd-spell-card__level {\n  letter-spacing: var(--hbd-letter-spacing-badge);\n}\n\n/* ── States ─────────────────────────────────────────────────────────── */\n.hbd-spell-card--selected {\n  border-color: var(--hbd-color-gold);\n  box-shadow: var(--hbd-spell-card-shadow-selected);\n}\n.hbd-spell-card.is-selected {\n  border-color: var(--hbd-color-gold);\n  box-shadow: var(--hbd-spell-card-shadow-selected);\n}\n\n/* ──────── spinner.css ──────── */\n/*\n * Here Be Dragons DS\n * ds/styles/components/spinner.css\n *\n * Indeterminate progress indicator. SVG circle with a rotating arc\n * — more performant than rotating a border-radius element and gives\n * us precise control over the arc length and gap.\n *\n * The JS layer (hbd-spinner.js) authors the SVG; this file only\n * styles the two <circle> children and applies the rotation. The\n * geometry constants (cx=12, cy=12, r=10) come from the JS and the\n * 56.5 dash-array literal is derived from them — see the comment in\n * §3 below.\n *\n * Naming notes:\n * - Spec referenced --hbd-color-action-default — emitted token is\n *   --hbd-color-surface-action (the canonical \"action\" fill colour,\n *   same one consumed by hbd-button primary and hbd-progress fill).\n * - Spec referenced --hbd-duration-spin (0.75s) — added as a new\n *   duration token so the value lives in tokens.json.\n *\n * Reduced motion: the global @media (prefers-reduced-motion: reduce)\n * override in foundations/motion.css collapses the spin animation to\n * 0.01ms, effectively freezing it as a static arc. The arc remains\n * visually distinct (75% circle + gap) so the indicator is still\n * legible without motion. No spinner-specific reduced-motion rule\n * is required.\n *\n * SC 2.2.2 exemption: a spinner used as a decorative loading\n * indicator that auto-removes when loading completes is exempt from\n * SC 2.2.2 (it is not a moving/blinking/scrolling INFORMATION element;\n * the information is carried by the role=\"status\" announcement, not\n * by the motion itself).\n */\n\n/* ── 1 · Block ────────────────────────────────────────────────────── */\n.hbd-spinner {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  width: var(--hbd-spinner-size-md);\n  height: var(--hbd-spinner-size-md);\n  /* The base spinner uses the action colour so the fill arc inherits\n     it via currentColor by default. The --inherit modifier overrides\n     this with currentColor at the host (see §4). */\n  color: var(--hbd-color-surface-action);\n  line-height: 0;\n}\n\n.hbd-spinner--sm { width: var(--hbd-spinner-size-sm); height: var(--hbd-spinner-size-sm); }\n.hbd-spinner--lg { width: var(--hbd-spinner-size-lg); height: var(--hbd-spinner-size-lg); }\n.hbd-spinner--xl { width: var(--hbd-spinner-size-xl); height: var(--hbd-spinner-size-xl); }\n\n/* ── 2 · Animation ────────────────────────────────────────────────── */\n@keyframes hbd-spin {\n  from { transform: rotate(0deg); }\n  to   { transform: rotate(360deg); }\n}\n\n.hbd-spinner svg {\n  width: 100%;\n  height: 100%;\n  display: block;\n  /* Rotate the entire SVG; the inner -90deg transform on the fill\n     circle (set in JS) anchors the arc start at 12 o'clock. */\n  animation: hbd-spin var(--hbd-duration-spin) linear infinite;\n  transform-origin: center center;\n}\n\n/* ── 3 · Track and fill ───────────────────────────────────────────── */\n/*\n * Geometry: the SVG viewBox is 0 0 24 24 with both circles at\n * cx=12 cy=12 r=10. Circumference = 2π × 10 ≈ 62.83. The fill arc\n * is 75% of the circle, so dash-array = 47.12 visible / 15.71 gap.\n * We use 47 + 16 (sum 63 ≈ circumference) for clean integer round —\n * close enough that the gap reads as ~25% of the circle.\n *\n * The 47/16 literals are SVG-geometry constants, not visual tokens —\n * they fall out of the cx/cy/r values defined in JS and cannot be\n * tokenised without breaking the relationship. Documented exception.\n */\n.hbd-spinner__track {\n  stroke: var(--hbd-color-border-subtle);\n  fill: none;\n  stroke-width: var(--hbd-spinner-stroke);\n}\n\n.hbd-spinner__fill {\n  stroke: currentColor;\n  fill: none;\n  stroke-width: var(--hbd-spinner-stroke);\n  stroke-linecap: round;\n  stroke-dasharray: 47 16;\n  stroke-dashoffset: 0;\n}\n\n/* ── 4 · Colour variants ──────────────────────────────────────────── */\n.hbd-spinner--muted {\n  color: var(--hbd-color-text-muted);\n}\n.hbd-spinner--muted .hbd-spinner__track {\n  stroke: var(--hbd-color-border-subtle);\n}\n\n.hbd-spinner--inherit {\n  color: inherit;\n}\n.hbd-spinner--inherit .hbd-spinner__track {\n  /* On unknown background colours (button surface, callout surface,\n     etc.) we tint the track from the inherited foreground at 20%\n     opacity so it reads as a subtle complement to the fill arc.\n     stroke-opacity is the only SVG-native way to apply alpha to a\n     stroke without color-mix. */\n  stroke: currentColor;\n  stroke-opacity: 0.2;\n}\n.hbd-spinner--inherit .hbd-spinner__fill {\n  stroke: currentColor;\n}\n\n/* ──────── split-button.css ──────── */\n/*\n * Here Be Dragons DS\n * split-button.css\n *\n * Extracted from the legacy ds/styles/components/button.css `.hbd-split-button*`\n * rules and de-shadowed for light-DOM React usage. Composes two .hbd-button\n * elements (a wide primary ACTION on the left + a narrow chevron TRIGGER on\n * the right) joined into one visual unit, plus an absolutely-positioned\n * dropdown panel of .hbd-field__option rows (option chrome comes from\n * input.css, pulled in via the button/dropdown deps).\n *\n * De-shadow notes:\n * - The wrapper was :host inside hbd-split-button's shadow root -> .hbd-split-button.\n * - The two `:host(.hbd-split-button__action) .hbd-button` /\n *   `:host(.hbd-split-button__trigger) .hbd-button` rules ran INSIDE each inner\n *   hbd-button's shadow root, where the host carried the marker class and the\n *   native button was `.hbd-button`. In the React port the marker class lands on\n *   the SAME native button element (the Button forwards className onto its\n *   <button class=\"hbd-button ...\">), so these become single-element selectors:\n *   `.hbd-split-button__action.hbd-button` / `.hbd-split-button__trigger.hbd-button`.\n * - All var(--hbd-*) refs kept verbatim. No absolute /paths. No hard-coded\n *   values except the one documented inline-rgba hairline divider carried over\n *   verbatim from the legacy file.\n */\n\n/* ── Split button ───────────────────────────────────────────────────── */\n.hbd-split-button {\n  display: inline-flex;\n  position: relative;\n  /* Both halves should align on the cross-axis so neither sits taller\n     or lower than the other. */\n  align-items: stretch;\n  /* One unified offset shadow for the whole composed unit. The shadow\n     colour is per-variant — see modifier rules below. The two inner\n     buttons no longer carry their own shadows (overridden below). */\n  box-shadow: var(--hbd-button-shadow);\n  transition: box-shadow var(--hbd-duration-fast) var(--hbd-ease-out),\n              transform var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-split-button--variant-primary { box-shadow: var(--hbd-button-shadow-primary); }\n.hbd-split-button--variant-gold    { box-shadow: var(--hbd-button-shadow-gold); }\n.hbd-split-button--disabled        { box-shadow: none; }\n\n/* The action and trigger hosts themselves participate in the flex line.\n   Inline-flex ensures they hug the inner button and stretch vertically\n   together. */\n.hbd-split-button__action,\n.hbd-split-button__trigger {\n  display: inline-flex;\n  align-items: stretch;\n}\n\n/* Left half — strip the right radius and the offset drop shadow on\n   the inner button. Stripping the shadow removes the visible\n   \"stair-step\" that would otherwise appear at the join. The wrapper\n   carries one shadow above. */\n.hbd-split-button__action.hbd-button {\n  border-top-right-radius: 0;\n  border-bottom-right-radius: 0;\n  box-shadow: none;\n  /* Stretch to the wrapper's height so heights match exactly. */\n  height: 100%;\n}\n\n/* Right half — strip the left radius + tighten horizontal padding.\n   Also strip the shadow so the two halves sit flush. The hairline\n   divider uses rgba white at 30% opacity so it reads on any variant's\n   button background without a per-variant token. This is the one\n   documented inline-rgba exception carried over from button.css. */\n.hbd-split-button__trigger.hbd-button {\n  border-top-left-radius: 0;\n  border-bottom-left-radius: 0;\n  border-left: var(--hbd-border-width-hairline) solid rgba(255, 255, 255, 0.3);\n  padding-left: var(--hbd-space-2);\n  padding-right: var(--hbd-space-2);\n  min-width: unset;\n  box-shadow: none;\n  height: 100%;\n}\n\n/* Chevron icon inside the trigger — small and animated on open. */\n.hbd-split-button__chevron {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--hbd-space-4);\n  height: var(--hbd-space-4);\n  transition: transform var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-split-button--open .hbd-split-button__chevron {\n  transform: rotate(180deg);\n}\n\n/* Dropdown panel — same visual treatment as the select panel but\n   anchored to the right edge of the split button. */\n.hbd-split-button__panel {\n  position: absolute;\n  z-index: var(--hbd-z-dropdown);\n  top: calc(100% + var(--hbd-space-1));\n  right: 0;\n  min-width: 100%;\n  margin: 0;\n  padding: var(--hbd-space-1) 0;\n  list-style: none;\n  background: var(--hbd-color-surface-raised);\n  border: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n  border-radius: var(--hbd-radius-md);\n  box-shadow: var(--hbd-shadow-lg);\n  opacity: 0;\n  pointer-events: none;\n  transform: translateY(calc(-1 * var(--hbd-space-1)));\n  transition: opacity var(--hbd-duration-fast) var(--hbd-ease-out),\n              transform var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-split-button--open .hbd-split-button__panel {\n  opacity: 1;\n  pointer-events: auto;\n  transform: translateY(0);\n}\n\n/* Disabled — both portions non-interactive. The inner buttons handle\n   their own visual disabled state via the existing .is-disabled rule\n   per variant; this wrapper rule just stops any pointer-events bleed. */\n.hbd-split-button--disabled {\n  pointer-events: none;\n}\n\n/* ──────── stat-block.css ──────── */\n/*\n * Here Be Dragons DS — stat-block.css\n * Ported for React / light-DOM from ds/styles/components/stat-block.css.\n * The legacy WC already rendered in Light DOM, so there were no :host /\n * ::slotted / ::part selectors to de-shadow — the BEM classes are reproduced\n * verbatim by the React markup. Every value still references a --hbd-* token\n * (defined in globals.css). 1:1 with the legacy look.\n *\n * Stat block — a D&D 5e creature/NPC stat block: name + subtitle header, basic\n * stats (AC/HP/Speed), a 6-ability score table, properties (saves/senses/\n * languages/CR), and trait/action sections. The exact manuscript appearance is\n * preserved (double red rule frame, blood headings, tinted ability panel).\n *\n * Zone order: header → basics → ability table → properties → sections → modifiers.\n */\n\n.hbd-stat-block {\n  display: block;\n  max-width: 24rem;\n  background: linear-gradient(135deg, var(--hbd-color-surface-default), var(--hbd-color-surface-subtle));\n  border-top: var(--hbd-stat-block-bar-width) solid var(--hbd-color-surface-action);\n  border-bottom: var(--hbd-stat-block-bar-width) solid var(--hbd-color-surface-action);\n  box-shadow: var(--hbd-shadow-md);\n  font-family: var(--hbd-font-family-serif);\n}\n\n/* Inner red hairline frame + padding (the manuscript double-rule). */\n.hbd-stat-block__inner {\n  border-top: var(--hbd-border-width-hairline) solid var(--hbd-color-surface-action);\n  border-bottom: var(--hbd-border-width-hairline) solid var(--hbd-color-surface-action);\n  margin: var(--hbd-space-1) 0;\n  padding: var(--hbd-stat-block-inner-pad-y) var(--hbd-stat-block-inner-pad-x);\n}\n\n/* ── Header: name + subtitle ────────────────────────────────────────── */\n.hbd-stat-block__header { margin-bottom: var(--hbd-space-3); }\n.hbd-stat-block__name {\n  margin: 0 0 var(--hbd-stat-block-name-gap);\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-font-size-2xl);\n  font-weight: var(--hbd-font-weight-bold);\n  letter-spacing: var(--hbd-letter-spacing-display);\n  line-height: var(--hbd-line-height-tight);\n  color: var(--hbd-color-text-emphasis);\n}\n.hbd-stat-block__subtitle {\n  margin: 0;\n  font-family: var(--hbd-font-family-serif);\n  font-style: italic;\n  font-size: var(--hbd-font-size-flavor);\n  color: var(--hbd-color-text-secondary);\n}\n\n/* ── Divider between zones ──────────────────────────────────────────── */\n.hbd-stat-block__divider {\n  border: none;\n  border-top: var(--hbd-border-width-hairline) solid var(--hbd-color-surface-action);\n  margin: var(--hbd-stat-block-rule-gap) 0;\n}\n\n/* ── Basics: AC / HP / Speed and other property rows ────────────────── */\n.hbd-stat-block__basics { margin: 0; }\n.hbd-stat-block__property {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--hbd-space-2);\n  margin: 0;\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  color: var(--hbd-color-text-secondary);\n  line-height: var(--hbd-line-height-body);\n}\n.hbd-stat-block__property-label {\n  font-family: var(--hbd-font-family-display);\n  font-weight: var(--hbd-font-weight-bold);\n  letter-spacing: var(--hbd-letter-spacing-wider);\n  color: var(--hbd-color-text-emphasis-strong);\n}\n.hbd-stat-block__property-value {\n  font-weight: var(--hbd-font-weight-regular);\n}\n\n/* ── Ability score table ────────────────────────────────────────────── */\n.hbd-stat-block__ability-grid {\n  width: 100%;\n  border-collapse: collapse;\n  table-layout: fixed;\n  text-align: center;\n  background: var(--hbd-stat-block-ability-bg);\n  border: var(--hbd-border-width-hairline) solid var(--hbd-stat-block-ability-border);\n  margin: var(--hbd-stat-block-rule-gap) 0;\n}\n.hbd-stat-block__ability-label {\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-stat-block-ability-head-size);\n  font-weight: var(--hbd-font-weight-bold);\n  letter-spacing: var(--hbd-letter-spacing-badge);\n  text-transform: uppercase;\n  color: var(--hbd-color-text-emphasis);\n  padding: var(--hbd-stat-block-ability-pad) 0;\n  border-bottom: var(--hbd-border-width-hairline) solid var(--hbd-stat-block-ability-border);\n}\n.hbd-stat-block__ability-score {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-flavor);\n  font-weight: var(--hbd-font-weight-bold);\n  color: var(--hbd-color-text-primary);\n  padding: var(--hbd-stat-block-ability-pad) 0 var(--hbd-stat-block-ability-pad-tight);\n}\n.hbd-stat-block__ability-modifier {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-micro);\n  color: var(--hbd-color-text-emphasis);\n  padding: 0 0 var(--hbd-stat-block-ability-pad);\n}\n\n/* ── Properties block (saves/senses/languages/CR) reuses __property ─── */\n.hbd-stat-block__properties { margin: 0; }\n\n/* ── Sections: traits / actions / reactions / legendary ─────────────── */\n.hbd-stat-block__section { margin-top: var(--hbd-space-2); }\n.hbd-stat-block__section-heading {\n  margin: var(--hbd-space-3) 0 var(--hbd-space-2);\n  font-family: var(--hbd-font-family-display);\n  font-size: var(--hbd-font-size-md);\n  font-weight: var(--hbd-font-weight-bold);\n  letter-spacing: var(--hbd-letter-spacing-display);\n  color: var(--hbd-color-text-emphasis);\n  border-bottom: var(--hbd-border-width-hairline) solid var(--hbd-color-surface-action);\n  padding-bottom: var(--hbd-space-1);\n}\n.hbd-stat-block__trait {\n  margin-top: var(--hbd-stat-block-feature-gap);\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  color: var(--hbd-color-text-secondary);\n  line-height: var(--hbd-stat-block-feature-leading);\n}\n.hbd-stat-block__trait-name {\n  display: inline;\n  font-style: italic;\n  font-weight: var(--hbd-font-weight-bold);\n  color: var(--hbd-color-text-primary);\n}\n.hbd-stat-block__trait-body { display: inline; }\n\n/* ── Legendary modifier ─────────────────────────────────────────────── */\n/* Legendary actions are an extra section; the modifier hooks any future\n   emphasis. The section itself is rendered when the `legendary` attr is set. */\n.hbd-stat-block--legendary .hbd-stat-block__section--legendary {\n  display: block;\n}\n\n/* ── Compact modifier — reduced padding and type ────────────────────── */\n.hbd-stat-block--compact .hbd-stat-block__inner {\n  padding: var(--hbd-space-3) var(--hbd-space-4);\n}\n.hbd-stat-block--compact .hbd-stat-block__name {\n  font-size: var(--hbd-font-size-xl);\n}\n.hbd-stat-block--compact .hbd-stat-block__property,\n.hbd-stat-block--compact .hbd-stat-block__trait {\n  font-size: var(--hbd-font-size-micro);\n}\n.hbd-stat-block--compact .hbd-stat-block__section-heading {\n  font-size: var(--hbd-font-size-label);\n}\n\n/* ──────── stepper-nav.css ──────── */\n/*\n * Here Be Dragons DS\n * app/components/stepper-nav.css\n *\n * Stepper navigation — progress through a multi-step flow. Extracted from\n * the legacy ds/styles/components/stepper.css (.hbd-stepper* rules only —\n * the numeric-input \"stepper\" item owns the rest). Already authored in\n * Light DOM, so no de-shadowing was required: the markup renders a real\n * <nav> landmark + <ol> so step order reaches AT. The global .hbd-sr-only\n * helper + :focus-visible ring come from hbd-theme globals.\n *\n * Naming notes:\n * - Spec referenced --hbd-stepper-{indicator-size,connector-height}; the\n *   emitted token namespace is --hbd-stepper-nav-* to avoid colliding with\n *   the existing --hbd-stepper-button-width (numeric-input stepper).\n * - Spec referenced --hbd-color-action-default / -action-text — emitted\n *   tokens are --hbd-color-surface-action / --hbd-color-text-on-action.\n * - Spec referenced --hbd-color-status-error-bg / -text — emitted tokens\n *   are --hbd-color-status-error-surface / --hbd-color-status-error-text.\n * - Spec referenced --hbd-color-border-default for upcoming connectors;\n *   emitted token is --hbd-color-border-strong where SC 1.4.11 demands\n *   3:1 against parchment-100. -default (ink-300) sits at ~2.1:1 and is\n *   used for the upcoming-indicator ring (non-essential progress cue).\n * - Spec referenced --hbd-spacing-N — emitted tokens are --hbd-space-N.\n */\n\n/* ── 1 · Wrapper ──────────────────────────────────────────────────── */\n.hbd-stepper {\n  width: 100%;\n  font-family: var(--hbd-font-family-ui);\n}\n\n/* ── 2 · Step list ────────────────────────────────────────────────── */\n.hbd-stepper__list {\n  display: flex;\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n\n.hbd-stepper--horizontal .hbd-stepper__list {\n  flex-direction: row;\n  align-items: flex-start;\n}\n\n.hbd-stepper--vertical .hbd-stepper__list {\n  flex-direction: column;\n  gap: 0;\n}\n\n/* ── 3 · Step item ────────────────────────────────────────────────── */\n.hbd-stepper--horizontal .hbd-stepper__step {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  flex: 1;\n  position: relative;\n  min-width: 0;\n}\n\n.hbd-stepper--vertical .hbd-stepper__step {\n  display: flex;\n  flex-direction: row;\n  /* Cross-axis CENTRE so the content sits on the indicator's vertical\n     midline. flex-start would top-align the content to the indicator's\n     top edge — fine for single-line labels, off-centre as soon as the\n     label wraps or a description is added. */\n  align-items: center;\n  gap: var(--hbd-space-3);\n  position: relative;\n}\n\n/* ── 4 · Connector line ───────────────────────────────────────────── */\n/* Horizontal: positioned absolutely so it stretches between adjacent\n   indicator centres. The connector belongs to the step on its LEFT —\n   each li renders its OWN trailing connector, EXCEPT the last step (JS\n   omits the connector node there). */\n.hbd-stepper--horizontal .hbd-stepper__connector {\n  position: absolute;\n  top: calc(var(--hbd-stepper-nav-indicator-size) / 2);\n  left: calc(50% + var(--hbd-stepper-nav-indicator-size) / 2 + var(--hbd-space-1));\n  right: calc(-50% + var(--hbd-stepper-nav-indicator-size) / 2 + var(--hbd-space-1));\n  height: var(--hbd-stepper-nav-connector-height);\n  background: var(--hbd-color-border-default);\n  z-index: 0;\n}\n\n/* Completed step's TRAILING connector reads as a completed segment. */\n.hbd-stepper__step--completed .hbd-stepper__connector {\n  background: var(--hbd-color-surface-action);\n}\n\n/* Vertical connector — a thin vertical bar dropped from below the\n   indicator down to the next step's indicator. */\n.hbd-stepper--vertical .hbd-stepper__connector {\n  position: absolute;\n  top: calc(var(--hbd-stepper-nav-indicator-size) + var(--hbd-space-1));\n  left: calc(var(--hbd-stepper-nav-indicator-size) / 2);\n  width: var(--hbd-stepper-nav-connector-height);\n  bottom: calc(-1 * var(--hbd-space-1));\n  background: var(--hbd-color-border-default);\n  transform: translateX(calc(-1 * var(--hbd-stepper-nav-connector-height) / 2));\n  z-index: 0;\n}\n\n/* ── 5 · Indicator ────────────────────────────────────────────────── */\n.hbd-stepper__indicator {\n  width: var(--hbd-stepper-nav-indicator-size);\n  height: var(--hbd-stepper-nav-indicator-size);\n  border-radius: var(--hbd-radius-full);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  font-weight: var(--hbd-font-weight-semibold);\n  flex-shrink: 0;\n  position: relative;\n  z-index: 1;\n  padding: 0;\n  margin: 0;\n  line-height: 1;\n  transition: background-color var(--hbd-duration-normal) var(--hbd-ease-out),\n              color var(--hbd-duration-normal) var(--hbd-ease-out),\n              border-color var(--hbd-duration-normal) var(--hbd-ease-out);\n}\n\n/* Upcoming — pale surface + muted number + outlined ring. */\n.hbd-stepper__step--upcoming .hbd-stepper__indicator {\n  background: var(--hbd-color-surface-subtle);\n  color: var(--hbd-color-text-muted);\n  border: var(--hbd-border-width-thin) solid var(--hbd-color-border-strong);\n}\n\n/* Active — solid action fill, on-action text. */\n.hbd-stepper__step--active .hbd-stepper__indicator {\n  background: var(--hbd-color-surface-action);\n  color: var(--hbd-color-text-on-action);\n  border: var(--hbd-border-width-thin) solid var(--hbd-color-surface-action);\n}\n\n/* Completed — same solid fill as active but with a checkmark icon. */\n.hbd-stepper__step--completed .hbd-stepper__indicator {\n  background: var(--hbd-color-surface-action);\n  color: var(--hbd-color-text-on-action);\n  border: var(--hbd-border-width-thin) solid var(--hbd-color-surface-action);\n}\n\n/* Error — status surface + on-action text + status border. */\n.hbd-stepper__step--error .hbd-stepper__indicator {\n  background: var(--hbd-color-status-error-surface);\n  color: var(--hbd-color-status-error-text);\n  border: var(--hbd-border-width-thin) solid var(--hbd-color-status-error-border);\n}\n\n/* Indicator-as-button resets — when non-linear renders an interactive\n   <button>, strip native chrome so it visually matches the static\n   <div> indicator. Cursor + focus rules below. */\nbutton.hbd-stepper__indicator {\n  font: inherit;\n  cursor: default;\n  -webkit-appearance: none;\n  appearance: none;\n}\n\n/* Icon inside the indicator (check / error). Tokenised box matches\n   indicator inner-text size at every level of host zoom. */\n.hbd-stepper__indicator-icon {\n  width: var(--hbd-space-4);\n  height: var(--hbd-space-4);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n}\n\n/* ── 6 · Content (label + description) ────────────────────────────── */\n/* Horizontal: the content sits below the indicator. The step is a flex\n   column with align-items:center so the content block itself is already\n   centred under the indicator — but multi-line labels need their TEXT\n   centred too, hence text-align. width:100% anchors the centring to the\n   step column instead of the label's natural width, so a long label\n   wraps symmetrically around the indicator centre. */\n.hbd-stepper--horizontal .hbd-stepper__content {\n  width: 100%;\n  text-align: center;\n  margin-top: var(--hbd-space-2);\n  padding: 0 var(--hbd-space-1);\n}\n.hbd-stepper--horizontal .hbd-stepper__label,\n.hbd-stepper--horizontal .hbd-stepper__description {\n  text-align: center;\n}\n\n/* Vertical: the step is already align-items:center, so the content box\n   itself sits on the indicator's midline. Bottom padding on the step's\n   margin (below) gives breathing room to the next step without pulling\n   the content off-centre. */\n.hbd-stepper--vertical .hbd-stepper__content {\n  padding-block: 0;\n}\n/* Step-to-step gap in the vertical stack — bottom margin on every step\n   except the last (which has no trailing connector). */\n.hbd-stepper--vertical .hbd-stepper__step:not(:last-child) {\n  margin-bottom: var(--hbd-space-4);\n}\n\n.hbd-stepper__label {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-label);\n  font-weight: var(--hbd-font-weight-medium);\n  color: var(--hbd-color-text-primary);\n  line-height: var(--hbd-line-height-snug);\n}\n\n.hbd-stepper__step--upcoming .hbd-stepper__label {\n  color: var(--hbd-color-text-muted);\n}\n\n.hbd-stepper__step--active .hbd-stepper__label {\n  color: var(--hbd-color-text-emphasis);\n  font-weight: var(--hbd-font-weight-semibold);\n}\n\n.hbd-stepper__step--error .hbd-stepper__label {\n  color: var(--hbd-color-text-emphasis);\n}\n\n.hbd-stepper__description {\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-micro);\n  color: var(--hbd-color-text-muted);\n  margin-top: var(--hbd-space-1);\n  line-height: var(--hbd-line-height-snug);\n}\n\n/* ── 7 · Non-linear interactive indicators ────────────────────────── */\n/* In non-linear mode the indicator on completed or error steps becomes\n   a real <button>. Hand cursor + focus ring + hover tint signal\n   interactivity. Upcoming + active steps are non-interactive in this\n   mode (active is the current location; upcoming should still be\n   reached via the linear flow). */\n.hbd-stepper--non-linear\n  .hbd-stepper__step--completed .hbd-stepper__indicator,\n.hbd-stepper--non-linear\n  .hbd-stepper__step--error .hbd-stepper__indicator {\n  cursor: pointer;\n}\n\n.hbd-stepper--non-linear\n  .hbd-stepper__step--completed .hbd-stepper__indicator:hover,\n.hbd-stepper--non-linear\n  .hbd-stepper__step--error .hbd-stepper__indicator:hover {\n  filter: brightness(0.92);\n}\n\n.hbd-stepper__indicator:focus-visible {\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n/* ──────── stepper.css ──────── */\n/*\n * Here Be Dragons DS\n * stepper.css (numeric stepper)\n *\n * Ported from ds/styles/components/input.css §2o (Numeric stepper). The WC\n * <hbd-stepper> adopts input.css and renders the .hbd-stepper* unit inside the\n * shared .hbd-field chrome; that field chrome is provided by the @hbd/input\n * registry dependency, so this file ships ONLY the .hbd-stepper* rules.\n *\n * Three-part control: decrement button + native number input + increment\n * button — sits inside .hbd-field__input-wrapper. Focus ring is applied\n * ONCE on the whole stepper via :focus-within (cleaner than three rings).\n * The native input is the sole Tab stop; buttons are tabindex=\"-1\" and\n * reached by mouse/touch only.\n */\n\n.hbd-stepper {\n  display: flex;\n  align-items: stretch;\n  width: 100%;\n  /* border-strong (ink-700, ~11.4:1 on parchment) meets SC 1.4.11 — same\n     precedent as the other input borders (border-default would be ~2.06:1). */\n  border: var(--hbd-input-border-width) solid var(--hbd-color-border-strong);\n  border-radius: var(--hbd-radius-md);\n  overflow: hidden;\n  transition: border-color var(--hbd-duration-fast) var(--hbd-ease-out);\n}\n.hbd-stepper:focus-within {\n  border-color: var(--hbd-color-input-focus-border);\n  outline: var(--hbd-border-width-thin) solid var(--hbd-color-focus-ring-outline);\n  outline-offset: var(--hbd-focus-offset);\n}\n\n/* Step buttons — flank the native input. */\n.hbd-stepper__button {\n  flex-shrink: 0;\n  width: var(--hbd-stepper-button-width);\n  min-height: var(--hbd-input-min-height);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: var(--hbd-color-surface-subtle);\n  border: none;\n  border-radius: 0;\n  color: var(--hbd-color-text-primary);\n  font-family: var(--hbd-font-family-ui);\n  font-size: var(--hbd-font-size-h4);\n  cursor: pointer;\n  transition: background-color var(--hbd-duration-fast) var(--hbd-ease-out);\n  user-select: none;\n}\n.hbd-stepper__button--decrement {\n  border-right: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n}\n.hbd-stepper__button--increment {\n  border-left: var(--hbd-border-width-hairline) solid var(--hbd-color-border-subtle);\n}\n.hbd-stepper__button:not(:disabled):not(.is-disabled):hover {\n  background: var(--hbd-color-surface-raised);\n}\n.hbd-stepper__button:not(:disabled):not(.is-disabled):active {\n  background: var(--hbd-color-border-subtle);\n}\n/* Focus ring is handled by :focus-within on the parent .hbd-stepper. */\n.hbd-stepper__button:focus-visible {\n  outline: none;\n}\n.hbd-stepper__button:disabled,\n.hbd-stepper__button.is-disabled {\n  color: var(--hbd-color-text-disabled);\n  cursor: not-allowed;\n  pointer-events: none;\n}\n\n/* Native number input — centred, monospace value, no native spin buttons. */\n.hbd-stepper__input {\n  flex: 1;\n  min-width: 0;\n  border: none;\n  border-radius: 0;\n  text-align: center;\n  font-family: var(--hbd-font-family-mono);\n  font-size: var(--hbd-font-size-body);\n  font-weight: var(--hbd-font-weight-medium);\n  color: var(--hbd-color-text-primary);\n  background: var(--hbd-color-surface-default);\n  padding: var(--hbd-input-padding-y) var(--hbd-space-2);\n  outline: none;\n  min-height: var(--hbd-input-min-height);\n  -moz-appearance: textfield;\n}\n.hbd-stepper__input::-webkit-outer-spin-button,\n.hbd-stepper__input::-webkit-inner-spin-button {\n  -webkit-appearance: none;\n  margin: 0;\n}\n\n/* Size modifiers — mirror the .hbd-field--sm/lg modifiers used by other\n   form inputs. Button height + input height + font-size all step together. */\n.hbd-field--sm .hbd-stepper__button,\n.hbd-field--sm .hbd-stepper__input {\n  min-height: var(--hbd-space-8);\n  font-size: var(--hbd-font-size-label);\n}\n.hbd-field--sm .hbd-stepper__input {\n  padding: var(--hbd-space-1) var(--hbd-space-2);\n}\n.hbd-field--lg .hbd-stepper__button,\n.hbd-field--lg .hbd-stepper__input {\n  min-height: calc(var(--hbd-input-min-height) + var(--hbd-space-2));\n  font-size: var(--hbd-font-size-body);\n}\n.hbd-field--lg .hbd-stepper__input {\n  padding: var(--hbd-space-3) var(--hbd-space-4);\n}\n\n/* Field-level disabled and error states — wrap the .hbd-stepper unit. */\n.hbd-field--disabled .hbd-stepper {\n  border-color: var(--hbd-color-border-subtle);\n  background: var(--hbd-color-surface-subtle);\n  opacity: 0.5;\n}\n.hbd-field--disabled .hbd-stepper__input {\n  background: var(--hbd-color-surface-subtle);\n  color: var(--hbd-color-text-disabled);\n}\n.hbd-field--error .hbd-stepper {\n  border-color: var(--hbd-color-status-error-border);\n}\n/* Error: tint the value text so it matches the label + error message. */\n.hbd-field--error .hbd-stepper__input {\n  color: var(--hbd-color-text-emphasis);\n}\n\n/* ── Thin modifier ──────────────────────────────────────────────────── */\n/* Collapses the field wrapper to intrinsic width so the stepper sits\n   inline rather than stretching to fill its grid column.\n   The buttons narrow to --hbd-stepper-thin-button-width (24px) and the input\n   is clamped to --hbd-stepper-thin-input-width (20px).\n   Apply via the `thin` prop on <Stepper>. */\n\n.hbd-field--thin {\n  width: auto;\n  display: inline-flex;\n}\n\n.hbd-field--thin .hbd-stepper {\n  width: auto;\n}\n\n.hbd-field--thin .hbd-stepper__button {\n  width: var(--hbd-stepper-thin-button-width);\n}\n\n.hbd-field--thin .hbd-stepper__input {\n  width: var(--hbd-stepper-thin-input-width);\n  /* content-box, unlike everything else here: the WC sized this input inside a\n     shadow root, where the host page's border-box reset did not reach. Under\n     Tailwind's preflight the same 20px would swallow the 8px side padding and\n     clip the value, so keep the token meaning \"room for the digits\". */\n  box-sizing: content-box;\n  flex: none;\n}\n\n/* ──────── switch.css ──────── */\n/*\n * Here Be Dragons DS — switch.css\n * Ported for React / light-DOM from ds/styles/components/input.css (§2m Switch)\n * + the shared label/hint rules from ds/styles/components/checkbox.css and the\n * field error/message rules from ds/styles/components/input.css.\n *\n * De-shadowed + self-contained: the legacy <hbd-switch> adopted tokens.css +\n * checkbox.css + input.css into its shadow root. Here every selector it relied\n * on is flattened into this one file so the React component renders 1:1 in the\n * light DOM. Every value still references a --hbd-* token (defined in globals.css).\n * No absolute /paths.\n *\n * Size modifiers re-point the four --hbd-switch-* custom properties; the md\n * defaults live at :root in globals.css, so there is no .hbd-switch--md rule\n * (matching the legacy CSS exactly).\n */\n\n/* ── Block ──────────────────────────────────────────────────────────── */\n.hbd-switch {\n  position: relative;\n  display: inline-flex;\n  align-items: flex-start;\n  gap: var(--hbd-space-3);\n  /* Vertical padding lifts the total tap area to ≥44px (SC 2.5.8):\n     track height + 2× space-3 padding clears the minimum on all sizes. */\n  padding: var(--hbd-space-3) 0;\n  cursor: pointer;\n}\n.hbd-switch--label-left {\n  flex-direction: row-reverse;\n}\n\n/* Visually-hidden native input — same clip technique as checkbox/radio. */\n.hbd-switch__input {\n  position: absolute;\n  width: var(--hbd-border-width-hairline);\n  height: var(--hbd-border-width-hairline);\n  margin: calc(-1 * var(--hbd-border-width-hairline));\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n/* Track — pill-shaped outer container. border-strong (ink-700, ~11.4:1\n   on parchment) is used as a SURFACE for the \"off\" state — matches the\n   precedent set on input/checkbox/radio borders for SC 1.4.11 (the\n   spec's border-default would be ~2.06:1 and fail). */\n.hbd-switch__track {\n  position: relative;\n  flex-shrink: 0;\n  width: var(--hbd-switch-width);\n  height: var(--hbd-switch-height);\n  background: var(--hbd-color-border-strong);\n  border-radius: var(--hbd-radius-full);\n  transition: background-color var(--hbd-duration-fast) var(--hbd-ease-in-out);\n}\n\n/* Thumb — circular indicator that translates on check. */\n.hbd-switch__thumb {\n  position: absolute;\n  top: var(--hbd-switch-thumb-offset);\n  left: var(--hbd-switch-thumb-offset);\n  width: var(--hbd-switch-thumb-size);\n  height: var(--hbd-switch-thumb-size);\n  background: var(--hbd-color-surface-default);\n  border-radius: var(--hbd-radius-full);\n  box-shadow: var(--hbd-shadow-sm);\n  transition: transform var(--hbd-duration-fast) var(--hbd-ease-in-out);\n}\n\n/* Checked — track tints to action,