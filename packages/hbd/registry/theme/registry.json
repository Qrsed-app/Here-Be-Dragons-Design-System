          "--destructive-hover": "#3d0505",
          "--success": "#fdf8f0",
          "--success-foreground": "#1a1410",
          "--warning": "#fdf8f0",
          "--info": "#fdf8f0",
          "--info-foreground": "#1a1410",
          "--error": "#fdf8f0",
          "--error-foreground": "#1a1410"
        },
        "@keyframes hbd-spin": {
          "from": { "transform": "rotate(0deg)" },
          "to": { "transform": "rotate(360deg)" }
        },
        "@keyframes hbd-shimmer": {
          "0%": { "transform": "translateX(-100%)" },
          "100%": { "transform": "translateX(100%)" }
        },
        "@keyframes hbd-progress-stripe": {
          "from": { "background-position": "32px 0" },
          "to": { "background-position": "0 0" }
        },
        "@keyframes hbd-progress-indeterminate": {
          "0%": { "transform": "translateX(-100%)" },
          "100%": { "transform": "translateX(350%)" }
        }
      }
