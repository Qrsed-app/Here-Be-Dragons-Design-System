      "css": {
        "@import \"tw-animate-css\"": {},
        "@layer base": {
          "*": { "@apply border-border outline-ring/50": {} },
          "body": {
            "@apply bg-background text-foreground font-serif text-[1.0625rem] leading-[1.7] antialiased": {}
          }
        },
